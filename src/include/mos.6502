; MOS entry points

osbyte = &fff4
osword = &fff1
oscli  = &fff7
osrdch = &ffe0
osrdsc = &ffb9
oswrch = &ffee
osnewl = &ffe7
osasci = &ffe3
oswrsc = &ffb3
osfind = &ffce
osfile = &ffdd
osargs = &ffda
osgbpb = &ffd1
osbput = &ffd4
osbget = &ffd7
oseven = &ffbf
gsinit = &ffc2
gsread = &ffc5

nvwrch = &ffcb
nvrdch = &ffc8

; MOS zero page workspace locations

os_text_ptr     =       &f2
romsel_copy     =       &f4
os_error_ptr    =       &fd

; Service call numbers

service_call_offer_command      = &04
service_call_help               = &09

; OSBYTE calls

osbyte_read_os_version          = &00
osbyte_acknowledge_escape       = &7e
osbyte_inkey                    = &81
osbyte_read_oshwm               = &83
osbyte_read_himem               = &84
osbyte_enter_language           = &8e
osbyte_read_cmos_ram            = &a1

; OSWORD calls

osword_read_character_definiton = &0a

; VDU commands

vdu_disable_printer             = 3
vdu_previous_line               = 11
vdu_disable_paged_mode          = 15
