SECTION ZeroPage, org = &00, guard = &90

.string         SKIP 2
.oshwm          SKIP 2
.text_end       SKIP 2
.temp           SKIP 2
.addr           SKIP 2
.src_ptr        SKIP 2
.dst_ptr        SKIP 2
.text_ptr       SKIP 2
.gap_start      SKIP 2
.gap_end        SKIP 2
.match_start    SKIP 2
xeff            = match_start
lastsp          = match_start + 1
.match_end      SKIP 2
diff            = match_end
centre          = match_end + 1
.set_marks_lo   SKIP 2
right_flush     = set_marks_lo
linfed          = set_marks_lo + 1
.set_marks_hi   SKIP 2
len             = set_marks_hi
indent          = set_marks_hi + 1
.used_marks_lo  SKIP 2
underline       = used_marks_lo
pundrl          = used_marks_lo + 1
.used_marks_hi  SKIP 2
bold            = used_marks_hi
vspace          = used_marks_hi + 1

IF cF8key AND NOT(edit150)
.line_terminator SKIP 1
ENDIF

IF extgf
.ctptr          SKIP 2          ; current text pointer
ENDIF

.himem          SKIP 2
.text_start     SKIP 2
.brk_action     SKIP 1
.size           SKIP 2
.max_size       SKIP 2
.page_wait_flag SKIP 1
.print_flags    SKIP 1
.options        SKIP 1
.modified       SKIP 1
.temp_a         SKIP 1
.count          SKIP 1
.index          SKIP 1
.page_width     SKIP 1
.page_length    SKIP 1
.screen_height  SKIP 1
.update_y       SKIP 1
.update_max_y   SKIP 1
.update_required SKIP 1
.pending_update SKIP 1
.screen_x       SKIP 1
.screen_y       SKIP 1
.lnbufx         SKIP 1
.cursor_editing SKIP 1
.search_stack_index SKIP 1
fill            = search_stack_index
.replace_index  SKIP 1
temp_indent     = replace_index
.chunk_size     SKIP 2
juslen          = chunk_size
spaces          = chunk_size + 1
.num_marks      SKIP 1
l               = num_marks
.marks_before_cursor SKIP 1
Q               = marks_before_cursor
.current_line_len SKIP 1

; Nonzero when the next read_char call should return the key in queued_key.
; Set by the screen update routine if a keypress interrupts an update.
.key_queued_flag SKIP 1
; The key to be returned by the next read_char call, if key_queued_flag is set.
; Stored by the screen update routine if a keypress interrupts an update.
.queued_key     SKIP 1

.lines_per_page SKIP 1
.field_index    SKIP 1
lineot          = field_index
.input_index    SKIP 1
control_char    = input_index
.output_index   SKIP 1
bold_required   = output_index
.mmx            SKIP 1
underline_required = mmx
.page_offset    SKIP 1
.simple_char    SKIP 1
pbold           = simple_char
.nextX          SKIP 1
last_tab        = nextX
.line           SKIP 2
index_output    = line
.index_handle   SKIP 1
.MULFFLAG       SKIP 1
tab_char        = MULFFLAG
.num_marks_set  SKIP 1
.top_scroll_margin SKIP 1
.bottom_scroll_margin SKIP 1

IF edit150
; Search and replace state, formerly stored in buff
.search_state   SKIP 14
ENDIF

; At minimum used as buffer for OSFILE (18 bytes) and OSWORD 10 (9 bytes)
.scratch        SKIP 26

buff            = scratch + 10  ; (no.bffr len 15 {MMMDCCCLXXXVIII})

IF edit150
search_end_flag = search_state
ELSE
search_end_flag = buff
ENDIF

SENSFLAG        = search_end_flag + 1
BUTTFLAG        = search_end_flag + 2
metaflag        = search_end_flag + 3
replace_flag    = search_end_flag + 4
block_end       = search_end_flag + 8
scroll_ptr      = search_end_flag + 10
search_end      = search_end_flag + 12
mousel          = buff + 15

IF stamp
flexec          = scratch + 18  ; 4 bytes
flload          = scratch + 22  ; 4 bytes
ENDIF

IF edit150
.compressed_string SKIP 2
.chardef_backup_ptr SKIP 2
.chardef_backup_count SKIP 1

; Value to be used to set the zero flag (indicating the key type) when returning
; from read_char, if key_queued_flag is set.
.queued_key_type SKIP 1
ENDIF

IF cF8key AND edit150
.line_terminator SKIP 1
ENDIF

ENDSECTION
