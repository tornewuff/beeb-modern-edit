.default_config {
        ; assemble with phil's version of "cursor editing"
        phil = FALSE
        ; assemble with mouse options
        mouse = FALSE
        ; assemble with long error box
        lerror = TRUE
        ; assemble with character definitions
        dchars = TRUE
        ; 'A SYZYGY prog' displayed, was under EXTRAS
        syzygy = TRUE
        ; date stamping
        stamp = FALSE
        ; linefeed version
        lfver = FALSE
        ; ctrl-f8 toggle (cr/lf)
        cF8key = TRUE
        ; shorter messages
        shortm = TRUE
        ; different cursor types
        curtyp = TRUE
        ; linefeed arrow
        lfarro = TRUE
        ; extended FIND/REPLACE texts
        extgf = FALSE
        ; shuffle code around to build EDIT 1.50
        edit150 = FALSE
        ; apply size optimizations from EDIT 1.50 (non-behavior-changing)
        edit150_size_opt = FALSE
        ; omit the service handler to save space (formerly enabled by mouse=1)
        omit_service = FALSE
}

IF DEFINED(setconfig.phil) : phil = setconfig.phil : ELSE : phil = default_config.phil : ENDIF
IF DEFINED(setconfig.mouse) : mouse = setconfig.mouse : ELSE : mouse = default_config.mouse : ENDIF
IF DEFINED(setconfig.lerror) : lerror = setconfig.lerror : ELSE : lerror = default_config.lerror : ENDIF
IF DEFINED(setconfig.dchars) : dchars = setconfig.dchars : ELSE : dchars = default_config.dchars : ENDIF
IF DEFINED(setconfig.syzygy) : syzygy = setconfig.syzygy : ELSE : syzygy = default_config.syzygy : ENDIF
IF DEFINED(setconfig.stamp) : stamp = setconfig.stamp : ELSE : stamp = default_config.stamp : ENDIF
IF DEFINED(setconfig.lfver) : lfver = setconfig.lfver : ELSE : lfver = default_config.lfver : ENDIF
IF DEFINED(setconfig.cF8key) : cF8key = setconfig.cF8key : ELSE : cF8key = default_config.cF8key : ENDIF
IF DEFINED(setconfig.shortm) : shortm = setconfig.shortm : ELSE : shortm = default_config.shortm : ENDIF
IF DEFINED(setconfig.curtyp) : curtyp = setconfig.curtyp : ELSE : curtyp = default_config.curtyp : ENDIF
IF DEFINED(setconfig.lfarro) : lfarro = setconfig.lfarro : ELSE : lfarro = default_config.lfarro : ENDIF
IF DEFINED(setconfig.extgf) : extgf = setconfig.extgf : ELSE : extgf = default_config.extgf : ENDIF
IF DEFINED(setconfig.edit150) : edit150 = setconfig.edit150 : ELSE : edit150 = default_config.edit150 : ENDIF
IF DEFINED(setconfig.omit_service) : omit_service = setconfig.omit_service : ELSE : omit_service = default_config.omit_service : ENDIF
IF DEFINED(setconfig.edit150_size_opt) : edit150_size_opt = setconfig.edit150_size_opt : ELSE : edit150_size_opt = default_config.edit150_size_opt : ENDIF
