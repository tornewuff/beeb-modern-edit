; Decode a short list of assumed-valid UTF-8 bytes, one character per recursion.
; Only ever called on runs of 8 bytes or fewer, so its depth is bounded by 8.
FUNCTION utf8_decode_core(cs)
    IF LEN(cs) == 0
        r = {}
    ELIF cs[0] < &80
        r = CONCAT({cs[0]}, utf8_decode_core(cs[1..]))
    ELIF cs[0] < &E0
        r = CONCAT({(cs[0] AND &1F) * 64 + (cs[1] AND &3F)}, utf8_decode_core(cs[2..]))
    ELIF cs[0] < &F0
        r = CONCAT({(cs[0] AND &F) * 4096 + (cs[1] AND &3F) * 64 + (cs[2] AND &3F)}, utf8_decode_core(cs[3..]))
    ELSE
        r = CONCAT({(cs[0] AND &7) * 262144 + (cs[1] AND &F) * 4096 + (cs[2] AND &3F) * 64 + (cs[3] AND &3F)}, utf8_decode_core(cs[4..]))
    ENDIF
= r

; Largest index <= i that starts a character (i.e. is not a continuation byte).
FUNCTION utf8_cut(cs, i)
    IF (cs[i] AND &C0) == &80
        r = utf8_cut(cs, i - 1)
    ELSE
        r = i
    ENDIF
= r

; Split in half and recurse, nudging the split point back onto a character boundary.
; Depth is log2(n) + 8, so string length is effectively unlimited.
FUNCTION utf8_decode(cs)
    n = LEN(cs)
    IF n <= 8
        r = utf8_decode_core(cs)
    ELSE
        m = utf8_cut(cs, n DIV 2)
        r = CONCAT(utf8_decode(cs[0..<m]), utf8_decode(cs[m..]))
    ENDIF
= r

; The non-ASCII glyphs in HiEdit 1.24 are all existing glyphs in MOS 3.x's font,
; and are encoded as the corresponding bytes. When running on a Master it's
; therefore possible to omit the custom character definitions and everything
; still draws the same, but they need to be defined for a model B with a 6502SP.
;
; However, MOS 3.50 added official support for 8-bit text, so Edit 1.50r doesn't
; want to assume that these byte values still have the default MOS 3.x glyphs or
; that it's safe to redefine them - the user might have loaded a custom font
; that uses bytes 128-255 to accomodate their language and may be editing a text
; file that contains these bytes. Instead it saves the existing definition to a
; temporary buffer, defines its custom glyphs, prints its descriptive help text,
; then restores the original definitions, each time. To simplify this code, the
; byte values used are just the contiguous range &80-&91.
;
; NUL is never actually printed by either version, but is used as a placeholder
; in the default header/footer strings. Having an actual zero byte in the source
; is very unfriendly to modern editors and version control tools which often
; assume the file is binary, so we just map U+2400 back to &00 for both.

; Each codepoint is followed by three spaces to align nicely with the byte values.
codepoints = "␀   ©   ⯇   ⯈   ⭣   ⭡   ╶   ╴   ─   ┬   │   ├   ┤   ┴   ┼   ┌   ┐   └   ┘   "
IF edit150
byte_vals = {&00,&86,&87,&88,&89,&8A,&8B,&8C,&80,&8D,&81,&8E,&8F,&90,&91,&82,&83,&84,&85}
ELSE
byte_vals = {&00,&87,&88,&89,&8A,&8B,&A2,&A4,&A6,&A7,&A9,&AB,&AD,&AE,&AF,&B0,&B1,&B2,&B3}
ENDIF

; Decoded list still has three space codepoints after each "significant" codepoint...
from = CONCAT(0..127, utf8_decode(CODES(codepoints)))

; ...so insert three space bytes after each element of byte_vals as well.
pad_vals = REPEATED(LEN(byte_vals), ' ')
to = CONCAT(0..127, FLATTEN(ZIP(byte_vals, pad_vals, pad_vals, pad_vals)))

FUNCTION remap(s) = CHR(to[FIND(from, utf8_decode(CODES(s)))])

FUNCTION remapchar(s)
    u = utf8_decode(CODES(s))
    if LEN(u) == 1
        r = to[FIND(from, u[0])]
    ELSE
        r = ERROR("bad char: ", s)
    ENDIF
= r
