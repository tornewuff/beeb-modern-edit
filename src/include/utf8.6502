; Decode a short list of assumed-valid UTF-8 bytes, one character per recursion.
; Only ever called on runs of 8 bytes or fewer, so its depth is bounded by 8.
FUNCTION utf8_decode_core(cs)
    IF LEN(cs) == 0
        r = {}
    ELIF cs[0] < &80
        r = CONCAT({cs[0]}, utf8_decode_core(cs[1..]))
    ELIF cs[0] < &E0
        r = CONCAT({(cs[0] AND &1F) * 64 + (cs[1] AND &3F)}, utf8_decode_core(cs[2..]))
    ELIF cs[0] < &F0
        r = CONCAT({(cs[0] AND &F) * 4096 + (cs[1] AND &3F) * 64 + (cs[2] AND &3F)}, utf8_decode_core(cs[3..]))
    ELSE
        r = CONCAT({(cs[0] AND &7) * 262144 + (cs[1] AND &F) * 4096 + (cs[2] AND &3F) * 64 + (cs[3] AND &3F)}, utf8_decode_core(cs[4..]))
    ENDIF
= r

; Largest index <= i that starts a character (i.e. is not a continuation byte).
FUNCTION utf8_cut(cs, i)
    IF (cs[i] AND &C0) == &80
        r = utf8_cut(cs, i - 1)
    ELSE
        r = i
    ENDIF
= r

; Split in half and recurse, nudging the split point back onto a character boundary.
; Depth is log2(n) + 8, so string length is effectively unlimited.
FUNCTION utf8_decode_recursive(cs)
    n = LEN(cs)
    IF n <= 8
        r = utf8_decode_core(cs)
    ELSE
        m = utf8_cut(cs, n DIV 2)
        r = CONCAT(utf8_decode_recursive(cs[0..<m]), utf8_decode_recursive(cs[m..]))
    ENDIF
= r

; Decode a string of UTF-8 characters into a list of codepoints.
FUNCTION utf8_decode(s) = utf8_decode_recursive(CODES(s))

; Decode a string containing a single UTF-8 character into a codepoint.
FUNCTION utf8_decode_char(s)
    u = utf8_decode(s)
    IF LEN(u) == 1
        r = u[0]
    ELSE
        r = ERROR("not a single UTF-8 character: ", s)
    ENDIF
=r
