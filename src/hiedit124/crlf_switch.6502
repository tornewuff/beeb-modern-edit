.toggle_line_terminator         ; CR/LF switch
        LDA     line_terminator
        CMP     #cr
        BEQ     setLF
        LDA     #cr
        STA     line_terminator
        BRA     cont99
.setLF
        LDA     #lf
        STA     line_terminator
.cont99
        STZ     cursor_editing
        STZ     key_pending
        STZ     mark_count

        LDA     line_terminator
        STA     (oshwm)
        STA     (text_end)

        STZ     cursor_x        ; STZ cursor_y will be forced by screen_update

        JSR     cursor_text_start ; move the cursor to the top
                                ; of the text
        JMP     EDITcont        ; and continue editing
