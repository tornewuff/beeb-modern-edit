        INCLUDE "module/service_entry_150.6502"
        INCLUDE "module/brk_handler.6502"
ELSE
        INCLUDE "module/brk_handler.6502"
        INCLUDE "module/service_entry.6502"
ENDIF
IF edit150
        INCLUDE "module/language_entry_150.6502"
