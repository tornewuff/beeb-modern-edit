; EDIT08
INCLUDE "module/find_replace.6502"
INCLUDE "module/write_lineno.6502"
INCLUDE "module/marks.6502"
INCLUDE "module/block_ops.6502"
INCLUDE "module/find_replace_prompts.6502"
INCLUDE "module/cursor_type.6502"
INCLUDE "module/extended_find.6502"
INCLUDE "module/default_headers.6502"

        IF origin=&8000
.theend
        ELSE
        EQUB    "Roger Wilson",null
.theend
        ENDIF

romlen  =       (theend - origin)

IF edit150 AND origin == &8000 AND NOT(DEFINED(build_disc))
        ; the ROM image is padded out to 16K
        EQUB    REPEATED(&C000 - *, &FF)
ENDIF

ENDSECTION
