.build {
if DEFINED(build_disc)
        filename = "HIEDIT"
ELSE
        filename = "hiedit.b800.rom"
ENDIF
        relocation_model = "none"
        destination_address = &b800
        cmos_host = TRUE
}

.metadata {
        title = "Edit"
        copyright = "1984 Acorn"
        version_byte = &02
        version_str = "1.24"
}

INCLUDE "main.6502"
