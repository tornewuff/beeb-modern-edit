        ; -> EDIT03
.INITED
        ; Set up edit keys as softkeys, and set softkeys to have
        ; following bases -
        ; plain = &80
        ; shift = &90
        ; ctrl  = &A0
        LDA     #4
        LDX     #2
        JSR     OSBYTE
        LDA     #&DB
        LDX     #128 + 10
        LDY     #0
        JSR     OSBYTE          ; tab key pretends to be soft key 10
        LDA     #&E3
        LDX     #&A0
        LDY     #0
        JSR     OSBYTE
        LDA     #&E2
        LDX     #&90
        LDY     #0
        JSR     OSBYTE
        LDX     #&80
.INITEX
        LDA     #&E1
        LDY     #0
        JMP     OSBYTE
.INITUS
        ; Return cursor-keys & softkeys to 'normal' state.
        LDA     #&DB
        LDX     #9
        LDY     #0
        JSR     OSBYTE          ; tab key emits 9
        LDA     #4
        LDX     #0
        JSR     OSBYTE
        LDX     #1
        BRA     INITEX
.STARTT
        ; Returns CS if on 1st line (GS = TSTART), else CC.
        LDA     TSTART
        CMP     GS
        LDA     TSTART + 1
        SBC     GS + 1
        RTS
.ENDTES
        ; Returns CS if on last line (GE + scrimcreenY = TMAX), else CC.
        CLC
        LDA     CURRLE
        ADC     GE
        TAX
        LDA     #0
        ADC     GE + 1
        CPX     TMAX
        SBC     TMAX + 1
        RTS
.LENGTH
        ; Find length of current line. Exit - A = length - 1
        LDY     #0
.LECCLO
        LDA     (GE),Y
        IF cf8key=1
        CMP     clterm
        ELSE
        CMP     #termin
        ENDIF
        BEQ     LECCRE
        INY
        CPY     PAGEWI
        BNE     LECCLO
.LECCRE
        TYA
        RTS
.CHECKR
        ; Check for space in edit buffer.
        ; Entry - XY = required No. of bytes
        ; Exit  - size = XY
        ;         XY = temp = GE - XY
        ;         Error if temp < GS

        STX     SIZE
        STY     SIZE + 1
        SEC
        LDA     GE
        SBC     SIZE
        TAX
        LDA     GE + 1
        SBC     SIZE + 1
        TAY
        STX     TEMP
        STY     TEMP + 1
        CPX     GS
        SBC     GS + 1
        BCS     VDU23X
        JMP     CHNRRE                  ; 'No room'

.CURON
        LDY     #1
        BRA     VDU231
.CUROFF
        LDY     #0
.VDU231
        LDX     #1
.VDU23
        ; Entry - X = 1st byte, Y = 2nd byte
        ; Exit  - VDU 23,X,Y,0,0,0,0,0,0,0 Output.

        LDA     #23
        JSR     OSWRCH
        TXA
        JSR     OSWRCH
        TYA
        JSR     OSWRCH
        JSR     VSTRNG
        EQUB    &00,&00,&00,&00,&00,&00,&00,&EA
.VDU23X
        RTS

.INTPAG
        LDA     TUTMOD
        AND     #7
        CMP     #2
        BEQ     KEYONL
        CMP     #5
        BEQ     KEYONL
        BRA     NOTTUT
.CLEARS
        LDA     TUTMOD
        AND     #7
        CMP     #2
        BEQ     DOTUT
        CMP     #5
        BNE     NOTTUT
.DOTUT
        PHA
        JSR     VSTRNG
        EQUB    26,HOME,&EA
        JSR     STARTI
        JSR     BIGMESS
        PLA
        CMP     #2
        BEQ     KEYONL
        JSR     BIGMET
.KEYONL
        JSR     STOPIN
        JSR     GETWIN          ; get size of total screen
        STA     REALPA          ; pagelength in A
        JSR     DECWIN
.NOTTUT
        JSR     GETWIN          ; get size of working area
        TAX                     ; pagelength again in A
        INX                     ; Initialize scrim.
        LDA     PAGEWI
.SCMILO
        STA     SCRIM,X
        DEX
        BPL     SCMILO
        JSR     STATUS
        CLR     SCRNPY
        RTS
.GETWIN
        LDA     #160
        LDX     #10
        JSR     OSBYTE
        STX     PAGEWI
        STY     PAGELE
        LDX     #8
        JSR     OSBYTE
        TYA
        CLC
        SBC     PAGELE
        STA     PAGELE
        RTS
.DECWIN
        LDA     TUTMOD
        AND     #7
        LDY     #14
        CMP     #5
        BEQ     WINDOW
        LDY     #7
        CMP     #2
        BNE     NOWIND
.WINDOW
        LDA     #28
        JSR     OSWRCH
        LDA     #0
        JSR     OSWRCH
        LDA     REALPA
        INA
        JSR     OSWRCH
        LDA     PAGEWI
        JSR     OSWRCH
        TYA
        JMP     OSWRCH
.NOWIND
        LDA     #26
        JMP     OSWRCH
.EDRDCH
        ; Exit - A holds character read
        LDA     NEXTREADFLAG
        BEQ     EDRDOSRD
        LDA     NXTCHR
        CLR     NEXTREADFLAG
        RTS
.EDRDOSRD
        IF MOUSE=1
        PHX
        PHY
.MOUSLP
        LDA     #&81
        LDX     #0
        LDY     #0
        JSR     OSBYTE
        TXA
        CPY     #&FF
        BNE     NOMOUSE
        JSR     MOUSER
        LDA     MOUSEL + 8
        ORA     MOUSEL + 9
        BNE     MOUSLY
        LDA     MOUSEL + 6
        ORA     MOUSEL + 7
        BNE     MOUSLX
        LDA     MOUSEL
        CMP     MOUSEL + 5
        BEQ     MOUSLP
        AND     #&7
        BIT     #&1
        BNE     MOUSK1
        BIT     #&2
        BNE     MOUSK2
        BIT     #&4
        BEQ     MOUSLP
        LDA     #&86
        BRA     NOMOUS
.MOUSK1
        LDA     #&98
        BRA     NOMOUS
.MOUSK2
        LDA     #&97
        BRA     NOMOUS
.MOUSLX
        LDA     #&8D
        LDX     MOUSEL + 7
        BPL     NOMOUS
        LDA     #&8C
        BNE     NOMOUS
.MOUSLY
        LDA     #&8F
        LDX     MOUSEL + 9
        BPL     NOMOUSE
        LDA     #&8E
.NOMOUSE
        PLX
        PLY
        ELSE
        JSR     OSRDCH
        ENDIF

        JMP     ESCTST
.MODIFY
        LDA     #1
        LDX     MODFLG
        STA     MODFLG
        BEQ     STATUS
        RTS
.TABCTL
        LDA     #8
        EOR     TUTMOD
        JSR     DOMODE

.CstatU
        STZ     UPDATE          ; update required
.status
        JSR     CSR0ST          ; Output status on status line.
        JSR     startI          ; Start inverse
        JSR     TESTIF
        BEQ     STATSO

        JSR     VSTRNG
        EQUB    "Insert ",&EA
        BRA     STATSI

.STATSO
        JSR     VSTRNG
        EQUB    "Over   ",&EA

.STATSI
        LDX     CURSED
        BEQ     STATSC
        JSR     VSTRNG

        IF PHIL=0
        EQUB    "    Cursor Editing",&EA
        ELSE
        EQUB    "    Soft Key Entry",&EA
        ENDIF

        BRA     STATSX

.STATSC
        LDA     MARKX
        BEQ     STATST
        DEA
        BNE     STATSM
        JSR     VSTRNG
        EQUB    "One mark ",&EA
        BRA     STATSS
.STATSM
        JSR     VSTRNG
        EQUB    "Two marks",&EA
        BRA     STATSS
.STATST
        LDA     #8
        AND     TUTMOD
        BNE     STATTW
        JSR     VSTRNG
        EQUB    "TAB cols ",&EA
        BRA     STATSS
.STATTW
        JSR     VSTRNG
        EQUB    "TAB words",&EA
.STATSS
        LDA     MODFLG
        BNE     STATMO
        JSR     VSTRNG
        EQUB    " Original",&EA
        BRA     STATSX
.STATMO
        JSR     VSTRNG
        EQUB    " Modified",&EA
.STATSX
        IF cf8key=1

        LDA     clterm
        CMP     #cr
        BEQ     STATcr

        JSR     vstrng
        EQUB    " LF",&EA

        BRA     STATlf
.STATcr
        JSR     vstrng
        EQUB    " CR",&EA

.STATlf
        ENDIF

        IF STAMP=1
        LDA     FLLOAD + 1
        AND     FLLOAD + 2
        AND     FLLOAD + 3
        INA
        BNE     STATNS

        JSR     VSTRNG
        EQUB    " Date",&EA
        BRA     STATNQ
.STATNS

        JSR     VSTRNG
        EQUB    " Exec",&EA
.STATNQ
        ENDIF

        JSR     stopIN          ; stop inverse
        LDY     pagele
        INY

prmptl  =       25              ; Prompt position

        GBLA    $prmod
$prmod  SETA    0               ; the modification to prmptl for nice printing

        IF cf8key=1
$prmod  SETA    ($prmod + 3)    ; CR/LF text
        ENDIF

        IF stamp=1
$prmod  SETA    ($prmod + 5)    ; Date/Exec text
        ENDIF

        LDA     #(PRMPTL - 1 + $prmod)  ; plus any modifications

        JMP     wipeTA                  ; and clear the rest of the line


.promtF
        JSR     prompt
        EQUB    "Type filename ",&EA
        LDX     #&01
        BRA     STRMFL

.prompt
        LDY PAGELE
        INY
        JSR     WIPELI
        LDX     #0
.PRMPTX
        LDY     PAGELE
        INY
        JSR     CSRXY
        LDX     #1
        BRA     STRMFL
.STRIMO
        LDX     #0
.STRMFL
        JSR     STARTI
        PLA
        STA     STRING
        PLA
        STA     STRING + 1
        JSR     VSTRLP
        JSR     STOPIN
        TXA
        BEQ     STRMEX
        LDA     PAGEWI
        DEA
        LDY     PAGELE
        STA     SCRIM + 1,Y
.STRMEX
        JMP     (STRING)
.CSRSCR
        LDX SCRNX
        LDY     SCRNY
        BPL     CSRXY
.CSR0ST
        LDY PAGELE
        INY
.CSR0Y
        LDX     #0
.CSRXY
        LDA     #31
        JSR     OSWRCH
        TXA
        JSR     OSWRCH
        TYA
        JMP     OSWRCH
.NORMAL
        ; Entry : gap character positioned
        ; Exit : gap moved to start of current line
        LDA     GS
        STA     TEMP
        LDA     GS + 1
        STA     TEMP + 1
        JSR     FINDPO
        STA     STRING
        SEC
        LDA     GS
        SBC     STRING
        TAX
        LDA     GS + 1
        SBC     #0
        TAY
        JMP     GPBKXY
.FINDPO
        ; Entry : temp-> middle of line in 1st half of text
        ; Exit  : A[Z]  = xcoord (0..page..width) of pointer within line.
        ;         Y(=atemp) = page_width - A
        CLC     ;-1
        LDA     TEMP
        SBC     PAGEWI
        STA     TEMP
        BCS     FIPOND
        DEC     TEMP + 1
.FIPOND
        LDY PAGEWI
.FIPOLP
        LDA     (TEMP),Y
        IF cf8key=1
        CMP     clterm
        ELSE
        CMP     #termin
        ENDIF
        BEQ     FIPOL2
.FIPOE2
        ; Entry point, when called from tempbacklines.
        DEY
        BPL     FIPOLP
        BMI     FINDPO
.FIPOL2
        STY ATEMP
        SEC
        LDA     PAGEWI
        SBC     ATEMP
        RTS
.TPGEFD
        ; TP := GE  +  A lines
        LDX     GE
        LDY     GE + 1
        STX     TP
        STY     TP + 1
.TPFWDA
        ; Moves pointer TP forward A lines.
        ; Entry - A = No. of lines to advance TP
        ; Exit  - TP advanced (possibly by less than A lines if hit EOT)
        ;         count = No. of lines remaining from original request.
        ;         atemp = Last end of line character.
        TAX
        STX     COUNT
        BEQ     TPTPEX
.TPTPLP
        LDY     #&FF
.TPTPSE
        INY
        LDA     (TP),Y
        IF cf8key=1
        CMP     clterm
        ELSE
        CMP     #termin
        ENDIF
        BEQ     TPTPFD
        CPY     PAGEWI
        BNE     TPTPSE
.TPTPFD
        STA ATEMP
        TYA
        JSR     TPPAP1
        BCS     TPTPEX
        DEC     COUNT
        BNE     TPTPLP
.TPTPEX
        RTS
.TPPAP1
        ; Exit  -  CC TP = TP  +  (A + 1). CS TP + (A + 1) = HYMEM,
        ;          TP unchanged.
        SEC     ; + 1
        ADC     TP
        TAX
        LDA     #0
        ADC     TP + 1
        TAY
        CPX     HYMEM
        SBC     HYMEM + 1
        BCS     TPPAPX
        STX     TP
        STY     TP + 1
.TPPAPX
        RTS
.TPGSBK
        ; TP := GS - A lines
        ; Entry - A = No. of lines to retreat XY.
        ; Exit  - TP retreated
        ;         A = No. of lines was able to go back.
        LDX     GS
        LDY     GS + 1
        STX     TP
        STY     TP + 1
        TAX
        STX     COUNT
        BEQ     TPXYEX
        LDX     #0
.TPXYLP
        LDA TSTART
        CMP     TP
        LDA     TSTART + 1
        SBC     TP + 1
        BCS     TPXYAB
        CLC     ; - 1
        LDA     TP
        SBC     PAGEWI
        STA     TP
        BCS     TPXYND
        DEC     TP + 1
.TPXYND
        LDY PAGEWI
        LDA     (TP),Y
        IF cf8key=1
        CMP     clterm
        ELSE
        CMP     #termin
        ENDIF
        BNE     TPXYCO
        LDA     TP
        STA     TEMP
        LDA     TP + 1
        STA     TEMP + 1
        JSR     FIPOE2
        BEQ     TPXYCO
        TYA                     ; answer from FINDPO in Y
        ADC     TP              ; + 1 from CS
        STA     TP
        BCC     TPXYCO
        INC     TP + 1
.TPXYCO
        INX
        CPX     COUNT
        BCC     TPXYLP
.TPXYAB
        TXA
.TPXYEX
        RTS
.PAGEUP
        LDA PAGELE
        INA
.MVLNBK
        ; Entry - A = No. of lines to move gap back.
        ; Exit  - Gap moved back A lines. May be moved less if
        ;         hits start of file.
        JSR     TPGSBK
        LDX     TP
        LDY     TP + 1
.GPBKXY
        ; Move gap back so that GS := XY
        STX     ARGP
        STY     ARGP + 1
        SEC
        LDA     GS
        SBC     ARGP
        STX     GS
        TAX
        LDA     GS + 1
        SBC     ARGP + 1
        STY     GS + 1
        TAY
        STX     SIZE
        STY     SIZE + 1
        LDA     GE
        SBC     SIZE
        STA     VARP
        STA     GE
        LDA     GE + 1
        SBC     SIZE + 1
        STA     VARP + 1
        STA     GE + 1
.COPYFD
        ; Copy block forward (i.e. to higher address).
        ; Entry - ARGP --> block of size XY
        ;         VARP --> destination address
        ; Exit  - ARGP,VARP uncorrupted.
        STX     SIZE
        STY     SIZE + 1
.CPFD2
        LDA SIZE
        TAY
        ORA     SIZE + 1
        BEQ     CPFDEX
        LDX     SIZE + 1
        CLC
        TXA
        ADC     ARGP + 1
        STA     ARGP + 1
        TXA
        ADC     VARP + 1
        STA     VARP + 1
        INX
        BCC     CPFDL2
.CPFDLP
        LDA     (ARGP),Y
        STA     (VARP),Y
.CPFDL2
        DEY
        CPY     #&FF
        BNE     CPFDLP
        DEX
        BEQ     CPFDEX
        DEC     ARGP + 1
        DEC     VARP + 1
        BNE     CPFDLP
.CPFDEX
        RTS
.PAGEDN
        LDA PAGELE
        INA
.MVLNFD
        JSR TPGEFD
.GPFDTP
        LDX TP
        LDY     TP + 1
.GPFDXY
        ; Move gap forward so that GE := XY
        LDA     GE
        STA     ARGP
        LDA     GE + 1
        STA     ARGP + 1
        LDA     GS
        STA     VARP
        LDA     GS + 1
        STA     VARP + 1
        SEC
        TXA
        SBC     GE
        TAX
        TYA
        SBC     GE + 1
        TAY
        CLC
        TXA
        ADC     GS
        STA     GS
        TYA
        ADC     GS + 1
        STA     GS + 1
        TXA
        ADC     GE
        STA     GE
        TYA
        ADC     GE + 1
        STA     GE + 1
        JMP     COPYBK
.FINEPO
        ; Entry - Gap line positioned, without VS in text.
        ; Exit  - Gap character positioned, with VS added.
        JSR     ADDVIR
        CLC
        LDA     GE
        ADC     SCRNX
        TAX
        LDA     GE + 1
        ADC     #0
        TAY
        BRA     GPFDXY
.ADDVIR
        JSR     VSCOUN
        BEQ     ADVSEX
        PHA
        TAX
        LDA     CURRLE
        JSR     INSRTX
        ; Wipe possible visible TERMIN.
        LDX     CURRLE
        LDY     SCRNY
        JSR     CSRXY
        LDA     #SPACE
        JSR     OSWRCH
        PLX     ;number spaces from VSCOUN
        LDY     SCRNX
.ADVSLP
        DEY
        STA     (GE),Y
        DEX
        BNE     ADVSLP
.ADVSEX
        JMP     CSRSCR
.VSCOUN
        ; Exit - A(Z) = Number of virtual spaces.
        SEC
        LDA     SCRNX
        SBC     CURRLE
        BCS     VSCTEX
        LDA     #0
.VSCTEX
        RTS
.INSRTX
        ; Entry - Require gap of XY ( > 0) opening up after GE  +  A
        ; Exit  - GE -= XY (checked against GS)
        ;         A chars moved back to new GE, to open up gap
        STA     ATEMP
        CLC
        ADC     GE
        PHA
        LDA     GE + 1
        ADC     #0
        PHA
        PHX
        LDY     #0
        JSR     CHECKR
        LDY     #0
.INSXLP
        LDA     (GE),Y
        STA     (TEMP),Y
        INY
        CPY     ATEMP
        BCC     INSXLP
        STX     GE
        LDA     TEMP + 1
        STA     GE + 1
        PLX
        STX     COUNT
        PLA
        STA     TEMP + 1
        PLA
        STA     TEMP
        LDY     MARKX
.INSXMK
        DEY
        BMI     INSXEX
        LDX     SMATLO,Y
        CPX     TEMP
        LDA     SMATHI,Y
        SBC     TEMP + 1
        BCS     INSXMK
        SEC
        TXA
        SBC     COUNT
        STA     SMATLO,Y
        LDA     SMATHI,Y
        SBC     #0
        STA     SMATHI,Y
        BRA     INSXMK
.INSXEX
        RTS
.TABKEY
        LDA     #8
        BIT     TUTMOD
        BNE     TABSTR
.TABPOS
        INC SCRNX
        LDA     SCRNX
        AND     #7
        BNE     TABPOS
        LDA     SCRNX
        CMP     PAGEWI
        BCC     TABX
        CLR     SCRNX
        BRA     TABX
.TABSTR
        LDA     #1
        JSR     TPGSBK
        CMP     #1
        BNE     INSXEX
        LDY     SCRNX
        DEY
.TABS1
        INY
        CPY     PAGEWI
        BCS     TABSSP
        LDA     (TP),Y
        IF cf8key=1
        CMP     clterm
        ELSE
        CMP     #termin
        ENDIF
        BEQ     TABSSP
        CMP     #' '
        BNE     TABS1
        BRA     TABS2
.TABSSP
        LDY     #&FF
.TABS2
        INY
        CPY     PAGEWI
        BCS     TABSEX
        LDA     (TP),Y
        CMP     #' '
        BEQ     TABS2
.TABSEX
        STY     SCRNX
.TABX
        CLR     UPDATE
.RELANX
        RTS
.RETLAN
        JSR     PROMPT
        EQUB    "Type language name:",&EA
        JSR     READLS
        BEQ     RELANX
        LDY     #0
.RELAPL
        LDA     LINBUF,Y
        INY
        CMP     #CR
        BNE     RELAPL
        STA     LINBUF + 1,Y
        LDA     #' '
        STA     LINBUF - 1,Y
        LDA     #'@'
        STA     LINBUF,Y
        LDA     #THELOT
        STA     UPDATE
        JSR     STFILE
        LDA     GE + 1
        DEA
        CMP     PAJE + 1
        BCS     RETLOK
        BRK
        EQUB    &02,"Not enough space to return to language",null
.RETLOK
        LDA     #&FF
        STA     BRKACT          ; pretty lethal break action rqd
        LDA     PAJE + 1
        INA
        STA     ARGP + 1
        CLR     ARGP
        LDA     #0
        STA     (TMAX)          ; terminating zero
        LDA     GE
        STA     ADDR
        LDA     GE + 1
        STA     ADDR + 1
.RELLOP
        LDA     (ADDR)
        STA     (ARGP)
        INC     ARGP
        BNE     RELLOQ
        INC     ARGP + 1
.RELLOQ
        INC     ADDR
        BNE     RELLOP
        INC     ADDR + 1
        LDA     ADDR + 1
        CMP     HYMEM + 1
        BNE     RELLOP
        JSR     CURON
        JSR     VSTRNG
        EQUB    26,12,&EA
        JSR     INITUS
        LDA     PAJE + 1
        INA
        STA     STRING + 1  ; set 0 to PAGE + 256
        CLR     STRING
        LDX     #<LINBUF
        LDY     #>LINBUF
        JMP     OSCLI

.prHELP
        EQUB    14,cr,cr,"Format commands:- {initial values}",cr
        EQUB    cr
        EQUB    ".afrn assign format n to register r {0}",cr
        EQUB    ".anrn assign number to register r {0}",cr
        EQUB    ".bl   bold line",cr
        EQUB    ".bp   begin page",cr
        EQUB    ".cc c control character is c {.}",cr
        EQUB    ".ce   centre line",cr
        EQUB    ".ch*c chain in next file",cr
        EQUB    ".co   comment line",cr
        EQUB    ".dmcc define macro to .en",cr
        EQUB    ".ds   double space lines",cr
        EQUB    ".ef   even page foot title to .en",cr
        EQUB    ".eh   even page head title to .en",cr
        EQUB    ".en   end of .at, .ix or .ef etc",cr
        EQUB    ".ep   begin even page",cr
        EQUB    ".ff   form feed the printer, wait if paged mode",cr
        EQUB    ".fo   even and odd foot title to .en",cr
        EQUB    ".he   even and odd head title to .en",cr
        EQUB    ".ic   close indexfile",cr
        EQUB    ".ig   ignore input until .en",cr
        EQUB    ".in+- indent left margin n places {0}",cr
        EQUB    ".io*c open indexfile for output",cr
        EQUB    ".ix   send text to indexfile until .en",cr
        EQUB    ".ju   justify right margin of lines {on}",cr
        EQUB    ".ll+- line length including indent {76}",cr
        EQUB    ".ls+- line spacing is n {1}",cr
        EQUB    ".lv n leave n blank lines (by .ne n and .sp n)",cr
        EQUB    ".ne n needs n output lines, .bp if necessary",cr
        EQUB    ".nj   no justification of lines",cr
        EQUB    ".nn   no new line after this line",cr
        EQUB    ".of   odd page foot title to .en",cr
        EQUB    ".oh   odd page head title to .en",cr
        EQUB    ".op   begin odd page",cr
        EQUB    ".os*c call operating system with this string",cr
        EQUB    ".pl+- text area length is n lines {58}",cr
        EQUB    ".po+- page offset is n {0}",cr
        EQUB    ".rf   right flush this line",cr
        EQUB    ".sp n insert n blank lines",cr
        EQUB    ".ss   single space lines",cr
        EQUB    ".ta   define tabs {8,16,24,...,96}",cr
        EQUB    ".tcc  define tab character as c {ctrl I}",cr
        EQUB    ".ti+- temporary indent n",cr
        EQUB    ".trcc translate {ctrl J is space}",cr
        EQUB    ".ul   underline line",cr
        EQUB    cr
        EQUB    "n represents a decimal number, 0 is used if not present",cr
        EQUB    "Spaces are allowed before n. c represents any character",cr
        EQUB    "+- allows n, +n or -n: .in+2 sets an indent 2 more than current",cr
        EQUB    ".ti+2 is a temporary indent of 2 more than the current indent",cr
        EQUB    cr,"Formatting commands which can appear anywhere",cr,cr
        EQUB    ".bb   begin bold",cr
        EQUB    ".bu   begin underline",cr
        EQUB    ".eb   end bold",cr
        EQUB    ".eu   end underline",cr
        EQUB    ".oc n output CHR$(n) to printer counted as 1 char",cr
        EQUB    ".on n output CHR$(n) to printer without being counted",cr
        EQUB    ".r0-9 contents of register e.g. .r0",15,cr,cr
        EQUB    &EA

.prinHL
        LDA     #<prHELP
        STA     string
        LDA     #>prHELP
        STA     string + 1
        LDA     (string)
.prinHK
        JSR     osasci
        INC     string
        BNE     prinHM
        INC     string + 1
.prinHM
        LDA     (string)
        BPL     prinHK
        JSR     inkeys
        JMP     EDITco
