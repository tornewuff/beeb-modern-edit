                ; the formatter -> EDIT04
.PRINTH
        JMP         PRINHL        ; help on print
.PRINT
        JSR     MKREFUSE
        LDX     #&FF
        STX     PWTFLG
        STX     PRTFLG        ; bit 7 printer, bit 6 pay attention to bold/underlining
        STX     LINEOT        ; set needs header flag
        TXS
        JSR     PROMPT
        EQUB    "Screen, Printer, Help ?",&EA
.PRINTL
        JSR     GETRESP
        CMP     #'h'
        BEQ     PRINTH
        CMP     #'s'
        BEQ     PRINTS
        CMP     #'p'
        BNE     PRINTL
        CLR     PRTFLG        ; 0 for printer
.PRINTS
        JSR     PROMPT
        EQUB    "Continuous, Paged ?",&EA
.PRINTM
        JSR     GETRESP
        CMP     #'c'
        BEQ     PRINTC
        CMP     #'p'
        BNE     PRINTM
        CLR     PWTFLG        ; 0 for paged output
.PRINTC
        JSR     MEMSTATE
        LDA     TSTART
        STA     ADDR
        LDA     TSTART+1
        STA     ADDR+1
        LDA     #'.'
        STA     CTLCHA
        LDX     #0
.CLRREG
        CLR     noregs,X      ; clears noregs, tablst, maclst
        INX
        TXA
        STA     trnlst,X      ; init translation
        BNE     clrreg

        IF cf8key=1
        PHX                     ; set X to correct offset
        SEC
        LDA     #cr
        SBC     clterm
        CLC
        ADC     #lf
        TAX
        ENDIF

        LDA     #' '

        IF cf8key=1
        STA     trnlst,X
        PLX
        ELSE
        STA     trnlst + lf + (cr - termin)
        ENDIF

        LDA     #&09
        STA     TABCHA
        DEA                   ; to 8
        CLC
.DEFTAB
        STA     TABLST,X
        INX
        ADC     #8       ; carry clear
        CMP     #100
        BCC     DEFTAB
        LDA     #2
        STA     BRKACTION
        DEA
        STA     PAGE        ; A=1
        STA     VSPACE        ; single spacing
        STA     LINENO
        CLR     DOINDX        ; no indexing
        CLR     INDEXH        ; index file handle
        CLR     PUNDRL        ; persistent underline off
        CLR     PBOLD        ; persistent bold off
        CLR     INDENT        ; turn off indent
        CLR     FILL        ; enable justification
        CLR     OFFSET        ; no page offset
        CLR     LINFED        ; no overprinting
        LDA     #58
        STA     LINEDW        ; lines per page
        LDA     #76
        STA     LEN        ; characters per line
        JSR     VSTRNG
        EQUB    26,12,&EA
        BIT     PRTFLG
        BMI     PATCHA
        LDX     #0       ; just for jes's code, set and reset printer type
        LDA     #5
        JSR     OSBYTE
        JSR     OSBYTE
        LDA     #2
        JSR     OSWRCH
.PATCHA
        BIT     PWTFLG
        BMI     CHAINB
        BIT     PRTFLG
        BPL     CHAINB
        LDA     #14
        JSR     OSWRCH        ; page mode if screen and page wait
.CHAINB
        IF cf8key=1
        LDA     clterm
        ELSE
        LDA     #termin
        ENDIF
        STA     (GS)

        IF cf8key=1
                                ; Copy initial header and footer texts
                                ; into their respective buffers, changing
                                ; any nulls into the 'clterm' value

                                ; AX can be corrupted since X is loaded
                                ; with an immediate value straight after

        LDX     #(dhsize - 1)   ; size of header
.mhlp
        LDA     defhdr,X        ; default header
        BNE     nhchan

        LDA     clterm
.nhchan
        STA     dhbuff,X        ; and into the buffer

        DEX
        BPL     mhlp            ; move header loop

        LDX     #(dfsize - 1)   ; size of footer
.mflp
        LDA     defftr,X        ; default footer
        BNE     nfchan

        LDA     clterm
.nfchan
        STA     dfbuff,X        ; and into the buffer

        DEX
        BPL     mflp            ; move footer loop


        LDA     #<dhbuff
        STA     pageeh
        STA     pageoh
        LDA     #>dhbuff
        STA     pageeh + 1
        STA     pageoh + 1

        LDA     #<dfbuff
        STA     pageef
        STA     pageof
        LDA     #>dfbuff
        STA     pageef + 1
        STA     pageof + 1
        ELSE
        LDA     #DEFHDR
        STA     PAGEEH
        STA     PAGEOH
        LDA     #>DEFHDR
        STA     PAGEEH+1
        STA     PAGEOH+1
        LDA     #DEFFTR
        STA     PAGEEF
        STA     PAGEOF
        LDA     #>DEFFTR
        STA     PAGEEF+1
        STA     PAGEOF+1        ; initial header and footer info
        ENDIF

        LDX     #maxMAC
.CHAINC
        CLR     MACLST-1,X
        DEX
        BNE     CHAINC
.FINE
        CLR     CENTRE        ; turn centre off
        CLR     RFLUSH        ; turn right-flush off
        LDA     #&FF
        STA     TINDEN        ; no temp indent
        LDA     PUNDRL
        STA     UNDERL
        STA     UNDRRQ        ; underline required?
        LDA     PBOLD
        STA     BOLD
        STA     BOLDRQ        ; bold required?
        BRA     CTLIN
.LASLEN
        JSR     ROUTBP
        BIT     PRTFLG        ; print exit
        BPL     DODWN
        JSR     STRIMO
        EQUB    "Print done. ",&EA
        JSR     INKEYS
.DODWN
        JSR     VSTRNG
        EQUB    3,15,&EA
        JSR     CLOSEX
        LDX     GS
        LDY     GS+1
        JMP     EDITGS
.CTLLMT
        LDY     #3       ; found built in cmd
        JSR     CTLLDO
.CTLLMX
        JSR     SPACEY
        DEY
        CLC
        JSR     YADP
        LDA     (ADDR)
        CMP     CTLCHA
        BEQ     CTLIN1
        LDY     #0
.CLCTLI
        JSR     ROUTCO
        SEC
        JSR     YADP
.CTLIN
        LDA     ADDR+1
        STA     XEFF        ; set nojust(local) by <>
        CMP     #>CTLIN
        BCS     CTLIN1
        LDX     ADDR
        CPX     GS
        SBC     GS+1
        BCS     LASLEN
.CTLIN1
        LDA     (ADDR)
        CMP     CTLCHA
        BNE     LINLYX
        LDX     #0       ; main control scan
        LDY     #2
        LDA     (ADDR),Y
        STA     TEMP+1
        DEY
        LDA     (ADDR),Y
.CTLLLP
        CMP     CMDS,X
        BNE     CTLLLL
        LDY     CMDS+1,X
        CPY     TEMP+1
        BEQ     CTLLMT
.CTLLLL
        INX
        INX
        INX
        INX
        CPX     #NOCMDS
        BNE     CTLLLP
        JSR     MACCHK
        BCC     LINLYX
        LDA     ADDR
        PHA
        LDA     ADDR+1
        PHA
        LDA     CTLCHA
        PHA
        LDA     (BUFF)
        STA     CTLCHA
        LDA     BUFF
        STA     ADDR
        LDA     BUFF+1
        STA     ADDR+1
        LDY     #2
        JSR     CLCTLI
        PLA
        STA     CTLCHA
        PLA
        STA     ADDR+1
        PLA
        STA     ADDR
        LDY     #3
        BRA     CTLLMX
.LINLYX
        LDA     LINEOT
        INA
        BNE     NOHDR
        JSR     DOHDR
.NOHDR
        LDA     LEN
        LDY     TINDEN
        INY
        SEC
        BEQ     SBCLEN
        SBC     TINDEN        ; take off temp indent
        BRA     GOTLEN
.SBCLEN
        SBC     INDENT        ; so take off indent
.GOTLEN
        STA     JUSLEN
        LDY     #0
        LDX     #0
        CLR     SPACES        ; initialize spaces encountered
        CLR     LASTTAB        ; initialize start of spacing out
.LINLEN
        CPY     #250
        BCS     LENFNE
        JSR     IGNCTL        ; main char count
        IF cf8key=1
        CMP     clterm
        ELSE
        CMP     #termin
        ENDIF
        BEQ     LENFNE
        CMP     TABCHA
        BNE     NOTTAB
        TXA
        LDX     #&FF
.LOKTAB
        INX
        PHA
        LDA     TABLST,X
        BEQ     NOTAB
        PLA
        CMP     TABLST,X
        BCS     LOKTAB
        PHA
        LDA     TABLST,X
        PLX
        INY
        CMP     JUSLEN
        BCS     NOTAB2
        TAX
        STX     LASTSP
        STX     LASTTAB
        CLR     SPACES
        BRA     NOSP2
.NOTAB
        PLX
        LDA     #' '
.NOTTAB
        CMP     #' '
        BNE     NOSP
        STX     LASTSP
        INC     SPACES
.NOSP
        INX
        INY
.NOSP2
        CPX     JUSLEN
        BCC     LINLEN
.NOTAB2
        JSR     IGNCTL
        CMP     #' '
        BEQ     LENFNA
        CMP     TABCHA
        BEQ     LENFNA
        IF cf8key=1
        CMP     clterm
        ELSE
        CMP     #termin
        ENDIF
        BEQ     LENFNA
        LDA     SPACES
        BEQ     LENFNA
        LDX     LASTSP
        DEC     SPACES
.LENFNA
        DEX
        CLR     XEFF
.LENFNE
        INX
        STX     COUNT        ; X, Y free
        BIT     PRTFLG
        BPL     DODW
        JSR     DOSCRE
        BRA     LINCTL
.DODW
        LDA     #&40
        TSB     PRTFLG        ; no underline first time
        LDA     UNDERL
        PHA
        JSR     WRITE
        PLA
        STA     UNDERL
        BIT     UNDRRQ
        BPL     LINCTL
        LDA     #&40       ; now do underline
        TRB     PRTFLG
        JSR     DOSCRE
        CLR     UNDERL
.LINCTL
        BIT     LINFED
        BMI     FINSEN
        LDX     VSPACE
.LINSCT
        JSR     LFWRCH        ; ready for next line
        LDA     LINEOT
        INA
        BEQ     FINSEN
        DEX
        BNE     LINSCT
.FINSEN
        CLR     LINFED        ; back on, for next line
        JSR     SPACEY
        IF cf8key=1
        CMP     clterm
        ELSE
        CMP     #termin
        ENDIF
        BEQ     NICEDL
        DEY
.NICEDL
        CLC
        JSR     YADP
        JMP     FINE
.SPACEY
        LDA     (ADDR),Y
        INY
        BEQ     SPACER
        CMP     #' '
        BEQ     SPACEY
.SPACER
        RTS
.IGNCTL
        LDA     (ADDR),Y    ; count routine
        CMP     CTLCHA
        BNE     NOCTRL
        INY
        LDA     (ADDR),Y
        CMP     #'b'
        BEQ     WSCTRB
        CMP     #'o'
        BEQ     WSCTRO
        CMP     #'r'
        BEQ     WSCTRR
        CMP     #'e'
        BNE     NORECG
.WSCTRB
        INY
        LDA     (ADDR),Y
        CMP     #'b'
        BEQ     WSCTRL
        CMP     #'u'
        BNE     NORECF
.WSCTRL
        INY
        BRA     IGNCTL
.WSCTRO
        INY
        LDA     (ADDR),Y
        CMP     #'n'
        BEQ     WSCTON
        CMP     #'c'
        BNE     NORECF
        INX
.WSCTON
        PHX
        INY
        JSR     GETNO
        PLX
        BRA     IGNCTL
.WSCTRR
        INY
        LDA     (ADDR),Y
        CMP     #'0'
        BCC     NORECF
        CMP     #&3A
        BCS     NORECF
        JSR     DECCON
        BRA     WSCTRL
.NORECF
        DEY
.NORECG
        DEY
        LDA     (ADDR),Y
.NOCTRL
        RTS
.WASCTL
        INY
.CHKCTL
        LDA     (ADDR),Y    ; print routine
        CMP     CTLCHA
        BNE     NOCTRL
        INY
        LDA     (ADDR),Y
        CMP     #'b'
        BEQ     WASCTB
        CMP     #'o'
        BEQ     WASCTO
        CMP     #'r'
        BEQ     WASCTR
        CMP     #'e'
        BNE     NORECG
        INY
        LDA     (ADDR),Y
        CMP     #'b'
        BEQ     WASCTEB
        CMP     #'u'
        BNE     NORECF
        CLR     PUNDRL
        CLR     UNDERL
        BRA     WASCTL
.WASCTEB
        CLR     PBOLD
        CLR     BOLD
        BRA     WASCTL
.WASCTB
        INY
        LDA     (ADDR),Y
        CMP     #'b'
        BEQ     WASCTA
        CMP     #'u'
        BNE     NORECF
        LDA     #&FF
        STA     UNDERL
        STA     PUNDRL
        STA     UNDRRQ
        BRA     WASCTL
.WASCTA
        LDA     #&FF
        STA     PBOLD
        STA     BOLDRQ
        STA     BOLD
        BRA     WASCTL
.WASCTO
        INY
        LDA     (ADDR),Y
        CMP     #'n'
        BEQ     WASCON
        CMP     #'c'
        BNE     NORECF
        INX
.WASCON
        PHX
        INY
        JSR     GETNO
        LDA     #1
        JSR     OSWRCH
        TXA
        JSR     OSWRCH
        PLX
        BRA     CHKCTL
.WASCTR
        INY
        LDA     (ADDR),Y
        CMP     #'0'
        BCC     NORECF
        CMP     #&3A
        BCS     NORECF
        JSR     DECCON
        PHX
        LDX     TEMP
.OUTCON
        LDA     BUFF,X
        JSR     FMWRCH        ; ul!!
        DEX
        BPL     OUTCON
        PLX
        JMP     WASCTL
.CTLLDO
        LDA     #&FF
        JMP     (CMDS+2,X)
.ROUTAF
        JSR     GETNO
        AND     #15
        ASL     A
        TAX
        LDA     NOREGS+1,X
        AND     #15
        STA     NOREGS+1,X
        INY            ; skip some delimter
        PHX
        JSR     GETNO
        PLX
        ASL     A
        ASL     A
        ASL     A
        ASL     A
        ORA     NOREGS+1,X
        STA     NOREGS+1,X
        RTS
.ROUTAN
        JSR     GETNO
        AND     #15
        ASL     A
        PHA
        LDA     (ADDR),Y
        INY            ; skip delimter
        PHA
        JSR     GETNO
        PLA
        CMP     #'+'
        BEQ     ADDREG
        CMP     #'-'
        BEQ     SUBREG
        CMP     #'='
        BEQ     MOVREG
        TXA
        PLX
        STA     NOREGS,X
        LDA     NOREGS+1,X
        AND     #&F0
        STA     NOREGS+1,X
        RTS
.ADDREG
        CLC
        STX     BUFF
        PLX
        LDA     NOREGS,X
        ADC     BUFF
        STA     NOREGS,X
        LDA     NOREGS+1,X
        ADC     #0
        STA     NOREGS+1,X
        RTS
.SUBREG
        STX     BUFF
        PLX
        LDA     NOREGS,X
        SBC     BUFF
        STA     NOREGS,X
        LDA     NOREGS+1,X
        SBC     #0
        STA     NOREGS+1,X
        RTS
.MOVREG
        TXA
        AND     #15
        ASL     A
        TAX
        LDA     NOREGS+1,X
        AND     #15
        STA     BUFF
        LDA     NOREGS,X
        PLX
        STA     NOREGS,X
        LDA     NOREGS+1,X
        AND     #&F0
        ORA     BUFF
        STA     NOREGS+1,X
        RTS
.ROUTBL
        STA     BOLD
        STA     BOLDRQ
        RTS
.ROUTCC
        LDA     (ADDR),Y
        STA     CTLCHA
        INY
        RTS
.ROUTCE
        STA     CENTRE
        CLR     RFLUSH        ; can't have both
        RTS
.ROUTCH
        LDA     ADDR
        STA     TEMP
        LDA     ADDR+1
        STA     TEMP+1        ; move filename pointer
        LDA     TSTART
        STA     ADDR
        LDA     TSTART+1
        STA     ADDR+1
        LDA     TMAX
        LDX     TMAX+1
        JSR     PASLNM
        JSR     PASGO
        STX     GS
        STY     GS+1
        LDX     #&FF
        TXS
        JMP     CHAINB
.MACCHK
        STA     TEMP        ; check for macro: A=lo, TEMP+1=hi
        LDX     #-2
.MACCHL
        INX
        INX
        CPX     #MAXMAC
        BCS     MACCHX
        LDA     MACLST,X
        STA     BUFF
        LDA     MACLST+1,X
        STA     BUFF+1
        BEQ     MACCHZ
        PHY
        LDY     #3
.MACSPC
        LDA     (BUFF),Y
        INY
        CMP     #' '
        BEQ     MACSPC
        STA     BUFF+2
        LDA     (BUFF),Y
        PLY
        CMP     TEMP+1
        BNE     MACCHL
        LDA     BUFF+2
        CMP     TEMP
        BNE     MACCHL
        RTS            ; found CS,EQ
.MACCHX
        CLC            ; not found, no space CC,NE
        TXA
.MACCHZ
        RTS            ; not found, at space CC,EQ
.DMEXIT
        DEY
        RTS
.ROUTDM
        JSR     SPACEY
        IF cf8key=1
        CMP     clterm
        ELSE
        CMP     #termin
        ENDIF
        BEQ     DMEXIT
        CMP     CTLCHA
        BEQ     DMEXIT
        STA     TEMP+1
        LDA     (ADDR),Y
        IF cf8key=1
        CMP     clterm
        ELSE
        CMP     #termin
        ENDIF
        BEQ     DMEXIT
        JSR     MACCHK
        BNE     DMEXIT
        LDA     ADDR
        STA     MACLST,X
        LDA     ADDR+1
        STA     MACLST+1,X
        BRA     SKIPEN
.ROUTDS
        LDA     #2
        STA     VSPACE
        RTS
.ROUTOF
        LDA     ADDR
        STA     PAGEOF
        LDA     ADDR+1
        STA     PAGEOF+1
        BRA     SKIPEN
.ROUTOH
        LDA     ADDR
        STA     PAGEOH
        LDA     ADDR+1
        STA     PAGEOH+1
        BRA     SKIPEN
.ROUTFO
        LDA     ADDR
        STA     PAGEOF
        LDA     ADDR+1
        STA     PAGEOF+1
.ROUTEF
        LDA     ADDR
        STA     PAGEEF
        LDA     ADDR+1
        STA     PAGEEF+1
.ROUTIG
        BRA     SKIPEN
.ROUTHE
        LDA     ADDR
        STA     PAGEOH
        LDA     ADDR+1
        STA     PAGEOH+1
.ROUTEH
        LDA     ADDR
        STA     PAGEEH
        LDA     ADDR+1
        STA     PAGEEH+1
.SKIPEN
        CLC
        JSR     YADP
.SKIPEM
        LDA     (ADDR)
        INC     ADDR
        BNE     SKIPEK
        PHA
        INC     ADDR+1
        LDA     ADDR
        CMP     GS
        LDA     ADDR+1
        SBC     GS+1
        BCS     SKIPEX
        PLA
.SKIPEK
        CMP     CTLCHA
        BNE     SKIPEM
        LDA     (ADDR)
        CMP     #'e'
        BNE     SKIPEM
        LDY     #1
        LDA     (ADDR),Y
        CMP     #'n'
        BNE     SKIPEM
        INY
.SKIPEX
        RTS
.ROUTEN
        TSX
        CPX     #&FD
        BCS     SKIPEX        ; check for possible to do it
        PLA
        PLA
        RTS            ; return a macro level
.ROUTEP
        JSR     ROUTBP
        LDA     PAGE
        LSR     A
        BCS     ROUTEP
        RTS
.ROUTFF
        LDA     PWTFLG
        BMI     NOWAIT
        LDA     PRTFLG
        BPL     PRTWAT
        JSR     INKEY
.NOWAIT
        LDA     #12
        JMP     OSWRCH
.PRTWAT
        JSR     NOWAIT
        JMP     INKEY
.ROUTIC
        PHY
        JSR     CLOSEX
        PLY
        RTS
.ROUTIN
        LDX     INDENT
        JSR     MODNO
        STX     INDENT
        RTS
.ROUTIO
        CLC
        JSR     YADP
        JSR     CLOSEX
        LDX     ADDR
        LDY     ADDR+1
        LDA     #&80
        JSR     OSFIND
        STA     INDEXH
        LDY     #0
.ROUTCO
        IF cf8key=1
        LDA     clterm
        ELSE
        LDA     #termin
        ENDIF
        BRA     SKIPL1
.SKIPLP
        INY
        BNE     SKIPL1
        INC     ADDR+1
.SKIPL1
        CMP     (ADDR),Y
        BNE     SKIPLP
        RTS
.ROUTIX
        STA     DOINDX
        CLC
        JSR     YADP
        LDA     LINEOT
        PHA
        LDA     #&FD
        STA     LINEOT
        JSR     CTLIN
        PLA
        STA     LINEOT
        CLR     DOINDX
        RTS
.ROUTJU
        CLR     FILL
        RTS
.ROUTLL
        LDX     LEN
        JSR     MODNO
        STA     LEN
        RTS
.ROUTLS
        LDX     VSPACE
        JSR     MODNO
        STX     VSPACE
        RTS
.ROUTLV
        JSR     GETNO
        CMP     LINEOT
        BEQ     OKAYLV
        BCC     OKAYLV
        PHA
        JSR     ROUTBP
        PLA
.OKAYLV
        JMP     ALINES
