        ; -> EDIT02
        ;                                      current
        ;                                      line
        ; PAJE                                                 HYMEM
        ;  v                                   <......>          v
        ; +-+-------------+-------------------+---------------+-+
        ; |$|.............|                 |...............|$|
        ; +-+-------------+-------------------+---------------+-+
        ;    ^             ^                   ^               ^
        ; TSTART           GS                  GE            TMAX
        ; scrnXAs is X coord of cursor. (GE)creenX is char under cursor,
        ; unless $ isA0 in (GE) .. (GE),scrnX (when it is that $).
        ; scrnY is Y coord of current line on screen, and may be forced by the
        ; screen update routine.
        ; Screen update types:-
        ;  none   ; Simple cursor movements
        ;  csronw ; Character insert/delete
        ;  fullsc ; Find,replace etc
        ;  thelot ; Clears screen first. After tload etc
        ;  hardup ; Special case, for cursor movevents
        ;  harddo ; Special case, for cursor movevents
        ;  pagewi ; is max X-coord of screen, and pagelength is max Y-coord of
        ;           screen (thus Y-coord of status line is pagelength + 1).
        ;  scrim  (screen image) holds maximum cursorX position written to each
        ;         line on the screen (including the CR, if any)
.EDIT
        JSR     editmd

        IF stamp = 1
        JSR     nstamp
        ENDIF
.EDITin
        LDX     tstart          ; Initialize pointers to reflect empty buffer.
        LDY     tstart + 1
.EDITgt
        STZ     modflg          ; Re-entry point for Tload. XY = End of file.
.EDITgs
        JSR     EDITtd          ; Re-entry from OLDSTA, newmode
.EDITco
        LDX     #&FF            ; Re-entry point for brk-handler.
        TXS
        STZ     BRKact
        JSR     inited
        LDA     #thelot
        STA     update

.EDITlo                         ; Update screen to reflect previous command.

        JSR     SCRNUD
        JSR     CSRSCR
        JSR     CURON

        IF curtyp=1
        JSR     curupd          ; update the cursor to relevant state
        ENDIF

        LDA     #FULLSC
        STA     UPDATE
        ; Read a char, and branch depending on its value
        ;   &00 - &7F     is ASCII input to be entered as text
        ;   &80 - &8F     are softkey values       }
        ;   &90 - &9F     are shift-softkey values } Editor commands
        ;   &A0 - &AF     are ctrl-sofkkey values  }
        ;   &8A, &9A, &AA is the TAB key
        ;   &B0 - &FF     are entered into text (e.g. icelandics)
        JSR     EDRDCH
        TAX
        BPL     EDITTE
        CMP     #&B0
        BCS     EDITTE

        IF phil = 0
        LDX     CURSED
        BNE     EDITTE
        TAX
        ELSE
        TAX
        LDA     CURSED
        BEQ     PHIL1
        TXA
        AND     #&F
        CMP     #&A
        TXA
        BCC     EDITTE
.phil1
        ENDIF

        LDA     TUTMOD
        AND     #7
        CMP     #5
        BNE     GOMAN
        CPX     #&9C
        BCS     GOMAN
        CPX     #&90
        BCS     DEFVAL
        CPX     #&8A
        BCS     GOMAN
.DEFVAL
        TXA
        PHA
        ASL     A
        TAY
        JSR     VSTRNG
        EQUB    26,30,31,0,8,&EA
        LDA     TXTTAB,Y
        STA     STRING
        LDA     TXTTAB + 1,Y
        STA     STRING + 1
.TUTLIN
        LDY     #&00
        JSR     osnewl
.TUTOUT
        LDA     (STRING)
        INC     STRING
        BNE     TUTINC
        INC     STRING + 1
.TUTINC
        CMP     #cr
        BEQ     NEEDWP
        CMP     #&EA
        BEQ     TUTDON
        JSR     OSWRCH
        INY
        BRA     TUTOUT
.NEEDWP
        LDA     #' '
.TUTWIP
        CPY     #54
        BCS     TUTLIN
        JSR     OSWRCH
        INY
        BRA     TUTWIP
.TUTDON
        JSR     DECWIN
        JSR     CSRSCR
        PLX
.GOMAN
        TXA
        ASL     A
        TAX
        JSR     IADDRS
        JMP     EDITlo
.IADDRS
        JMP     (EDCTBL,X)
.EDITTE
        JSR     EDTEXT
        JMP     EDITlo
.EDTEXT
        ; Entry - A holds ASCII char to be treated as text input
        ; Exit  - appropraite action taken depending on current
        ;        'mode' (insert, overtype, csr-edit).
        CMP     #DELETE
        BEQ     ECHRDE
        CLR     OLDSTA + 3
        CMP     #cr
        BNE     ECHRCO
        JSR     TESTIF ;In insert mode put in the CR
        BNE     ECHRCR
        JSR     ENDTES
        BCS     ECHRCR
        CLR     SCRNX
        JMP     CURDWN ;in overtype mode CR is start of line
.ECHRCR
        IF cf8key=1
        LDA     clterm
        ELSE
        LDA     #termin
        ENDIF
.ECHRCO
        ; Insert character into text.
        PHA
        JSR     ADDVIR
        ; Don't insert in overtype mode, unless at end of line.
        JSR     TESTIF
        BNE     ECHRMV
        LDY     SCRNX
        LDA     (GE),Y
        IF cf8key=1
        CMP     clterm
        ELSE
        CMP     #termin
        ENDIF
        BNE     ECHRCH
.ECHRMV
        LDX     #1
        LDA     SCRNX
        JSR     INSRTX
.ECHRCH
        PLA
        LDY     SCRNX
        STA     (GE),Y
        ; Write char to screen (cursor OK), wiping tail for TERMIN.
        IF cf8key=1
        CMP     clterm
        ELSE
        CMP     #termin
        ENDIF
        BNE     ECHRNT
        JSR     PASWCR
        LDA     SCRNX
        LDY     SCRNY
        JSR     WIPETA
.EHRCSU
        CLR     SCRNX
        JSR     CURDWN
.ECHRUP
        LDA     UPDATE
        BEQ     ECHREL
        JSR     SCRNUD
.ECHREL
        LDA     #CSRONW
        STA     UPDATE
        JMP     MODIFY
.ECHRNT
        JSR     PASWRC
        JSR     CURRT
.ECHRN0
        LDA     UPDATE
        BEQ     ECHRN1
        JSR     SCRNUD
.ECHRN1
        LDA     #CSRTOC
        STA     UPDATE
        JMP     MODIFY
.ECHRDE
        ; Delete virtual space implies csrleft. Can't delete start of file.
        JSR     VSCOUN
        BEQ     EDELST
        JMP     CURLT
.EDELST
        LDA     SCRNX
        BNE     EDELCO
        JSR     STARTTEST
        BCS     DELABX
.EDELCO
        ; Get char to be deleted under cursor. In absence of VS check,
        ; this will give TERMIN delete when past end of line.
        JSR     CURLT
        JSR     LENGTH          ; different line than current!
        CMP     SCRNX
        BCS     EDELMT
        STA     SCRNX
.EDELMT
        ; Branch on text-entry mode (insert/overtype).
        LDY     SCRNX
        JSR     TESTIF
        BNE     EDELSL
        LDA     (GE),Y
        IF cf8key=1
        CMP     clterm
        ELSE
        CMP     #termin
        ENDIF
        BEQ     DELABX
        LDA     #SPACE
        STA     (GE),Y
        LDA     #CSRTOC
        STA     UPDATE
        JMP     MODIFY
.EDELSL
        LDA     (GE),Y
        IF cf8key=1
        CMP     clterm
        ELSE
        CMP     #termin
        ENDIF
        BEQ     EDELS2
        LDA     CURRLE
        CMP     PAGEWI
        BEQ     EDELS2
        JSR     EDEL1
        BRA     ECHRN0
.EDELS2
        JSR     EDEL1
        BRA     ECHRUP
.DELLIX
        JSR     DELABV
.DELLIN
        CLR     SCRNX
        LDA     (GE)
        IF cf8key=1
        CMP     clterm
        ELSE
        CMP     #termin
        ENDIF
        BNE     DELLIX
        JSR     LENGTH
        STA     CURRLE
        JSR     DELABV
        JMP     ECHREL
.DELABV
        JSR     ENDTES
        BCC     DELABY
        LDA     SCRNX
        CMP     CURRLE
        BCC     DELABY
.DELABX
        RTS
.DELABY
        LDA     CURRLE
        CMP     SCRNX
        BCC     DELABX
        LDY     #CSRTOC
        STY     UPDATE
        CMP     PAGEWI
        BEQ     EDEL0
        LDY     SCRNX
        LDA     (GE),Y
        IF cf8key=1
        CMP     clterm
        ELSE
        CMP     #termin
        ENDIF
        BNE     EDEL1
.EDEL0
        INC     UPDATE
.EDEL1
        ; Shift up start of line 'over' deleted character.
        JSR     MODIFY
        CLC
        LDA     GE
        STA     TEMP
        ADC     SCRNX
        STA     ADDR
        LDA     GE + 1
        STA     TEMP + 1
        ADC     #0
        STA     ADDR + 1
        INC     GE
        BNE     EDELNH
        INC     GE + 1
.EDELNH
        LDY     SCRNX
        BRA     EDELDY
.EDELLP
        LDA     (TEMP),Y
        STA     (GE),Y
.EDELDY
        DEY
        BPL     EDELLP
        LDX     MARKX
.EDELMK
        DEX
        BMI     DELABX
        LDY     SMATLO,X
        CPY     ADDR
        LDA     SMATHI,X
        SBC     ADDR + 1
        BCS     EDELMK
        INC     SMATLO,X
        BNE     EDELMK
        INC     SMATHI,X
        BRA     EDELMK

.EDCTBL
        EQUW    EDITli          ; f0
        EQUW    EDstar          ; f1
        EQUW    LOADfi          ; f2
        EQUW    SAVEfi          ; f3
        EQUW    findre          ; f4
        EQUW    globre          ; f5
        EQUW    setmar          ; f6
        EQUW    mkCPY           ; f7
        EQUW    print           ; f8
        EQUW    oldtex          ; f9
        EQUW    tabkey          ; f10
        EQUW    delabv          ; copy
        EQUW    curLT           ; left
        EQUW    curRT           ; right
        EQUW    curDWN          ; down
        EQUW    curUP           ; up
        ;
        EQUW    crtogg          ; shift-f0
        EQUW    IOtogg          ; shift-f1
        EQUW    insrtf          ; shift-f2
        EQUW    scmclr          ; shift-f3
        EQUW    retlan          ; shift-f4
        EQUW    getmod          ; shift-f5
        EQUW    clearm          ; shift-f6
        EQUW    mkmve           ; shift-f7
        EQUW    mkdel           ; shift-f8
        EQUW    newtex          ; shift-f9
        EQUW    tabctl          ; shift-f10
        EQUW    allowc          ; shift-copy
        EQUW    wordle          ; shift-left
        EQUW    wordri          ; shift-right
        EQUW    pagedn          ; shift-down
        EQUW    pageup          ; shift-up
        ;
        EQUW    EDITlo          ; ctrl-f0
        EQUW    EDITlo          ; ctrl-f1
        EQUW    EDITlo          ; ctrl-f2
        EQUW    EDITlo          ; ctrl-f3
        EQUW    EDITlo          ; ctrl-f4
        EQUW    EDITlo          ; ctrl-f5
        EQUW    tsmcsr          ; ctrl-f6
        EQUW    bsmcsr          ; ctrl-f7
        IF cf8key=1
        EQUW    cf8swt          ; ctrl-f8
        ELSE
        EQUW    EDITlo          ; ctrl-f8
        ENDIF
        EQUW    EDITlo          ; ctrl-f9
        EQUW    EDITlo          ; ctrl-f10
        EQUW    dellin          ; ctrl-copy
        EQUW    curst           ; ctrl-left
        EQUW    curend          ; ctrl-right
        EQUW    curedf          ; ctrl-down
        EQUW    stfile          ; ctrl-up

.TXTTAB
        EQUW    F0
        EQUW    F1
        EQUW    F2
        EQUW    F3
        EQUW    F4
        EQUW    F5
        EQUW    F6
        EQUW    F7
        EQUW    F8
        EQUW    F9
        EQUW    F9
        EQUW    F9
        EQUW    F9
        EQUW    F9
        EQUW    F9
        EQUW    F9
        EQUW    SHFF0
        EQUW    SHFF1
        EQUW    SHFF2
        EQUW    SHFF3
        EQUW    SHFF4
        EQUW    SHFF5
        EQUW    SHFF6
        EQUW    SHFF7
        EQUW    SHFF8
        EQUW    SHFF9
        EQUW    SHFTAB
        EQUW    SHFCOP
.BIGMES
        JSR VSTRNG
        EQUB    remap("┌shf-f0─┬shf-f1─┬shf-f2─┬shf-f3─┬shf-f4─┬shf-f5─┬shf-f6─┬shf-f7─┬shf-f8─┬shf-f9┐")
        EQUB    remap("│Display│Insert/│Insert │Remove │Return │ Set   │ Clear │Marked │Marked │Clear │")
        EQUB    remap("│Returns│Over   │ file  │Margins│Languag│ Mode  │ Marks │Move   │Delete │text  │")
        EQUB    remap("├──f0───┼──f1───┼──f2───┼──f3───┼──f4───┼──f5───┼──f6───┼──f7───┼──f8───┼──f9──┤")
        EQUB    remap("│ Goto  │Command│ Load  │ Save  │Find   │Global │ Mark  │Marked │ Print │ Old  │")
        EQUB    remap("│ line  │line   │ file  │ file  │String │Replace│ Place │Copy   │ text  │ text │")
        EQUB    remap("└───────┴───────┴───────┴───────┴───────┴───────┴───────┴───────┴───────┴──────┘")
        NOP
        RTS
.BIGMET
        JSR     VSTRNG
        EQUB    remap("The Acorn Screen Editor © 1984 Acorn Computers Ver "), vers

        IF mouse = 1
        EQUB    "m"
        ELSE
        EQUB    " "
        ENDIF

        EQUB    remap("┌───┐Shift: screen up   ")      ; EOL 1

        IF syzygy=1     ; "a SYZYGY prog"

        EQUB    "      a"
        EQUB    23,32,&00,&01,&01,&01,&00,&01,&01,&01,32
        EQUB    23,32,&F4,&14,&04,&F3,&10,&10,&10,&E7,32
        EQUB    23,32,&5F,&41,&42,&C4,&48,&50,&50,&9F,32
        EQUB    23,32,&44,&45,&45,&3C,&04,&04,&04,&79,32
        EQUB    23,32,&F4,&14,&14,&F3,&10,&10,&10,&E7,32
        EQUB    23,32,&40,&40,&40,&C0,&40,&40,&40,&80,32
        EQUB    23,32,&00,&00,&00,&00,&00,&00,&00,&00
        EQUB    "prog "
        ELSE
        EQUB    "                  "
        ENDIF

        EQUB    "             Descriptive Mode "

        IF cf8key=1
        EQUB    "CR/LF"
        ELSE
        IF termin=lf
        EQUB    "(LF) "
        ELSE
        EQUB    "     "
        ENDIF
        ENDIF

        EQUB    remap("   │ ⭡ │Control: text start")  ; EOL 2

        EQUB    remap("TAB performs tabulation controlled by shift TAB.      ┌─┴─┬─┴─┐Shift: word l/r  ")  ; EOL 3

        EQUB    remap("COPY deletes the character above the cursor.          │ ⯇╴│╶⯈ │Control:         ")  ; EOL 4

        EQUB    remap("shift COPY provides normal soft keys and cursor       └─┬─┴─┬─┘    l/r of line  ")  ; EOL 5

        EQUB    remap("       copying (ESCAPE to leave this mode).             │ ⭣ │Shift: screen down ")  ; EOL 6

        EQUB    remap("control COPY deletes the current line to next new line  └───┘Control: text end  ")  ; EOL 7
        NOP
        RTS

.f0
        EQUB    "f0",cr
        IF shortm=0
        EQUB    "The cursor can be moved to a new line.",cr
        EQUB    "For this operation lines are character sequences",cr
        EQUB    "ended by RETURN (|M).",cr,&EA
        ELSE
        EQUB    "Move the cursor to a new line",cr
        EQUB    "Lines are character sequences ended by RETURN (|M)",cr
        EQUB    cr
        NOP
        ENDIF

.shff0
        EQUB    "shf-f0",cr
        IF shortm=0
        EQUB    "The ends of lines can be shown as a special",cr
        EQUB    "character so that they can be seen clearly.",cr
        EQUB    "This alters with each press of shf-f0.",cr,&EA
        ELSE
        EQUB    "Highlight the end of line character",cr
        EQUB    "This is a toggled function",cr
        EQUB    cr
        NOP
        ENDIF

.F1
        EQUB    "f1",cr
        IF shortm=0
        EQUB    "Commands to the computer's operating system can be",cr
        EQUB    "given. The result is seen at once. Extra commands",cr
        EQUB    "can be entered until RETURN by itself is typed.",cr,&EA
        ELSE
        EQUB    "Commands can be sent to the Command Line Interpreter",cr
        EQUB    "The function is terminated by RETURN only",cr
        EQUB    cr
        NOP
        ENDIF

.SHFF1
        EQUB    "shf-f1",cr
        IF shortm=0
        EQUB    "Changes between Insert and Over. In Insert mode the",cr
        EQUB    "text typed is inserted causing the existing text to",cr
        EQUB    "move. In Over mode the text is typed over old text.",cr,&EA
        ELSE
        EQUB    "Toggle Insert/Over mode",cr
        EQUB    cr
        EQUB    cr
        NOP
        ENDIF

.F2
        EQUB    "f2",cr
        IF shortm=0
        EQUB    "A text file will be loaded, erasing the current text.",cr
        EQUB    "RETURN uses the name at the start of text after a '>'",cr
        EQUB    "COPY, RETURN to use the current file name.",cr,&EA
        ELSE
        EQUB    "Load file, erasing the current text",cr
        EQUB    "RETURN uses the name at the start of text after a '>'",cr
        EQUB    "COPY RETURN to use the current file name",cr
        NOP
        ENDIF

.SHFF2
        EQUB    "shf-f2",cr
        IF shortm=0
        EQUB    "A text file will be loaded at the current cursor.",cr
        EQUB    "RETURN uses the name at the start of text after a '>'",cr
        EQUB    "COPY, RETURN to use the current file name.",cr,&EA
        ELSE
        EQUB    "Insert file to current cursor position",cr
        EQUB    "RETURN uses the name at the start of text after a '>'",cr
        EQUB    "COPY RETURN to use the current file name",cr
        NOP
        ENDIF

.F3
        EQUB    "f3",cr
        IF shortm=0
        EQUB    "All or 'mark to cursor' text will be saved to a file.",cr
        EQUB    "RETURN uses the name at the start of text after a '>'",cr
        EQUB    "COPY, RETURN to use the current file name.",cr,&EA
        ELSE
        EQUB    "Save text. All or 'mark to cursor' text will be saved",cr
        EQUB    "RETURN uses the name at the start of text after a '>'",cr
        EQUB    "COPY RETURN to use the current file name",cr
        NOP
        ENDIF

.SHFF3
        EQUB    "shf-f3",cr
        IF shortm=0
        EQUB    "The top and bottom scroll margins have been removed.",cr
        EQUB    "Set Top scroll margin to cursor line with ctrl-f6",cr
        EQUB    "Set Bottom scroll margin to cursor line with ctrl-f7",cr,&EA
        ELSE
        EQUB    "Remove top and bottom scroll margins",cr
        EQUB    "Set Top scroll margin to current line with ctrl-f6",cr
        EQUB    "Set Bottom scroll margin to current line with ctrl-f7",cr
        NOP
        ENDIF

.F4
        EQUB    "f4:- Interactive Find and Replace Function.",cr
        IF shortm=0
        EQUB    "RETURN to use last f4. Special search characters are:",cr
        EQUB    "# digit, $ RETURN, . any, [ ] set of char, a-z a to z",cr
        EQUB    "~ not, * many, ^ many, | control, @ alpha, \ literal.",cr,&EA
        ELSE
        EQUB    "RETURN to use last f4. Special search characters are:",cr
        EQUB    "# digit, $ RETURN, . any, [ ] set of char, a-z a to z",cr
        EQUB    "~ not, * many, ^ many, | control, @ alpha, \ literal.",cr
        NOP
        ENDIF

.SHFF4
        EQUB    "shf-f4",cr
        IF shortm=0
        EQUB    "Return to specified language.",cr
        EQUB    "The text in the buffer will be 'transferred' into the",cr
        EQUB    "language.",cr,&EA
        ELSE
        EQUB    "Return to specified language",cr
        EQUB    "Text is transferred to the language",cr
        EQUB    cr
        NOP
        ENDIF

.F5
        IF shortm=0
        EQUB    "f5:- Global replace.              All, or marked text.",cr
        EQUB    "RETURN to use last f5. Special replace characters are:",cr
        EQUB    "/ to begin the replace section; & is the found string",cr
        EQUB    "%n found wild section n. See f4 for find characters.",cr,&EA
        ELSE
        EQUB    "f5: Global replace. All or marked text",cr
        EQUB    "RETURN to use last f5. Special replace characters are:",cr
        EQUB    "/ to begin the replace section; & is the found string",cr
        EQUB    "%n found wild section n. See f4 for find characters.",cr
        NOP
        ENDIF

.SHFF5
        EQUB    "shf-f5",cr
        IF shortm=0
        EQUB    "The screen mode may be set to a specific mode. Also",cr
        EQUB    "Descriptive (D), or Key legend (K) modes may be set.",cr
        EQUB    "D and K use mode 0.",cr,&EA
        ELSE
        EQUB    "Set screen mode",cr
        EQUB    "D - Descriptive",cr
        EQUB    "K - Key legend",cr
        NOP
        ENDIF

.F6
        EQUB    "f6",cr
        IF shortm=0
        EQUB    "The current position of the cursor (_) is remembered.",cr
        EQUB    "The number at the bottom indicates how many (0,1,2)",cr
        EQUB    "marks (",255,") are being used.",cr,&EA
        ELSE
        EQUB    "Set a marker",cr
        EQUB    "The number (0,1,2) of marks (",255,") set is",cr
        EQUB    "given on the status line",cr
        NOP
        ENDIF

.SHFF6
        EQUB    "shf-f6",cr
        IF shortm=0
        EQUB    "All place marks are cleared.",cr
        EQUB    "",cr
        EQUB    "",cr,&EA
        ELSE
        EQUB    "Clear markers",cr
        EQUB    cr
        EQUB    cr
        NOP
        ENDIF

.F7
        EQUB    "f7",cr
        IF shortm=0
        EQUB    "The text between two marked places is copied to",cr
        EQUB    "the current cursor position.",cr
        EQUB    "The marks are NOT cleared.",cr,&EA
        ELSE
        EQUB    "Text is copied to the current position",cr
        EQUB    "The marks are NOT cleared",cr
        EQUB    cr
        NOP
        ENDIF

.SHFF7
        EQUB    "shf-f7",cr
        IF shortm=0
        EQUB    "The text between two marked places is moved to",cr
        EQUB    "the current cursor position.",cr
        EQUB    "The marks are then cleared.",cr,&EA
        ELSE
        EQUB    "Text is moved to current position",cr
        EQUB    "The marks are cleared",cr
        EQUB    cr
        NOP
        ENDIF

.F8
        EQUB    "f8",cr
        IF shortm=0
        EQUB    "The whole text is printed out to the screen or printer",cr
        EQUB    "using the built-in formatter/paginator.",cr
        EQUB    "",cr,&EA
        ELSE
        EQUB    "Print text to screen or printer",cr
        EQUB    cr
        EQUB    cr
        NOP
        ENDIF

.SHFF8
        EQUB    "shf-f8",cr
        IF shortm=0
        EQUB    "The text between the cursor and the marked place",cr
        EQUB    "is deleted.",cr
        EQUB    "The mark is then cleared.",cr,&EA
        ELSE
        EQUB    "Delete text between marker and current position",cr
        EQUB    "The mark is then cleared",cr
        EQUB    cr
        NOP
        ENDIF

.F9
        EQUB    "f9",cr
        IF shortm=0
        EQUB    "The old text in the buffer is recovered after a BREAK",cr
        EQUB    "or immediately after a Clear Text (by shf-f9).",cr
        EQUB    "",cr,&EA
        ELSE
        EQUB    "Recover old text",cr
        EQUB    cr
        EQUB    cr
        NOP
        ENDIF

.SHFF9
        EQUB    "shf-f9",cr
        IF shortm=0
        EQUB    "All text in the buffer is deleted.",cr
        EQUB    "Use shf-f9 twice to remove the text beyond hope of a",cr
        EQUB    "recovery by f9.",cr,&EA
        ELSE
        EQUB    "Delete text",cr
        IF stamp=0
        EQUB    "shf-f9 twice will remove text beyond recovery by f9",cr
        EQUB    cr
        ELSE
        EQUB    "shf-f9 Y will select time stamping",cr
        EQUB    "shf-f9 shf-f9 selects 'EXEC' addresses",cr
        ENDIF
        NOP
        ENDIF

.SHFTAB
        EQUB    "shf-TAB",cr
        IF shortm=0
        EQUB    "The TAB key may be used to move to zones of eight",cr
        EQUB    "characters across the screen, or to position under",cr
        EQUB    "the first character of the line immediately above.",cr,&EA
        ELSE
        EQUB    "TAB to columns of 8, or to the position under the",cr
        EQUB    "first character of the previous line",cr
        EQUB    cr
        NOP
        ENDIF

.SHFCOP
        EQUB    "shf-COPY",cr
        IF shortm=0
        EQUB    remap("Cursor editing can be used with ⭡⯇╴╶⯈⭣ and COPY."),cr
        EQUB    "User defined soft keys are available as normal.",cr
        EQUB    "All characters except ESCAPE are put into text.",cr,&EA
        ELSE
        EQUB    remap("Cursor editing mode. ⭡⯇╴╶⯈⭣ and COPY and user"),cr
        EQUB    "defined soft keys available as normal",cr
        EQUB    "ESCAPE terminates this mode",cr
        NOP
        ENDIF

        IF cF8key=1
.ctrlF8
        EQUB    "Ctrl-f8",cr
        EQUB    "Toggle newline character between LF(|J) and CR(|M)",cr
        EQUB    cr
        EQUB    cr
        NOP
        ENDIF
