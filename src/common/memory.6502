.copy_backward
        ; Copy block backwards (i.e. to lower address).
        ; Entry - src_ptr --> block of size XY
        ; dst_ptr --> destination address
        STX     size
        STY     size + 1
        LDA     size
        ORA     size + 1
        BEQ     BKEXIT
        LDX     size + 1
        SEC
        LDA     #0
        SBC     size
        TAY
        BEQ     BKLOOP
        STA     temp
        SEC
        LDA     src_ptr
        SBC     temp
        STA     src_ptr
        BCS     CPNHI1
        DEC     src_ptr + 1
        SEC
.CPNHI1
        LDA     dst_ptr
        SBC     temp
        STA     dst_ptr
        BCS     CPNHI2
        DEC     dst_ptr + 1
.CPNHI2
        INX
.BKLOOP
        LDA     (src_ptr),Y
        STA     (dst_ptr),Y
        INY
        BNE     BKLOOP
        INC     src_ptr + 1
        INC     dst_ptr + 1
        DEX
        BNE     BKLOOP
.BKEXIT
        RTS

.save_text_bounds
        LDA     text_start + 1
        JSR     check_pointer
        LDA     gap_start + 1
        JSR     check_pointer
        LDA     gap_end + 1
        JSR     check_pointer
        LDA     text_end + 1
        JSR     check_pointer
        LDX     text_end
        LDY     text_end + 1
        JSR     gap_forward_to_xy
        LDA     text_start
        STA     old_text_bounds
        LDA     text_start + 1
        STA     old_text_bounds + 1
        LDA     gap_start
        STA     old_text_bounds + 2
        LDA     gap_start + 1
        STA     old_text_bounds + 3
        CLC
.CHKPTX
        RTS
.check_pointer
        CMP     himem + 1
        BCS     CHKPTX
        CMP     oshwm + 1
        BCS     CHKPTX
        PLA
        PLA
        RTS
