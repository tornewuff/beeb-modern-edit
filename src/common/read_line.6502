.read_trimmed_line
        ; Reads line to commandline (line_buffer), & strips leading &
        ; trailing spaces.
        ; Exit - temp --> 1st non-space char on line
        ; A      = 1st non-space char on line
        ; Y      = 0
        ; EQ if line was 'empty', else NE

        JSR     read_line
        TYA
        BEQ     renSCR
.renSST
        LDA     commandline - 1,Y
        CMP     #space
        BNE     renSCR
        DEY
        BNE     renSST
.renSCR
        LDA     #cr
        STA     commandline,Y
        LDY     #&FF
.renSIG
        INY
        LDA     commandline,Y
        CMP     #space
        BEQ     renSIG
        CLC
.readIM
        TYA
        ADC     #<commandline
        STA     temp
        LDA     #&00
        ADC     #>commandline
        STA     temp + 1
        LDY     #&00
        LDA     (temp)
        CMP     #cr
.escCLR
        RTS

.READINIT
        LDY     #&00
        BRA     readIM

.read_line
        LDA     #' '
        JSR     oswrch

        ; Read line into line_buffer/commandline, testing for escape.
        ; Exit - Y = No. of chars read (excluding CR).

        LDA     #thelot
        STA     update_required
        JSR     read_line_raw
        BCC     escCLR
.escSET
        JSR     print_inline
        EQUB    &03,&0F,&0D,&EA
        LDA     brk_action
        CMP     #&02
        BNE     escSIM
        JSR     close_index_file
        JSR     cursor_text_start
.escSIM
        STZ     cursor_editing
        JMP     brk_handler.escCON
        IF edit150
.read_char_esc                  ; read a character and check for escape
        JSR     osrdch
        ENDIF
.test_escape
        BIT     &FF
        BMI     escSET
        RTS

.read_line_raw
        LDY     #0
.RDLNLP
        IF edit150
        JSR     read_key
        ELSE
        JSR     osrdch
        BCS     RDLNEX
        ENDIF
        STA     line_buffer,Y
        CMP     #&7F
        BNE     RDLN2
        CPY     #0
        BEQ     RDLNLP
        DEY
        JSR     oswrch
        BRA     RDLNLP
.RDLN2
        CMP     #&15
        BNE     RDLN3
.RDLNDL
        TYA
        BEQ     RDLNLP
        LDA     #&7F
        JSR     oswrch
        DEY
        BRA     RDLNDL
.RDLN3
        INY
        CMP     #cr
        BEQ     RDLNEG
        JSR     print_text_char
        BRA     RDLNLP
.RDLNEG
        PHY
        JSR     cursor_off
        PLY
        DEY
        CLC
.RDLNEX
        RTS
