        ;Marks are stored in set_marks_lo,hi (Set Mark Address Table), where the
        ;addresses refer to positions in the 2nd half of text; when updated
        ;(any number of times), this address is translated into a value in
        ;used_marks_lo,hi (Used Mark Address Table), where the addresses refer to
        ;positions in the text as it is currently partitioned.
.MARKUPDATE
        ;Update marks for current position of gap.
        ;Exit  -  marks_before_cursor =       No. of marks before gap_end.
        JSR     MKUDCH
.MKUDKN
        STZ     marks_before_cursor
        LDX     mark_count
.MKUDLP
        DEX
        BMI     MKUDEX
        LDY     set_marks_lo,X
        STY     used_marks_lo,X
        CPY     gap_end
        LDA     set_marks_hi,X
        STA     used_marks_hi,X
        SBC     gap_end+1
        BCS     MKUDLP
        INC     marks_before_cursor
        SEC
        TYA
        SBC     chunk_size
        STA     used_marks_lo,X
        LDA     used_marks_hi,X
        SBC     chunk_size + 1
        STA     used_marks_hi,X
        BCS     MKUDLP
.MKUDEX
        RTS
.MKUDCH
        ;chunk_size :=       size of gap to correct for.
        SEC
        LDA     gap_end
        SBC     gap_start
        STA     chunk_size
        LDA     gap_end+1
        SBC     gap_start+1
        STA     chunk_size + 1
        RTS
.CLRMARKS
        ;Clear, count update & order mark(s), ready for use.
        ;Entry - Mark1 (markstk) and/or Mark2 (markstk+2) possibly set.
        ;Exit  - Gap finepositioned
        ;        Marks ordered so that Mark1 <=       Mark2
        ;        Marks cleared & status updated
        ;        A[Z] =       num_marks =       No. of marks
        ;Save (gap_end - gap_start) for updating marks, then finepositiongap
        JSR     FINEPOSITIONGAP
        JSR     MKUDCH
        JSR     MKUDKN

        ;If Mark2 (exists) < Mark1, then swap.
        LDX     mark_count
        CPX     #2
        BNE     CLRMCO
        LDA     used_marks_lo+1
        CMP     used_marks_lo
        LDA     used_marks_hi+1
        SBC     used_marks_hi
        BCS     CLRMCO
        LDA     used_marks_lo
        LDY     used_marks_lo+1
        STA     used_marks_lo+1
        STY     used_marks_lo
        LDA     used_marks_hi
        LDY     used_marks_hi+1
        STA     used_marks_hi+1
        STY     used_marks_hi
.CLRMCO
        LDA     mark_count
        STA     num_marks
        STZ     mark_count
        JSR     show_status
        LDA     num_marks
.MKRFEX
        RTS
.refuse_if_marked
        ;Complain if any marks are set.
        LDA     mark_count
        BEQ     MKRFEX
        BRK
        EQUB    1,"Mark(s) set",0
.NMBLOK
        ;Normalizes a marked block of text, to ease use.
        ;Entry  -  Marks updated (gap fine positioned). search_end =       gap_end
        ;Exit   -  'Bad marking' error if 2 marks were set.
        ;       -  EQ - 0 marks were set.
        ;          NE - 1 mark was set (csr-mark or mark-csr):
        ;               Gap moved to start of block,
        ;               XY =       end of block.
        LDA     gap_end
        STA     search_end
        LDA     gap_end+1
        STA     search_end+1
        LDA     num_marks
        BEQ     NBLKEX
        CMP     #1
        BNE     BADMARKING
        LDX     used_marks_lo
        LDY     used_marks_hi
        DEC     marks_before_cursor
        BNE     NBLKEX
        JSR     gap_back_to_xy
        LDX     search_end
        LDY     search_end+1
.NBLKEX
        RTS
.dfinit
        ;Seperated this way to avoid grotty command-line escape.
        JSR     clamp_cursor_x
        JSR     CLRMARKS
        CMP     #2
        BEQ     BADMARKING
        PHA
        LDA     line
        STA     cursor_x
        PLA
        RTS
.dfblok
        ;Normalize a 'marked' block (defaulting to whole) of text.
        ;Exit  -  search_end =       Old cursor position (in end of text).
        ;         block_end =       End of 'marked' block.
        JSR     NMBLOK
        BNE     DBLKEP
        JSR     cursor_text_start
        LDX     text_end
        LDY     text_end + 1
.DBLKEP
        STX     block_end
        STY     block_end + 1
.DBLKRT
        RTS
.MVBLOK
        ;Ensure good marking (m-m-c or c-m-m) for a block 'move-op'
        ;Exit  -  CC: marks are after cursor
        ;         CS: marks are before cursor
        JSR     CLRMARKS
        CMP     #2
        BNE     BADMARKING
        ;if 2nd mark on cursor then shift it to gap_start
        LDA     used_marks_lo + 1
        CMP     gap_end
        BNE     MVBLOJ
        LDA     used_marks_hi + 1
        CMP     gap_end+1
        BNE     MVBLOJ
        LDA     gap_start
        STA     used_marks_lo + 1
        LDA     gap_start+1
        STA     used_marks_hi + 1
        INC     marks_before_cursor
.MVBLOJ
        LDA     marks_before_cursor
        DEA     ;cmp#1
        IF edit150
        BNE     DBLKRT
        ELSE
        BEQ     BADMARKING
        RTS
        ENDIF
.BADMARKING
        BRK
        EQUB    1,"Bad marking",0
.SETMARK
        JSR     FINEPOSITIONGAP
        LDX     mark_count
        CPX     #2
        BEQ     BADMARKING
        ;Save mark address.
        LDA     gap_end
        STA     set_marks_lo,X
        LDA     gap_end+1
        STA     set_marks_hi,X
        JSR     NORMALIZE
        INC     mark_count
        JMP     show_status
.CLEARMARKS
        JSR     CLRMARKS
        JMP     NORMALIZE
