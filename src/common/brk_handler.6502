.brk_handler {
        ;Outputs 'brk' error message, & jumps to relevant re-entry
        ;point. Detailed action depends on value of 'brk_action' on entry -
        ; brk_action = 0 Moves cursor to editor status position,
        ; outputs error message, then prompts for space
        ; before jumping to EDITcont.
        ; 1    Outputs error message, and jumps to starloop.
        ; 2    resets to start of file and closes indexfile, then as 0

        LDX     #&FF
        TXS
        STZ     cursor_editing
IF edit150
        JSR     acknowledge_escape
ELSE
        LDA     #osbyte_acknowledge_escape
        JSR     osbyte
ENDIF
        LDA     brk_action
        CMP     #&FF
        BNE     simBRK
.unret
        LDA     addr
        BNE     unretA
        DEC     addr + 1
.unretA
        DEC     addr
        LDA     src_ptr
        BNE     unretB
        DEC     src_ptr + 1
.unretB
        DEC     src_ptr
        LDA     (src_ptr)
        STA     (addr)
        LDA     addr
        BNE     unret
        LDA     addr + 1
        CMP     string + 1
        BNE     unret
        LDA     #cr
        STA     (text_end)
        LDA     #&00
.simBRK
        CMP     #&01
        BNE     simBK2
        JSR     print_error_nl
        JMP     starCN
.simBK2
        BCC     norBRK
        JSR     close_index_file
        JSR     cursor_text_start
.norBRK
        JSR     print_inline
        EQUB    &03,&0F,&EA
        JSR     move_to_status

IF lerror=1
        IF edit150
        JSR     define_chars
        ENDIF
        JSR     print_inline
        EQUB    &0B,&0B,&0B,remap("┌"),&EA
        LDX     #remapchar("─")
        LDA     #59-80
        JSR     print_repeat_inline
        EQUB    remap("Shift f5 D for info┐│"),&EA
        LDX     #' '
        LDA     #78-80
        JSR     print_repeat_inline
        EQUB    remap("│└"),&EA
        LDX     #remapchar("─")
        LDA     #54-80
        JSR     print_repeat_inline
        EQUB    remap("Press ESCAPE to continue┘"),11,11,9,&EA
        JSR     print_error
        IF edit150
        JSR     restore_chars
        ENDIF
ELSE
        JSR     print_error_nl
        JSR     cursor_off
        LDA     options
        AND     #&07
        CMP     #&05
        BEQ     nomess
        LDA     (&FD)
        CMP     #&01
        BNE     nomess
        JSR     print_inline
        IF 1=0
                EQUB    lf,cr,"For help type: shf-f5 D",&EA
        ELSE
                EQUB    lf,cr,"Shift f5 D for info",&EA ; Slightly shorter
        ENDIF
.nomess
        JSR     osnewl
        JSR     print_inverse_inline
        EQUB    "Press ESCAPE to continue",&EA
ENDIF

.esclop
        JSR     osrdch
        CMP     #&1B
        BNE     esclop
.escCON
IF edit150
        JSR     acknowledge_escape
ELSE
        LDA     #osbyte_acknowledge_escape
        JSR     osbyte
ENDIF
        JSR     NORMALIZE
        JMP     EDITcont

IF edit150
.acknowledge_escape
        LDA     #osbyte_acknowledge_escape
        JMP     osbyte
ENDIF

.print_error_nl
        JSR     osnewl
.print_error
        LDY     #&01
.BRKOLP
        LDA     (&FD),Y
        BEQ     BRKOX
        JSR     osasci
        INY
        BNE     BRKOLP
.BRKOX
        RTS
}
