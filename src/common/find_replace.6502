        ; Find-Replace & Global-Replace should have their own seperate command
        ; keys, with the first delimeter 'built in' (i.e. not required), and CR
        ; sufficing as terminator -
        ; FR/ ....... [/.......] <CR>
        ; GR/ .......  /.......  <CR>
.GETRESP
        ;Exit - A holds char - forced to lower case - read from keyboard
        JSR     EDRDCH
        ORA     #&20
        RTS
.MOVETOFOUNDPOSITION
        LDX     MS
        LDY     MS+1
        JMP     gpfdXY
.GLOBREPLACE
        JSR     dfinit
        JSR     prompt
        EQUB    "Global replace:",&EA
        IF extgf=1
        JSR     readlf
        ELSE
        JSR     readLS
        ENDIF
        JSR     READINIT
        BNE     NEWGR
        CMP     grbuff
        BEQ     NOBUFF
.OLDGR
        LDA     grbuff,Y
        STA     (temp),Y
        INY
        BPL     OLDGR
        LDY     #0
.NEWGR
        LDA     (temp),Y
        STA     grbuff,Y
        INY
        CPY     #100
        BNE     NEWGR
        JSR     FINDTRANS
        JSR     dfblok
        STZ     line
        STZ     line+1
        STZ     TEXPFLAG
.GREPLP
        LDX     GE
        LDY     GE+1
.GREPNX
        STX     MS
        STY     MS+1
        JSR     SEARCH
        BCS     GREPEX
        INC     line
        BNE     GREPNH
        INC     line+1
.GREPNH
        LDA     replflag
        BNE     GREPRP
        LDX     me
        LDY     me+1
        BRA     GREPNX
.GREPRP
        JSR     chknrep
        BRA     GREPLP
.GREPEX
        ;Move cursor (as near as possible) to the place it started at, then
        ;output match count.
        LDX     string
        LDY     string+1
        JSR     GPBKXY
        JSR     NORMALIZE
        JSR     scrnud
.GREPCT                         ; report the count of replacements
        IF edit150
        LDX     prmcol
        INX
        ELSE
        LDX     #prmptl
        ENDIF
        JSR     PRMPTX
        EQUB    " ",&EA
        JSR     WRITLINE
        JSR     PRMPTX
        EQUB    " found",&EA
        RTS
.NOBUFF
        BRK
        EQUB    1,"No previous string",0
.FINDREPLACE
        JSR     prompt
        EQUB    "Find and replace:",&EA
        IF edit150
        STZ     frall
        ENDIF
        IF extgf=1
        JSR     readlf
        ELSE
        JSR     readLS
        ENDIF
        JSR     READINIT
        BNE     NEWFR
        CMP     frbuff
        BEQ     NOBUFF
.OLDFR
        LDA     frbuff,Y
        STA     (temp),Y
        INY
        BPL     OLDFR
        LDY     #0
.NEWFR
        LDA     (temp),Y
        STA     frbuff,Y
        INY
        CPY     #100
        BNE     NEWFR
        JSR     FINDTRANS
        JSR     TEMPSX
        JSR     FINEPOSITIONGAP
        LDA     line
        STA     scrnX
        ;Set up search termination pointer & flag.
        LDA     tmax
        STA     texp
        IF edit150
        STA     endp
        ENDIF
        LDA     tmax+1
        STA     texp+1
        IF edit150
        STA     endp+1
        ENDIF
        STA     TEXPFLAG
.IMRPRL
        LDX     GE
        LDY     GE+1
.IMRPCL
        STX     MS
        STY     MS+1
        JSR     SEARCH
        BCS     IMRPNF
        JSR     MOVETOFOUNDPOSITION
        IF edit150
        INC     line            ; count the matches
        BNE     IMRPLN
        INC     line+1
.IMRPLN
        LDA     frall           ; replacing to the end of the file?
        BNE     IMRPRP
        ENDIF
        JSR     normax; get position of X back
        LDA     BSM ;Move to BSM
        STA     scrnY
        JSR     scrnud
        LDA     #fullscreen
        STA     UPDATEREQD
        IF edit150
        JSR     FRPRMT
        ELSE
        JSR     prompt
        EQUB    "R(eplace), C(ontinue) or ESCAPE",&EA
        ENDIF

        JSR     CSRSCREENXY
        JSR     CURON
.IMRPPR
        JSR     GETRESP
        IF edit150
        CMP     #'e'
        BNE     IMRPCC
        STA     frall           ; replace this and all the rest
        LDA     #1
        STA     line
        STZ     line+1
        JSR     MKREFUSE
        LDA     replflag
        BNE     IMRPEX
        JSR     FRRDRP
        INC     replflag
.IMRPEX
        JMP     IMRPRP
.IMRPCC
        ENDIF
        CMP     #'c'
        BNE     IMRPNC
        LDX     me
        LDY     me+1
        BRA     IMRPCL
.IMRPNC
        CMP     #'r'
        BNE     IMRPPR
        JSR     MKREFUSE
        ;Either use supplied replace part, or prompt for one.
        LDA     replflag
        BNE     IMRPRP
        IF edit150
        JSR     FRRDRP
        ELSE
        JSR     prompt
        EQUB    "Replace by:",&EA

        IF extgf=1
        JSR     readlf
        ELSE
        JSR     readLS
        ENDIF
        JSR     READINIT
        JSR     MININIT
        LDA     replindex
        STA     outindex
        JSR     REPLPART
        ENDIF
.IMRPRP
        JSR     chknrep
        JMP     IMRPRL
.IMRPNF
        JSR     NORMALIZE
        LDA     #thelot
        STA     UPDATEREQD
        JSR     scrnud
        JSR     status
        IF edit150
        LDA     frall           ; after replacing to the end, give the count
        BEQ     IMRPN2
        JMP     GREPCT
.IMRPN2
        LDX     prmcol
        INX
        ELSE
        LDX     #prmptl
        ENDIF
        JSR     PRMPTX
        EQUB    " Not found",&EA
        RTS
