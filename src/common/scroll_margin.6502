.set_top_margin
        ; Set Top Scroll Margin to current cursor line.
        LDA     cursor_y
        STA     top_margin
        BRA     noupda

.set_bottom_margin
        ; Set Bottom Scroll Margin to current cursor line.
        LDA     cursor_y
        STA     bottom_margin
        BRA     noupda

.clear_scroll_margins
        ; Clear Scroll Margins.
        STZ     top_margin
        LDA     page_length
        STA     bottom_margin

.noupda
        STZ     update_required
        RTS
