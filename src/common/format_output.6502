.VDUBIT
        TAY
        LDA     translate_table,Y
        STA     scratch
        JSR     XYSCRATCH
        LDA     #10
        JMP     osword
.DOVDU
        BIT     bold
        BPL     VDUNBL
; bold character
        PHY
        PHX
        JSR     VDUBIT
        LDX     #7
.VDUBLD
        LDA     scratch+1,X
        LSR     A
        ORA     scratch+1,X
        STA     scratch+1,X
        DEX
        BPL     VDUBLD
        BIT     underline
        BPL     VDUDON
; both bold and underline
        BRA     VDUUND
.VDUNBL
        BIT     underline
        BPL     WRCHA
; underline character
        PHY
        PHX
        JSR     VDUBIT
.VDUUND
        LDA     scratch+8
        LSR     A
        ROR     A
        ORA     scratch+8
        ROL     A
        EOR     #&FF
        TSB     scratch+8
.VDUDON
        IF edit150
        JSR     print_inline
        EQUB    23,32,&EA
        ELSE
        LDA     #23
        JSR     oswrch
        LDA     #32
        JSR     oswrch
        ENDIF
        LDX     #1
.VDUPRG
        LDA     scratch,X
        JSR     oswrch
        INX
        CPX     #9
        BNE     VDUPRG
        JSR     print_inline
        EQUB    32,23,32,0,0,0,0,0,0,0,0,&EA
        PLX
        PLY
        RTS
.ESCAP
        IF edit150
        JSR     brk_handler.acknowledge_escape
        ELSE
        LDA     #&7E
        JSR     osbyte
        ENDIF
        JMP     DODWN

.format_write_char
        BIT     escflg
        BMI     ESCAP        ; must not go via SENTRY,
                             ; because of marked mode (SWOPCH)
        BIT     index_output
        BMI     DOINDE

        IF cF8key=1
        CMP     line_terminator
        ELSE
        CMP     #termin       ; changed from CMPIM " "; BCC WRCHA
        ENDIF
        BEQ     wrchen

        BIT     print_flags
        BMI     DOVDU
        BVS     NOULA

        LDA     #' '
        BIT     underline
        BPL     NOULA
        LDA     #'_'
.NOULA
        PHA

        LDA     #&20
        BIT     print_flags
        BNE     NOBBLE
        BIT     bold
        BMI     NOBBLE

        LDA     #' '
        JSR     oswrch
        PLA
        RTS

.NOBBLE
        PLA
.WRCHA
        PHY
        TAY
        LDA     translate_table,Y
        PLY
        IF cF8key=1
.wrch
        JMP     (&020E)
.wrchen
        LDA     #cr
        BRA     wrch
        ELSE
        IF termin=cr
.wrchen
.wrch
        JMP     (&20E)
        ELSE
.wrch
        JMP     (&20E)
.wrchen
        LDA     #cr
        BRA     wrch
        ENDIF
        ENDIF
.DOINDE
        PHY
        TAY
        LDA     translate_table,Y
        LDY     index_handle
        BEQ     DOINDF
        JSR     osbput
.DOINDF
        PLY
        RTS

.lfwrch
        BIT     index_output
        BMI     writeX
        LDA     #lf       ; write a real line feed
        INC     lineno
        BNE     fmwrca
        INC     lineno + 1
.fmwrca
        DEC     lineot
        BNE     wrch
        JSR     oswrch
        PHX
        PHY
        LDX     even_footer
        LDY     even_footer + 1
        LDA     page
        LSR     A
        BCC     doftr1
        LDX     odd_footer
        LDY     odd_footer + 1
.doftr1
        DEC     lineot
        DEC     lineot
        JSR     macro
        LDA     #&FF
        STA     lineot        ; set needs header
        INC     page
        BNE     hi
        INC     page + 1
.hi
        PLY
        PLX
.writeX
        RTS
.write
        LDA     #&20
        TSB     print_flags
        LDA     bold
        PHA
        JSR     DOSCRE
        PLA
        STA     bold
        BIT     bold_required
        BPL     writeX
        LDA     #&20
        TRB     print_flags
        JSR     DOSCRE
        LDA     #&20
        TSB     print_flags
        RTS
