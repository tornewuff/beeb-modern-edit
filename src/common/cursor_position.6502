.move_to_cursor
        LDX cursor_x
        LDY     cursor_y
        BPL     move_to_xy
.move_to_status
        LDY page_length
        INY
.move_to_line
        LDX     #0
.move_to_xy
        LDA     #31
.vdu_axy                        ; VDU A,X,Y
        JSR     oswrch
        TXA
.vdu_ay                         ; VDU A,Y
        JSR     oswrch
        TYA
        JMP     oswrch
