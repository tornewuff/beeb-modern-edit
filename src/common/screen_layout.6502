.init_page
        LDA     options
        AND     #7
        CMP     #2
        BEQ     KEYONL
        CMP     #5
        BEQ     KEYONL
        BRA     NOTTUT
.CLEARSCREEN
        LDA     options
        AND     #7
        CMP     #2
        BEQ     DOTUT
        CMP     #5
        BNE     NOTTUT
.DOTUT
        PHA
        JSR     print_inline
        EQUB    26,home,&EA
        JSR     inverse_on
        IF edit150
        JSR     define_chars
        JSR     print_key_strip
        PLA
        CMP     #2
        BEQ     DOTUTX
        JSR     print_descriptive_help
.DOTUTX
        JSR     restore_chars
        ELSE
        JSR     print_key_strip
        PLA
        CMP     #2
        BEQ     KEYONL
        JSR     print_descriptive_help
        ENDIF
.KEYONL
        JSR     inverse_off
        JSR     read_window     ; get size of total screen
        STA     full_page_length ; page_length in A
        JSR     set_text_window
.NOTTUT
        JSR     read_window     ; get size of working area
        TAX                     ; page_length again in A
        INX                     ; Initialize screen_image.
        LDA     page_width
.SCMILO
        STA     screen_image,X
        DEX
        BPL     SCMILO
        JSR     show_status
        STZ     pending_update
        RTS
.read_window
        LDA     #160
        LDX     #10
        JSR     osbyte
        STX     page_width
        STY     page_length
        LDX     #8
        JSR     osbyte
        TYA
        CLC
        SBC     page_length
        STA     page_length
        RTS
.set_text_window
        LDA     options
        AND     #7
        LDY     #14
        CMP     #5
        BEQ     WINDOW
        LDY     #7
        CMP     #2
        BNE     NOWIND
.WINDOW
        IF edit150
        JSR     print_inline
        EQUB    28,0,&EA
        LDA     full_page_length
        INA
        JSR     oswrch
        LDA     page_width
        JMP     vdu_ay
        ELSE
        LDA     #28
        JSR     oswrch
        LDA     #0
        JSR     oswrch
        LDA     full_page_length
        INA
        JSR     oswrch
        LDA     page_width
        JSR     oswrch
        TYA
        JMP     oswrch
        ENDIF
.NOWIND
        LDA     #26
        JMP     oswrch
