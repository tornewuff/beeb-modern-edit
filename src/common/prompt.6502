.prompt_filename
        JSR     prompt
        EQUB    "Type filename ",&EA
IF edit150_size_opt
        BRA     PRMPT1
ELSE
        LDX     #1
        BRA     STRMFL
ENDIF

.prompt
        LDY page_length
        INY
        JSR     wipe_line
        LDX     #0
.prompt_at_x
        LDY     page_length
        INY
        JSR     cursor_to_xy
.PRMPT1
        LDX     #1
        BRA     STRMFL
.print_inline_inverse
        LDX     #0
.STRMFL
        JSR     write_char.inverse_on
        PLA
        STA     string
        PLA
        STA     string + 1
        JSR     print_string
        JSR     write_char.inverse_off
        TXA
        BEQ     STRMEX
        LDA     page_width
        DEA
        LDY     page_length
        STA     screen_image + 1,Y
.STRMEX
        JMP     (string)
