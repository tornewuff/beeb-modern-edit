.prompt_filename
        JSR     prompt
        EQUB    "Type filename ",&EA
        IF edit150
        BRA     PRMPT1
        ELSE
        LDX     #&01
        BRA     STRMFL
        ENDIF

.prompt
        LDY page_length
        INY
        JSR     wipe_line
        LDX     #0
.prompt_at_x
        LDY     page_length
        INY
        JSR     move_to_xy
.PRMPT1
        LDX     #1
        BRA     STRMFL
.print_inverse_inline
        LDX     #0
.STRMFL
        JSR     inverse_on
        PLA
        STA     string
        PLA
        STA     string + 1
        JSR     print_string
        JSR     inverse_off
        TXA
        BEQ     STRMEX
        LDA     page_width
        DEA
        LDY     page_length
        STA     screen_image + 1,Y
.STRMEX
        JMP     (string)
