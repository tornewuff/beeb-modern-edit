function_key_help_shff9_01 = {
    stringify({
        "shf-f9 (ESCAPE t!o abandon)", cr,
        "All text in the buffer is deleted.", cr,
        "Use shf-f9 twice to remove the text beyond hope of a", cr,
        "recovery by f9.", &ea
    }), stringify({
        "shf-f9", cr,
        "All text in the buffer is deleted.", cr,
        "Use shf-f9 twice to remove the text beyond hope of a", cr,
        "recovery by f9.", cr, &ea
    })
}

IF stamp
    function_key_help_shff9_2 = stringify({
        "shf-f9", cr,
        "Delete text", cr,
        "shf-f9 Y will select time stamping", cr,
        "shf-f9 shf-f9 selects 'EXEC' addresses", cr, &ea
    })
ELSE
    function_key_help_shff9_2 = stringify({
        "shf-f9", cr,
        "Delete text", cr,
        "shf-f9 twice will remove text beyond recovery by f9", cr,
        cr, &ea
    })
ENDIF

function_key_help_shff9 = CONCAT(function_key_help_shff9_01, function_key_help_shff9_2)

function_key_help_tabcopy = {
    {
        stringify({
            "shf-TAB", cr,
            "The TAB key may be used to move to zones of eight", cr,
            "characters across the screen, or to position under", cr,
            "the first character of the line immediately above.", &ea
        }), stringify({
            "shf-TAB", cr,
            "The TAB key may be used to move to zones of eight", cr,
            "characters across the screen, or to position under", cr,
            "the first character of the line immediately above.", cr, &ea
        }), stringify({
            "shf-TAB", cr,
            "TAB to columns of 8, or to the position under the", cr,
            "first character of the previous line", cr,
            cr, &ea
        })
    },
    {
        stringify({
            "shf-COPY", cr,
            "Cursor editing with the cursor keys & COPY is enabled.",
            "User defined soft keys are available as normal.", cr,
            "All characters except ESCAPE are put into text.", &ea
        }), stringify({
            "shf-COPY", cr,
            remap("Cursor editing can be used with ⭡⯇╴╶⯈⭣ and COPY."), cr,
            "User defined soft keys are available as normal.", cr,
            "All characters except ESCAPE are put into text.", cr, &ea
        }), stringify({
            "shf-COPY", cr,
            remap("Cursor editing mode. ⭡⯇╴╶⯈⭣ and COPY and user"), cr,
            "defined soft keys available as normal", cr,
            "ESCAPE terminates this mode", cr, &ea
        })
    },
}

IF cF8key
    function_key_help_cf8 = {{
        "",
        "",
        stringify({
            "Ctrl-f8", cr,
            "Toggle newline character between LF(|J) and CR(|M)", cr,
            cr,
            cr, &ea
        })
    }}
ELSE
    function_key_help_cf8 = {}
ENDIF

function_key_help_all = CONCAT(function_key_help_f0_f9, {function_key_help_shff9}, function_key_help_tabcopy, function_key_help_cf8)

IF help_text == "edit150"
    function_key_help_uncompressed = function_key_help_all[.., 0]
ELIF help_text == "original"
    function_key_help_uncompressed = function_key_help_all[.., 1]
ELIF help_text == "short"
    function_key_help_uncompressed = function_key_help_all[.., 2]
ELSE
    ERROR "unknown help_text: ", help_text
ENDIF

IF compressed_help_text
    ; The function key help text was not optimally abbreviated as it doesn't
    ; make use of &81 and &84 even though it could. Exclude them from the table
    ; to get matching results, but there are still a few inconvenient cases
    ; where particular words were not abbreviated even in strings that contain
    ; other occurrences that were - these are just broken up with an "!" which
    ; does not appear in any of the text otherwise, and just gets removed.
    function_key_help_mapping = CONCAT(build_abbreviation_mapping(without(abbreviation_table, {&81, &84} - abbreviation_base)), {{"!", ""}})
ELSE
    ; Just remove the "!" for correct uncompressed text.
    function_key_help_mapping = {{"!", ""}}
ENDIF

function_key_help = multi_replace_all(function_key_help_uncompressed, function_key_help_mapping)

.help_f0        : EQUB function_key_help[0]
.help_shff0     : EQUB function_key_help[1]
.help_f1        : EQUB function_key_help[2]
.help_shff1     : EQUB function_key_help[3]
.help_f2        : EQUB function_key_help[4]
.help_shff2     : EQUB function_key_help[5]
.help_f3        : EQUB function_key_help[6]
.help_shff3     : EQUB function_key_help[7]
.help_f4        : EQUB function_key_help[8]
.help_shff4     : EQUB function_key_help[9]
.help_f5        : EQUB function_key_help[10]
.help_shff5     : EQUB function_key_help[11]
.help_f6        : EQUB function_key_help[12]
.help_shff6     : EQUB function_key_help[13]
.help_f7        : EQUB function_key_help[14]
.help_shff7     : EQUB function_key_help[15]
.help_f8        : EQUB function_key_help[16]
.help_shff8     : EQUB function_key_help[17]
.help_f9        : EQUB function_key_help[18]
.help_shff9     : EQUB function_key_help[19]
.help_shftab    : EQUB function_key_help[20]
.help_shfcopy   : EQUB function_key_help[21]

IF cF8key
    .help_cf8   : EQUB function_key_help[22]
ENDIF
