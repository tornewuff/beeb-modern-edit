.tabkey
        LDA     #8
        BIT     options
        BNE     TABSTR
.TABPOS
        INC cursor_x
        LDA     cursor_x
        AND     #7
        BNE     TABPOS
        LDA     cursor_x
        CMP     page_width
        BCC     TABX
        STZ     cursor_x
        BRA     TABX
.TABSTR
        LDA     #1
        JSR     TPGSBK
        CMP     #1
        BNE     INSXEX
        LDY     cursor_x
        DEY
.TABS1
        INY
        CPY     page_width
        BCS     TABSSP
        LDA     (text_ptr),Y
        IF cF8key=1
        CMP     line_terminator
        ELSE
        CMP     #termin
        ENDIF
        BEQ     TABSSP
        CMP     #' '
        BNE     TABS1
        BRA     TABS2
.TABSSP
        LDY     #&FF
.TABS2
        INY
        CPY     page_width
        BCS     TABSEX
        LDA     (text_ptr),Y
        CMP     #' '
        BEQ     TABS2
.TABSEX
        STY     cursor_x
.TABX
        STZ     update_required
