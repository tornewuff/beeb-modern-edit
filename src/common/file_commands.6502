.new_text                       ; Clear text
        JSR     prompt
        IF stamp
        EQUB    "Clear text [Y (dated),shf-f9 (exec)]",&EA
        LDA     #&81
        TAX
        LDY     #&03
        JSR     osbyte
        JSR     test_escape
        TYA
        BEQ     doneW1
.newtn
        JMP     update_status_line
.doneW1
        PHX
        JSR     nstamp
        PLA
        ORA     #&20
        CMP     #'y'
        BNE     doneW2
        JSR     mstamp
.doneW2
        JSR     save_text_bounds
        JMP     EDITin
        ELIF edit150
        EQUB    "Clear text [Y,shf-f9 (exec),D (discard)]",&EA
        JSR     read_key_timeout
        BNE     newtk
        TAX
        BNE     newtk
.newtn
        JSR     update_status_line
        JMP     EDITth
.newtd                          ; discard: mark the text as discarded
        LDA     #2
        STA     modified
        BRA     newtn
.newtk
        CMP     #&99            ; shift-f9
        BEQ     donew
        ORA     #&20
        CMP     #'d'
        BEQ     newtd
        CMP     #'y'
        BNE     newtn
.donew
        JSR     save_text_bounds
        JMP     EDITin
        ELSE
        EQUB    "Text will be cleared if a key is hit",&EA
        LDA     #&81
        TAX
        LDY     #3
        JSR     osbyte
        JSR     test_escape
        CPY     #0
        BEQ     donew
.newtn
        JMP     update_status_line
.donew
        JSR     save_text_bounds
        JMP     EDITin
        ENDIF

.load_command
        ; Doesn't zap buffer until new file is correctly loaded.

        IF curtyp
        JSR     lsf
        ENDIF

        LDA     modified
        IF edit150
        CMP     #1              ; only ask if modified
        BNE     LOADF2
        JSR     prompt
        EQUB    "Overwrite text [Y,f2]:",7,&EA
        JSR     read_key_timeout
        BNE     LOADky
        TAX
        BEQ     newtn
.LOADky
        ELSE
        BEQ     LOADF2
        JSR     prompt
        EQUB    "Overwrite text [Y,f2]:",&EA
        JSR     osrdch
        ENDIF
        CMP     #128+2
        BEQ     LOADF2
        AND     #&DF
        CMP     #'Y'
        BNE     newtn
.LOADF2
        JSR     prompt
        EQUB    "Type filename to load:",&EA
        JSR     read_trimmed_line
        LDY     #0
        JSR     load_text
        JMP     EDITgt

.save_command                   ; Save file
        IF curtyp
        JSR     lsf
        ENDIF

        JSR     dfinit
        CMP     #&01
        BEQ     marksa

        JSR     prompt_filename
        EQUB    "to save:",&07,&EA

        JSR     read_trimmed_line
        JSR     dfblok
        LDY     #&00
        JSR     save_text

        STZ     modified

        LDX     search_end
        LDY     search_end + 1
        JSR     gap_forward_to_xy
        JMP     normalize_x

.marksa
        JSR     prompt_filename
        EQUB    "for MARK TO CURSOR save:",&07,&EA
        JSR     read_trimmed_line
        JSR     dfblok
        LDY     #&00
        LDA     (temp)
        cmp_line_terminator
        BEQ     msbad
        CMP     #&8B
        BEQ     msbad
        LDA     temp
        STA     scratch
        LDA     temp + 1
        STA     scratch + 1
        JSR     inSAVE
        LDX     search_end
        LDY     search_end + 1
        JSR     gap_forward_to_xy
        JMP     normalize_x
.msbad
        BRK
        EQUB    &01,"Bad use of stored name",null

.insert_file
        IF curtyp
        JSR     lsf
        ENDIF

        JSR     refuse_if_marked
        JSR     FINEPOSITIONGAP
        JSR     prompt_filename
        EQUB    "to insert:",&EA
        JSR     read_trimmed_line
        LDA     gap_start
        STA     addr
        LDA     gap_start + 1
        STA     addr + 1
        LDA     gap_end
        LDX     gap_end + 1
        LDY     #0
        IF edit150
        BIT     brk_handler + 1 ; (&FF) sets V: use the name in place
        ENDIF
        JSR     load_file
        STX     gap_start
        STY     gap_start+1
        JSR     set_modified
        LDX     addr ; Move to start of inserted file.
        LDY     addr+1
        JSR     gap_back_to_xy
        JMP     NORMALIZE
