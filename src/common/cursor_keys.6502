.cursor_left
        JSR     STARTTEST
        BCC     CLCONT
        LDA     screen_x
        BEQ     CSREXI
.CLCONT
        DEC     screen_x
        BPL     CSREXI
        LDA     page_width
        STA     screen_x
        ; C set if at start of text
.cursor_up
        JSR     STARTTEST
        BCS     CSREXI
        LDA     #1
        JSR     move_lines_back
        LDA     top_scroll_margin
        CMP     screen_y
        BCS     CUUPSC
.CUUPNS
        DEC     screen_y
        BPL     CSREXI
.CUUPSC
        LDA     screen_y ; In Top Scroll Margin. If more than Top Scroll Margin Width
        JSR     TPGSBK ; from top of file, then assign Scroll Pointer, else move cursor up.
        CMP     screen_y
        CLC
        BNE     CUUPNS
        LDA     text_ptr
        STA     scroll_ptr
        LDA     text_ptr+1
        STA     scroll_ptr+1
        LDA     #HARDDOWN
        STA     update_required
        RTS
.WORDRT
        LDY     screen_x
        LDA     (gap_end),Y
        IF cF8key
        CMP     line_terminator
        ELSE
        CMP     #termin
        ENDIF
        BNE     EASYRT
        JSR     cursor_down
        BCS     WORDXX
        JSR     screen_update
.cursor_line_start
        STZ     screen_x
        BRA     CSREXI
.WORDXX
        PLA
        PLA
        RTS
.EASYRT
        JSR     cursor_right
        JSR     screen_update
        BRA     CSREXI
.WORDLT
        LDA     screen_x
        BNE     cursor_left
        JSR     cursor_up
        BCS     WORDXX
        JSR     screen_update
.cursor_line_end
        LDA     current_line_len
        STA     screen_x
.CSREXI
        STZ     update_required
        RTS
.cursor_right
        LDA     screen_x
        CMP     page_width
        BEQ     CURRCO
        INC     screen_x
        BRA     CSREXI
.CURRCO
        JSR     ENDTEST
        BCS     CSREXI
        STZ     screen_x
        ; C set if at text end
.cursor_down
        JSR     ENDTEST
        BCS     CSREXI
        LDA     #1
        JSR     move_lines_forward
        LDA     screen_y
        CMP     bottom_scroll_margin
        BCS     CUDOSC
        INC     screen_y
        BRA     CSREXI
.CUDOSC
        ; In Bottom Scroll Margin.
        ; If more than (Pagelength-Bottom Scroll Margin)
        ; from bottom of file, then assign Scroll Pointer, else set scroll_ptr+1 to
        ; 0 to indicate wipe_line required.

        STZ     scroll_ptr+1  ; Initialize scroll_ptr+1 to 0 implies
                              ; blank line required for scroll.
        SEC
        LDA     page_length
        SBC     bottom_scroll_margin
        JSR     TPGEFD
        LDA     count
        BNE     CUDOWS
        LDA     text_ptr
        STA     scroll_ptr
        LDA     text_ptr+1
        STA     scroll_ptr+1
.CUDOWS
        LDA     #hardup
        STA     update_required
        CLC
.WORDRX
        RTS
.WORDRIGHT
        LDA     current_line_len
        CMP     screen_x
        BCS     WORDR3
        STA     screen_x
        BRA     WORDR3
.WORDR1
        JSR     WORDRT
.WORDR3
        LDY     screen_x
        LDA     (gap_end),Y
        JSR     is_word_char
        BCC     WORDR1
.WORDR2
        LDY     screen_x
        LDA     (gap_end),Y
        JSR     is_word_char
        BCC     WORDRX
        JSR     WORDRT
        BRA     WORDR2
.WORDL1
        JSR     WORDLT
        LDY     screen_x
        LDA     (gap_end),Y
        JSR     is_word_char
        BCC     WORDL1
.WORDL2
        LDY     screen_x
        LDA     (gap_end),Y
        JSR     is_word_char
        BCC     cursor_right
        JSR     WORDLT
        BRA     WORDL2
.WORDLEFT
        LDA     current_line_len
        CMP     screen_x
        BCS     WORDL1
        STA     screen_x
.WORDCX
        SEC
        RTS
        ; C set if not is_word_char
.is_word_char
        CMP     #'0'
        BCC     WORDCX
        CMP     #'9' + 1
        BCC     WORDCR
        AND     #&DF
        CMP     #'A'
        BCC     WORDCX
        CMP     #'Z' + 1
.WORDCR
        RTS
