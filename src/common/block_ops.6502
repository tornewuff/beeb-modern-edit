.delete_marked
    JSR CLRMARKS
    JSR NMBLOK
    BEQ BADMARKING         ;Stop delete from defaulting to 'NEW' !
    STX gap_end
    STY gap_end+1
    JSR set_modified
.normalize_x
    JSR NORMALIZE
    LDA string
    STA screen_x
    RTS
.copy_marked
    ;Marked copy. Either m-m-c or c-m-m.
    JSR MVBLOK
    ;XY =       (Mark2-Mark1) - size of block to be copied.
    SEC
    LDA used_marks_lo + 1
    SBC used_marks_lo
    TAX
    LDA used_marks_hi + 1
    SBC used_marks_hi
    TAY
    LDA marks_before_cursor
    BEQ MKCPYO
    STX string
    STY string + 1
    SEC
    LDA set_marks_lo
    SBC string
    STA set_marks_lo
    LDA set_marks_hi
    SBC string + 1
    STA set_marks_hi
    LDA set_marks_lo + 1
    SBC string
    STA set_marks_lo + 1
    LDA set_marks_hi + 1
    SBC string + 1
    STA set_marks_hi + 1
.MKCPYO
    JSR check_room
    ;Copy the block, then normalize text.
    LDA used_marks_lo
    STA src_ptr
    LDA used_marks_hi
    STA src_ptr + 1
    STX gap_end
    STX dst_ptr
    STY gap_end + 1
    STY dst_ptr + 1
    JSR CPFD2
    LDX #1
    STX modified
    INX
    STX num_marks_set
    JSR update_status_line
    JMP NORMALIZE
.move_marked
    ;If marks are before cursor, then do a bit of tweaking to
    ;change it into case where thay are after it.
    JSR MVBLOK
    ;Initialize pointers for iterative swap block routine.
    LDX used_marks_lo
    LDY used_marks_hi
    LDA marks_before_cursor
    BEQ MVBEFC
    STX src_ptr
    STY src_ptr + 1
    LDA used_marks_lo + 1
    STA dst_ptr
    LDA used_marks_hi + 1
    STA dst_ptr + 1
    LDX gap_start
    LDY gap_start + 1
    BRA MVSTP3
.MVBEFC
    STX dst_ptr
    STY dst_ptr + 1
    LDA gap_end
    STA src_ptr
    LDA gap_end + 1
    STA src_ptr + 1
    LDX used_marks_lo + 1
    LDY used_marks_hi + 1
.MVSTP3
    STX block_end
    STY block_end + 1
.MVLOOP
    SEC
    LDA dst_ptr
    SBC src_ptr
    STA size
    LDA dst_ptr + 1
    SBC src_ptr + 1
    STA size + 1
    LDA block_end
    SBC dst_ptr
    TAX
    LDA block_end + 1
    SBC dst_ptr + 1
    TAY
    CPX size
    SBC size + 1
    BCS MV2GE
    STX size
    STY size + 1
.MV2GE
    LDA size
    ORA size + 1
    BEQ MVNORM
    BCS MV2GE1
    LDX dst_ptr
    LDY dst_ptr + 1
    JSR MVSWAPBYTES
    CLC
    TYA
    ADC temp
    STA src_ptr
    LDA #null
    ADC temp + 1
    STA src_ptr + 1
    BCC MVLOOP
.MV2GE1
    SEC
    LDA block_end
    SBC size
    STA block_end
    TAX
    LDA block_end + 1
    SBC size + 1
    STA block_end + 1
    TAY
    JSR MVSWAPBYTES
    BRA MVLOOP
.MVNORM
    LDA #fullscreen
    STA update_required
    JSR NORMALIZE
    JMP set_modified
.MVSWAPBYTES
    ;Swap size bytes src_ptr <-> XY
    LDA src_ptr
    STA temp
    LDA src_ptr + 1
    STA temp + 1
    STX addr
    STY addr + 1
    INC size + 1         ;To allow dec to zero below.
    LDY #null
.MVNINC
    CPY size
    BNE MVSWLP
    DEC size + 1
    BEQ TEMPSE
.MVSWLP
    LDA (temp),Y
    TAX
    LDA (addr),Y
    STA (temp),Y
    TXA
    STA (addr),Y
    INY
    BNE MVNINC
    INC temp + 1
    INC addr + 1
    BRA MVNINC
.clamp_screen_x
    LDA screen_x
    STA line
    LDA current_line_len
    CMP screen_x
    BCS TEMPSE
    STA screen_x
.TEMPSE
    RTS
