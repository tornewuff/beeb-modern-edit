.cursor_on
        LDY     #1
        BRA     VDU231
.cursor_off
        LDY     #0
.VDU231
        LDX     #1
.VDU23
        ; Entry - X = 1st byte, Y = 2nd byte
        ; Exit  - VDU 23,X,Y,0,0,0,0,0,0,0 Output.

        LDA     #23
IF edit150_size_opt
        JSR     vdu_axy
        LDX     #8
        LDA     #0
.@      JSR     oswrch
        DEX
        BNE     @-
ELSE
        JSR     oswrch
        TXA
        JSR     oswrch
        TYA
        JSR     oswrch
        JSR     print_inline
        EQUB    &00,&00,&00,&00,&00,&00,&00,&EA
ENDIF
.VDU23X
        RTS
