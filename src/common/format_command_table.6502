        IF cF8key AND NOT(edit150)
                                ; before printing, defaults are copied
                                ; into private workspace buffer
                                ; and nulls replaced with 'line_terminator'

.defhdr
        EQUB    dhtext

.defftr
        EQUB    dftext

        ELIF edit150
        ; in EDIT08 for 1.50r
        ELSE
.defhdr
        EQUB    ".he",termin
        EQUB    ".en",termin
.defftr
        EQUB    ".fo",termin
        EQUB    ".ce",termin
        EQUB    "Page .r0",termin
        EQUB    ".ff.en",termin
        ENDIF
