        IF cF8key=1 AND edit150
        ; ------------------------------------------------------------ ;

.cf8swt                         ; CR/LF switch
        LDA     clterm
        EOR     #cr EOR lf      ; swap between CR and LF
        STA     clterm
        STA     (paje)
        STA     (tmax)
        LDA     #bit6           ; and remember the choice in CMOS RAM
        JSR     togmod
        JSR     stFILE          ; move the cursor to the top
                                ; of the text
        JMP     status

        ; ------------------------------------------------------------ ;
        ENDIF
.crtogg
        LDA     #&20
        IF edit150
.togmod                         ; toggle the bits in A in tutmode
        ENDIF
        EOR     tutmode
.doMODE
        STA     tutmode
        PHX
        PHY
        TAY
        LDA     #162
        LDX     #8
        JSR     osbyte
        PLY
        PLX
        RTS
.TESTIF
        LDA     #&10
        BIT     tutmode
        RTS
