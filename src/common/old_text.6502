        LDA     oldsta + 1
        CMP     paje + 1
        BCC     NOOLD
        LDA     oldsta
        STA     argP
        LDA     oldsta + 1
        STA     argP + 1
        SEC
        LDA     oldsta + 2
        SBC     argP
        TAX
        LDA     oldsta + 3
        SBC     argP + 1
        TAY
        BCC     NOOLD
        LDA     tstart
        STA     varp
        LDA     tstart + 1
        STA     varp + 1
        PHY
        PHX
