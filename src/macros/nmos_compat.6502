; Compatibility macros to write code that works for CMOS or NMOS.

IF build.cmos_host
    MACRO PHX_COMPAT : PHX : ENDMACRO
    MACRO PHY_COMPAT : PHY : ENDMACRO
    MACRO PLX_COMPAT : PLX : ENDMACRO
    MACRO PLY_COMPAT : PLY : ENDMACRO
ELSE
    MACRO PHX_COMPAT : TXA : PHA : ENDMACRO
    MACRO PHY_COMPAT : TYA : PHA : ENDMACRO
    MACRO PLX_COMPAT : PLA : TAX : ENDMACRO
    MACRO PLY_COMPAT : PLA : TAY : ENDMACRO
ENDIF
