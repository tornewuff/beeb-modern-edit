        ;                               > EDIT05
.ROUTNE
        JSR     GETNO
        CMP     lineot
        BEQ     OKAY
        BCC     OKAY
.ROUTBP
        LDA     lineot
        BRA     ALINES
.ROUTNJ
        STA     fill
.OKAY
        RTS
.ROUTNN
        STA     linfed
        RTS
.ROUTOP
        JSR     ROUTBP
        LDA     page
        LSR     A
        BCC     ROUTOP
        RTS
.ROUTOS
        CLC
        JSR     YADP
        LDX     addr
        LDY     addr+1
        JSR     oscli
        LDY     #0
        JMP     ROUTCO
.ROUTPL
        LDX     lineDW
        JSR     MODNO
        TXA
        BEQ     WZERO
        STA     lineDW
        LDX     lineot
        INX
        BEQ     WZERO
        STA     lineot
.WZERO
        RTS
.ROUTPO
        LDX     offset
        JSR     MODNO
        STA     offset
        RTS
.ROUTRF
        STA     rflush
        CLR     centre        ; can't have both
        RTS
.ROUTSP
        JSR     GETNO
.ALINES
        TAX
        BEQ     ALINEX
        PHY
        CMP     #&FF
        BNE     ALINEL
        JSR     DOHDR
        LDX     lineot
.ALINEL
        LDA     lineot
        INA
        BNE     ALINET
        PHX
        JSR     DOHDR
        PLX
.ALINET

        LDA     #cr             ; ++++
        JSR     oswrch
        JSR     lfwrch

        DEX
        BNE     ALINEL
        PLY
.ALINEX
        RTS
.ROUTSS
        LDA     #1
        STA     vspace
        RTS
.ROUTTA
        CLR     LASTTAB
.SETTAB
        JSR     GETNO
        LDX     LASTTAB
        STA     tablst,X
        CLR     tablst+1,X
        INC     LASTTAB
        JSR     SPACEY
        CMP     #','
        BEQ     SETTAB
        DEY
        RTS
.ROUTTC
        LDA     (addr),Y
        STA     tabcha
        INY
        RTS
.ROUTTI
        LDX     tinden
        CPX     #&FF
        BNE     ROUSTI
        LDX     indent        ; if no temp indent then use indent as base
.ROUSTI
        JSR     MODNO
        STX     tinden
        RTS
.ROUTTR
        LDA     (addr),Y
        IF cF8key=1
        CMP     clterm
        ELSE
        CMP     #termin
        ENDIF
        BEQ     SETTRX
        TAX
        INY
        LDA     (addr),Y
        DEY
        IF cF8key=1
        CMP     clterm
        ELSE
        CMP     #termin
        ENDIF
        BEQ     SETTRX
        INY
        INY
        STA     trnlst,X
.SETTRX
        RTS
.ROUTUL
        STA     underl
        STA     undrrq
        RTS
.YADP
        TYA
        ADC     addr
        STA     addr
        BCC     ENDADD
        INC     addr+1
.ENDADD
        RTS
.MODNO
        JSR     SPACEY
        CMP     #'-'
        BEQ     SUBNO
        CMP     #'+'
        BEQ     ADDNO
        DEY
        LDX     #0
.ADDNO
        PHX
        JSR     GETNO
        PLX
        CLC
        STX     temp
        ADC     temp
        BCC     ADDNOX
        LDA     #0
.ADDNOX
        TAX
        RTS
.SUBNO
        PHX
        JSR     GETNO
        STA     temp
        PLA
        SEC
        SBC     temp
        BCS     ADDNOX
        LDA     #0
        TAX
        RTS
.GETNO
        LDX     #0
        JSR     SPACEY
        DEY
.NUMLOP
        LDA     (addr),Y
        CMP     #'0'
        BCC     ENDNO
        CMP     #&3A
        BCS     ENDNUM        ; not a decimal digit
        AND     #&0F
        PHA
        TXA
        ASL     A
        ASL     A
        STA     temp
        TXA
        CLC
        ADC     temp
        ASL     A
        STA     temp
        PLA
        CLC
        ADC     temp
        TAX
        INY
        BRA     NUMLOP
.ENDNUM
        CLC
.ENDNO
        TXA
        RTS
.DOHDR
        LDX     pageeh
        LDY     pageeh+1
        LDA     page
        LSR     A
        BCC     DOHDR1
        LDX     pageoh
        LDY     pageoh+1
.DOHDR1
        DEC     lineot
        JSR     macro
        LDA     lineDW
        STA     lineot
        LDA     #1
        STA     lineno
        LDA     #15
        TRB     lineno+1; leave format alone!
        RTS
.macro
        LDA     addr
        PHA
        LDA     addr+1
        PHA
        LDA     ctlcha
        PHA
        LDA     len
        PHA
        LDA     indent
        PHA
        LDA     tinden
        PHA
        LDA     bold
        PHA
        LDA     pbold
        PHA
        LDA     boldrq
        PHA
        LDA     underl
        PHA
        LDA     pundrl
        PHA
        LDA     undrrq
        PHA
        LDA     fill
        PHA
        LDA     vspace
        PHA
        LDA     centre
        PHA
        LDA     rflush
        PHA
        LDA     linfed
        PHA
        CLR     linfed
        CLR     fill
        CLR     pbold
        CLR     pundrl
        CLR     indent
        LDA     #1
        STA     vspace
        STX     addr
        STY     addr+1
        LDA     (addr)
        STA     ctlcha
        LDY     #3
        CLC
        JSR     YADP; skip definition
        JSR     fine
        PLA
        STA     linfed
        PLA
        STA     rflush
        PLA
        STA     centre
        PLA
        STA     vspace
        PLA
        STA     fill
        PLA
        STA     undrrq
        PLA
        STA     pundrl
        PLA
        STA     underl
        PLA
        STA     boldrq
        PLA
        STA     pbold
        PLA
        STA     bold
        PLA
        STA     tinden
        PLA
        STA     indent
        PLA
        STA     len
        PLA
        STA     ctlcha
        PLA
        STA     addr+1
        PLA
        STA     addr
        RTS
.VDUBIT
        TAY
        LDA     trnlst,Y
        STA     scratch
        JSR     XYSCRATCH
        LDA     #10
        JMP     osword
.DOVDU
        BIT     bold
        BPL     VDUNBL
; bold character
        PHY
        PHX
        JSR     VDUBIT
        LDX     #7
.VDUBLD
        LDA     scratch+1,X
        LSR     A
        ORA     scratch+1,X
        STA     scratch+1,X
        DEX
        BPL     VDUBLD
        BIT     underl
        BPL     VDUDON
; both bold and underline
        BRA     VDUUND
.VDUNBL
        BIT     underl
        BPL     WRCHA
; underline character
        PHY
        PHX
        JSR     VDUBIT
.VDUUND
        LDA     scratch+8
        LSR     A
        ROR     A
        ORA     scratch+8
        ROL     A
        EOR     #&FF
        TSB     scratch+8
.VDUDON
        LDA     #23
        JSR     oswrch
        LDA     #32
        JSR     oswrch
        LDX     #1
.VDUPRG
        LDA     scratch,X
        JSR     oswrch
        INX
        CPX     #9
        BNE     VDUPRG
        JSR     vstrng
        EQUB    32,23,32,0,0,0,0,0,0,0,0,&EA
        PLX
        PLY
        RTS
.ESCAP
        LDA     #&7E
        JSR     osbyte
        JMP     DODWN

.fmwrch
        BIT     escflg
        BMI     ESCAP        ; must not go via SENTRY,
                             ; because of marked mode (SWOPCH)
        BIT     doindX
        BMI     DOINDE

        IF cF8key=1
        CMP     clterm
        ELSE
        CMP     #termin       ; changed from CMPIM " "; BCC WRCHA
        ENDIF
        BEQ     wrchen

        BIT     prtflg
        BMI     DOVDU
        BVS     NOULA

        LDA     #' '
        BIT     underl
        BPL     NOULA
        LDA     #'_'
.NOULA
        PHA

        LDA     #&20
        BIT     prtflg
        BNE     NOBBLE
        BIT     bold
        BMI     NOBBLE

        LDA     #' '
        JSR     oswrch
        PLA
        RTS

.NOBBLE
        PLA
.WRCHA
        PHY
        TAY
        LDA     trnlst,Y
        PLY
        IF cF8key=1
.wrch
        JMP     (&020E)
.wrchen
        LDA     #cr
        BRA     wrch
        ELSE
        IF termin=cr
.wrchen
.wrch
        JMP     (&20E)
        ELSE
.wrch
        JMP     (&20E)
.wrchen
        LDA     #cr
        BRA     wrch
        ENDIF
        ENDIF
.DOINDE
        PHY
        TAY
        LDA     trnlst,Y
        LDY     indexH
        BEQ     DOINDF
        JSR     osbput
.DOINDF
        PLY
        RTS

.lfwrch
        BIT     doindX
        BMI     writeX
        LDA     #lf       ; write a real line feed
        INC     lineno
        BNE     fmwrca
        INC     lineno + 1
.fmwrca
        DEC     lineot
        BNE     wrch
        JSR     oswrch
        PHX
        PHY
        LDX     pageef
        LDY     pageef + 1
        LDA     page
        LSR     A
        BCC     doftr1
        LDX     pageof
        LDY     pageof + 1
.doftr1
        DEC     lineot
        DEC     lineot
        JSR     macro
        LDA     #&FF
        STA     lineot        ; set needs header
        INC     page
        BNE     hi
        INC     page + 1
.hi
        PLY
        PLX
.writeX
        RTS
.write
        LDA     #&20
        TSB     prtflg
        LDA     bold
        PHA
        JSR     DOSCRE
        PLA
        STA     bold
        BIT     boldrq
        BPL     writeX
        LDA     #&20
        TRB     prtflg
        JSR     DOSCRE
        LDA     #&20
        TSB     prtflg
        RTS
.DOSCRE
        LDA     offset
        JSR     SCMVTO
        CLR     diff
        LDA     xeff
        BNE     SCREEA
        SEC
        LDA     juslen
        SBC     count
        STA     diff
.SCREEA
        LDA     tinden
        CMP     #&FF
        BNE     SCREEB
        LDA     indent
.SCREEB
        JSR     SCMVTO
        LDA     centre
        BPL     SCREED
        SEC
        LDA     juslen
        INA
        SBC     count
        JSR     MOVE
.SCREED
        BIT     rflush
        BPL     SCREEQ
        SEC
        LDA     juslen
        ADC     #1
        SBC     count
        JSR     SCMVTO
.SCREEQ
        LDY     #0
        LDX     #0
        LDA     spaces
        BEQ     SCREEE
        LSR     A
        STA     l
        LDA     #0
        BIT     fill
        BMI     SENA
        LDA     diff
.SENA
        LDX     #1
.DODIV
        CMP     spaces
        BCC     DONDIV
        INX
        SBC     spaces
        BCS     DODIV
.DONDIV
        STX     Q
        STA     diff
        LDX     #0
.SCREEE
        JSR     CHKCTL

        CMP     #cr             ; ++++
        BEQ     screeG

        CMP     tabcha
        BNE     SCREES
        TXA
        LDX     #&FF
.SCRTAB
        INX
        PHA
        LDA     tablst,X
        BEQ     SCRNTB
        PLA
        CMP     tablst,X
        BCS     SCRTAB
        SEC
        SBC     tablst,X
        EOR     #&FF
        INA
        PHX
        JSR     SCMVTO
        PLX
        LDA     tablst,X
        TAX
        DEX
        BRA     NOUL
.SCRNTB
        PLX
        LDA     #' '
.SCREES
        CMP     #' '
        BNE     SCREEF
        CPX     LASTTAB
        BCC     SCREEF
        PHX
        LDX     Q
.SCRJUS
        DEX
        BEQ     NOMOV
        LDA     #' '
        JSR     fmwrch
        BRA     SCRJUS
.NOMOV
        PLX
        SEC
        LDA     l
        SBC     diff
        STA     l
        BCS     ENDJUS
        ADC     spaces
        STA     l
        LDA     #' '
        JSR     fmwrch
.ENDJUS
        LDA     #' '
.SCREEF
        JSR     fmwrch
.NOUL
        INY
        INX
        CPX     count
        BCC     SCREEE

        LDA     #cr             ; ++++
.screeG
        JMP     fmwrch

.closeX
        LDY     indexH
        BEQ     closee
        CLR     indexH
        LDA     #&00
        JSR     osfind        ; close index file
.closee
        RTS

.SCMVTO
        ASL     A
.MOVE
        LSR     A
        BEQ     MOVEX
        TAX
        LDA     #9
        BIT     prtflg
        BMI     MLOOP
        LDA     #' '
.MLOOP
        BIT     doindX
        BPL     MLOOPA
        LDA     #' '
        JSR     DOINDE
        BRA     MLOOPB
.MLOOPA
        JSR     oswrch
.MLOOPB
        DEX
        BNE     MLOOP
.MOVEX
        RTS
.inkeys
        JSR     strimo
        EQUB    "Press SHIFT to continue",&EA
.INKEY
        PHX
        PHY
.INKEYL
        JSR     escTST
        LDX     #&FF
        LDY     #&FF
        LDA     #&81
        JSR     osbyte
        CPX     #&FF
        BNE     INKEYL
        LDA     #15
        LDX     #&FF
        JSR     osbyte
        PLY
        PLX
        RTS
.DECCON
        PHX            ; reg in A to print buff. INX by # chars
        PHY
        AND     #15
        ASL     A
        TAX
        LDA     noregs,X
        STA     temp
        LDA     noregs+1,X
        TAX
        AND     #15
        STA     temp+1
        ORA     temp
        PHP
        TXA
        LSR     A
        LSR     A
        LSR     A
        LSR     A
        PLP
        BNE     NMLTST
        CMP     #8
        BCC     DECANY
        LDA     #0
        BRA     DECANY
.NMLTST
        CMP     #8
        BCS     ROMAN
.DECANY
        PHA
        LDX     #4
        LDA     #'0'
        STA     buff+5
        STA     buff+6
        STA     buff+7
.NUMLAP
        LDA     #'0'
        STA     buff,X
        SEC
.NUMLP
        LDA     temp
        SBC     WOPTBL,X
        TAY
        LDA     temp+1
        SBC     WOPTBH,X
        BCC     OUTNUM
        STY     temp
        STA     temp+1
        INC     buff,X
        BNE     NUMLP
.OUTNUM
        DEX
        BPL     NUMLAP
        PLA
        STA     temp
        LDX     #8
.LZB
        DEX
        CPX     temp
        BEQ     LASTZ
        LDA     buff,X
        AND     #15
        BEQ     LZB
.LASTZ
        STX     temp
        PLY
        PLA
        SEC
        ADC     temp
        TAX
        RTS
.ROMAN
        PHA
        CMP     #10
        BCS     AAA
        LDA     #&FF
        PHA
        LDX     #12
.ROMANL
        SEC
        LDA     temp
        SBC     NUMERL,X
        TAY
        LDA     temp+1
        SBC     NUMERH,X
        BCC     ROMANO
        STY     temp
        STA     temp+1
        TXA
        ASL     A
        TAY
        LDA     chars,Y
        PHA
        LDA     chars+1,Y
        CMP     #' '
        BEQ     ROMANL
        PHA
        BRA     ROMANL
.ROMANO
        DEX
        BPL     ROMANL
.ROMANG
        PLA
        INX
        STA     buff,X
        CMP     #&FF
        BNE     ROMANG
        DEX
.CASECH
        PLA
        AND     #1
        BEQ     LASTZ
        STX     temp
.CASELP
        LDA     buff,X
        ORA     #&20
        STA     buff,X
        DEX
        BPL     CASELP
        LDX     temp
        BRA     LASTZ
.AAA
        LDA     temp
        BNE     AAADEC
        DEC     temp+1
.AAADEC
        DEC     temp
        LDY     #0
.AAALOP
        LDA     temp
        SEC
.AAALOQ
        INY
        SBC     #26
        BCS     AAALOQ
        STA     temp
        LDA     temp+1
        BEQ     AAAGOT
        DEC     temp+1
        BRA     AAALOP
.AAAGOT
        LDA     temp
        ADC     #26+'A'
        LDX     #0
.AAALON
        STA     buff,X
        INX
        DEY
        BNE     AAALON
        DEX
        BRA     CASECH
.NUMERL
        EQUB    LO({1,4,5,9,10,40,50,90,100,400,500,900,1000})
.NUMERH
        EQUB    HI({1,4,5,9,10,40,50,90,100,400,500,900,1000})
.chars
        EQUB    "I IVV IXX XLL XCC CDD DMM "
.CMDS
        EQUB    "af"
        EQUW    ROUTAF
        EQUB    "an"
        EQUW    ROUTAN
        EQUB    "bl"
        EQUW    ROUTBL
        EQUB    "bp"
        EQUW    ROUTBP
        EQUB    "cc"
        EQUW    ROUTCC
        EQUB    "ce"
        EQUW    ROUTCE
        EQUB    "ch"
        EQUW    ROUTCH
        EQUB    "co"
        EQUW    ROUTCO
        EQUB    "dm"
        EQUW    ROUTDM
        EQUB    "ds"
        EQUW    ROUTDS
        EQUB    "ef"
        EQUW    ROUTEF
        EQUB    "eh"
        EQUW    ROUTEH
        EQUB    "en"
        EQUW    ROUTEN
        EQUB    "ep"
        EQUW    ROUTEP
        EQUB    "ff"
        EQUW    ROUTFF
        EQUB    "fo"
        EQUW    ROUTFO
        EQUB    "he"
        EQUW    ROUTHE
        EQUB    "ic"
        EQUW    ROUTIC
        EQUB    "ig"
        EQUW    ROUTIG
        EQUB    "in"
        EQUW    ROUTIN
        EQUB    "io"
        EQUW    ROUTIO
        EQUB    "ix"
        EQUW    ROUTIX
        EQUB    "ju"
        EQUW    ROUTJU
        EQUB    "ll"
        EQUW    ROUTLL
        EQUB    "ls"
        EQUW    ROUTLS
        EQUB    "lv"
        EQUW    ROUTLV
        EQUB    "ne"
        EQUW    ROUTNE
        EQUB    "nj"
        EQUW    ROUTNJ
        EQUB    "nn"
        EQUW    ROUTNN
        EQUB    "of"
        EQUW    ROUTOF
        EQUB    "oh"
        EQUW    ROUTOH
        EQUB    "op"
        EQUW    ROUTOP
        EQUB    "os"
        EQUW    ROUTOS
        EQUB    "pl"
        EQUW    ROUTPL
        EQUB    "po"
        EQUW    ROUTPO
        EQUB    "rf"
        EQUW    ROUTRF
        EQUB    "sp"
        EQUW    ROUTSP
        EQUB    "ss"
        EQUW    ROUTSS
        EQUB    "ta"
        EQUW    ROUTTA
        EQUB    "tc"
        EQUW    ROUTTC
        EQUB    "ti"
        EQUW    ROUTTI
        EQUB    "tr"
        EQUW    ROUTTR
        EQUB    "ul"
        EQUW    ROUTUL
NOCMDS  =       ( * - CMDS )


        IF cF8key=1
                                ; before printing, defaults are copied
                                ; into private workspace buffer
                                ; and nulls replaced with 'clterm'

.defhdr
        EQUB    dhtext

.defftr
        EQUB    dftext

        ELSE
.defhdr
        EQUB    ".he",termin
        EQUB    ".en",termin
.defftr
        EQUB    ".fo",termin
        EQUB    ".ce",termin
        EQUB    "Page .r0",termin
        EQUB    ".ff.en",termin
        ENDIF
