.language_entry {
    CLI
    CLD
    LDX #&FF
    TXS

    ; Remember the OS version, treating anything below MOS 3 as 0
    LDA #osbyte_read_os_version
    LDX #1
    JSR osbyte
    CPX #3
    BCC mos_below_3
    TXA
.mos_below_3
    STA os_version

    LDA #osbyte_read_cmos_ram           ; read CMOS RAM into 'options'
    LDX #&08                    ; our byte
    JSR osbyte
    STY options

    ; Bit 6 of the CMOS byte selects LF rather than CR as the line
    ; terminator
    TYA
    LDY #cr
    AND #bit6
    BEQ set_terminator
    LDY #lf
.set_terminator
    STY line_terminator

    LDA #<brk_handler
    STA BRKv
    LDA #>brk_handler
    STA BRKv + 1
    STZ old_text_bounds + 3
    LDA #&F2
    STA scratch
    STZ scratch + 1
    JSR read_io_byte
    TAX
    JSR read_next_io_byte
    STA scratch + 1
    STX scratch
    LDX #20
.EDITol
    DEX
    BEQ EDITz2

    JSR read_next_io_byte
    CMP #cr
    BEQ EDIToz

    CMP #' '
    BEQ EDITsp
    CMP #'.'
    BNE EDITol

.EDITsp                         ; skip spaces before the filename
    DEX
    BEQ EDIToz
    JSR read_next_io_byte
    CMP #' '
    BEQ EDITsp
    LDX #&00
.EDITgb
    STA &01A0,X
    JSR read_next_io_byte
    INX
    CPX #'@'
    BNE EDITgb
    LDA #cr
    STA &01A0 - 1,X
    STA filename_buffer
    LDY #&00
    JSR read_hex
    BCC EDITon
    CMP #','
    BNE EDITon
    LDA &00,X
    STA old_text_bounds
    LDA &01,X
    STA old_text_bounds + 1
    INY
    JSR read_hex
    BCC EDITon
    CMP #cr
    BNE EDITon
    LDA &00,X
    STA old_text_bounds + 2
    LDA &01,X
    STA old_text_bounds + 3
    STZ cursor_editing
    BRA EDIToy
.EDITon
    LDX #&00
    LDA &01A0
    CMP #cr
.EDITz2
    BEQ EDIToz
.EDITn2
    LDA &01A0,X
    CMP #cr
    BEQ EDITn3
    CMP #' '
    BCC EDIToz
    CMP #delete
    BCS EDIToz

.EDITn3
    STA filename_buffer,X
    INX
    CMP #cr
    BNE EDITn2
    LDA #&01
    STA cursor_editing
    BRA EDIToy

.EDIToz
    LDX #&FF
    STX cursor_editing
    LDA #cr
    STA filename_buffer

    LDA line_terminator         ; current line terminator
    CMP (oshwm)
    BNE EDIToy
    CMP (text_end)
    BNE EDIToy
    JSR save_text_bounds

.EDIToy
    LDA #cr
    STA find_replace_buffer
    STA global_replace_buffer
    STZ index_handle
    STZ modified
    LDA #3                      ; characters are now defined when needed
    JSR oswrch

    LDA cursor_editing
    BEQ zippo
    DEA
    BEQ zappo
    JMP EDIT            ; and away we go...
.zippo
    JSR setup_editor
    JMP OLDTEXT

.zappo
    STZ brk_action              ; brk_action.continue_editing
    JSR setup_editor
    JSR clear_buffer
    LDY #&00
    LDA #<filename_buffer
    STA temp
    LDA #>filename_buffer
    STA temp + 1
    JSR load_text
    JMP EDITgt
}
