; Various help text is compressed with a simple abbreviation dictionary.
; Bytes &80 to &9F expand to entry n - &80 of the zero terminated entries in
; abbreviation_data, which may contain further abbreviations.
.compressed_text {

; Decompress and print inline text
.print_inline
    PLA
    STA compressed_string
    PLA
    STA compressed_string + 1
    JSR increment
    JMP (compressed_string)

.@  JSR print_byte
.increment
    INC compressed_string
    BNE print_string
    INC compressed_string + 1
; Decompress and print text at (compressed_string)
.print_string
    LDA (compressed_string)
    CMP #&EA
    BNE @-
    RTS

; print a character or abbreviation
.print_byte {
    CMP #&A0
    BCS ascii
    CMP #&80
    BCS abbreviation
.ascii
    JMP osasci

.abbreviation
    PHY
    PHX
    LDY #&FF
    EOR #&80
    TAX
    BEQ print_entry
.skip_x_entries
    INY
    LDA abbreviation_data,Y
    BNE skip_x_entries
    DEX
    BNE skip_x_entries
.print_entry
    INY
    LDA abbreviation_data,Y
    BEQ return
    JSR print_byte
    BRA print_entry
.return
    PLX
    PLY
    RTS
}

.abbreviation_data {
    ; Null-terminate the entries from abbreviation_list
    EQUB ZIP(abbreviation_list, REPEATED(LEN(abbreviation_list), 0))
}

}
