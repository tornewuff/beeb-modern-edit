; Build configuration based on HiEdit 1.24 but using every non-default config
; option, just to verify that it builds.

.build {
IF DEFINED(build_disc)
    filename = "HIEDTND"
ELSE
    filename = "nondefault.rom"
ENDIF
    relocation_model = "tube"
    relocation_address = &b800
    cmos_host = FALSE
}

.metadata {
    title = "Edit"
    copyright = "1984 Acorn"
    copyright_year = "1984"
    version_byte = &02
    version_str = "1.24"
}

.setconfig {
    phil = TRUE
    mouse = TRUE
    lerror = FALSE
    define_fancy_chars = "never"
    fancy_chars_at_80 = FALSE       ; required for "never"
    syzygy = FALSE
    stamp = TRUE
    lfver = TRUE
    cF8key = FALSE
    curtyp = FALSE
    lfarro = FALSE
    extgf = TRUE
    edit150 = FALSE                 ; not useful to test edit150
    edit150_size_opt = TRUE
    help_text = "original"
    compressed_help_text = TRUE
    omit_service = TRUE
}


INCLUDE "main.6502"
