        ;       EDIT text editor        > EDIT01

        ; ------------------------------------------------------------ ;

.origin
.pasROM
        JMP     language
        IF reladd=0
        JMP     servic
        ELSE
        JMP     servic - origin + &8000
        ENDIF

        IF reladd=0
        EQUB    &C2                     ; Type flag
        ELSE
        EQUB    &E2                     ; relocation address provided
        ENDIF

        EQUB    copyri - pasROM
        EQUB    &02
        EQUB    "Edit"
        EQUB    null
        EQUB    vers
.copyri
        EQUB    null
        EQUB    "(C)1984 Acorn"
        EQUB    null

        IF reladd=1
        EQUW    reladr                  ; relocation value
        EQUW    &0000                   ; Top 2 bytes
        ENDIF

.ROM1br
        ;Outputs 'brk' error message, & jumps to relevant re-entry
        ;point. Detailed action depends on value of 'brkaction' on entry -
        ; brkaction = 0 Moves cursor to editor status position,
        ; outputs error message, then prompts for space
        ; before jumping to EDITcont.
        ; 1    Outputs error message, and jumps to starloop.
        ; 2    resets to start of file and closes indexfile, then as 0

        LDX     #&FF
        TXS
        STZ     cursED
        LDA     #&7E
        JSR     osbyte
        LDA     brkaction
        CMP     #&FF
        BNE     simBRK
.unret
        LDA     addr
        BNE     unretA
        DEC     addr + 1
.unretA
        DEC     addr
        LDA     argP
        BNE     unretB
        DEC     argP + 1
.unretB
        DEC     argP
        LDA     (argP)
        STA     (addr)
        LDA     addr
        BNE     unret
        LDA     addr + 1
        CMP     string + 1
        BNE     unret
        LDA     #cr
        STA     (tmax)
        LDA     #&00
.simBRK
        CMP     #&01
        BNE     simBK2
        JSR     supvBR
        JMP     starCN
.simBK2
        BCC     norBRK
        JSR     closeX
        JSR     stFILE
.norBRK
        JSR     vstrng
        EQUB    &03,&0F,&EA
        JSR     CSR0STATUSY

        IF lerror=1
        JSR     vstrng
        EQUB    &0B,&0B,&0B,remap("┌"),&EA
        LDX     #remapchar("─")
        LDA     #59-80
        JSR     BRKsub
        EQUB    remap("Shift f5 D for info┐│"),&EA
        LDX     #' '
        LDA     #78-80
        JSR     BRKsub
        EQUB    remap("│└"),&EA
        LDX     #remapchar("─")
        LDA     #54-80
        JSR     BRKsub
        EQUB    remap("Press ESCAPE to continue┘"),11,11,9,&EA
        JSR     BRKoy
        ELSE
        JSR     supvBR
        JSR     curOFF
        LDA     tutmode
        AND     #&07
        CMP     #&05
        BEQ     nomess
        LDA     (&FD)
        CMP     #&01
        BNE     nomess
        JSR     vstrng
        IF 1=0
        EQUB    lf,cr,"For help type: shf-f5 D",&EA
        ELSE
        EQUB    lf,cr,"Shift f5 D for info",&EA ; Slightly shorter
        ENDIF
.nomess
        JSR     osnewl
        JSR     strimo
        EQUB    "Press ESCAPE to continue",&EA
        ENDIF

.esclop
        JSR     osrdch
        CMP     #&1B
        BNE     esclop
.escCON
        LDA     #&7E
        JSR     osbyte
        JSR     NORMALIZE
        JMP     EDITcont
.supvBR
        JSR     osnewl
.BRKoy
        LDY     #&01
.BRKOLP
        LDA     (&FD),Y
        BEQ     BRKOX
        JSR     osasci
        INY
        BNE     BRKOLP
.BRKOX
        RTS

        ; ------------------------------------------------------------ ;

.servic ; Recognise *help and *edit

        IF mouse = 0
        CMP     #&04
        BEQ     unknow
        CMP     #&09
        BNE     servex

        ; *HELP response

        LDA     (&F2),Y
        CMP     #cr
        BNE     helpEX  ; don't say anything unless there are no keywords

        IF reladd=0
        PHY
        ELSE
        TYA             ; When relocated for TUBEs then non-CMOS codes
        PHA
        ENDIF

        LDY     #helpen - helpin - 1
.helpLO
        IF reladd=0
        LDA     helpin,Y        ; Must always be assembled for &8000
        ELSE                    ; on relocated versions
        LDA     helpin - reladr + &8000,Y
        ENDIF
        JSR     osasci
        DEY
        BPL     helpLO

        IF reladd=0
        PLY
        ELSE
        PLA
        TAY
        ENDIF
.helpEX
        LDA     #&09
.servex
        RTS
.helpin
        EQUB    cr,"5 TIDE",cr
.helpen

.unknow
        ; Recognise *edit as command to enter language.

        IF reladd=0
        PHY
        PHX
        ELSE
        TYA
        PHA
        TXA
        PHA
        ENDIF

        LDX     #&03
.ucomLO
        LDA     (&F2),Y
        CMP     #'.'
        BEQ     ucommi
        AND     #&DF
        IF reladd=0
        CMP     helpen - 5,X    ; Must always be assembled at &8000
        ELSE                    ; on relocated versions
        CMP     helpen - reladr - 5 + &8000,X
        ENDIF
        BNE     ucomEX
        INY
        DEX
        BPL     ucomLO
        LDA     (&F2),Y
        CMP     #space + 1
        BCC     ucommi
.ucomEX
        IF reladd=0
        PLX
        PLY
        ELSE
        PLA
        TAX
        PLA
        TAY
        ENDIF
        LDA     #&04
        RTS
.ucommi
        ; Command recognised - enter self as a language.
        IF reladd=0
        LDA     #&8E
        PLX
        ELSE
        PLA
        TAX
        LDA     #&8E
        ENDIF
        JMP     osbyte
        ENDIF
        ; ------------------------------------------------------------ ;

.language                       ; Language entry point
        CLI
        CLD
        LDX     #&FF
        TXS
        LDA     #<ROM1br
        STA     BRKv
        LDA     #>ROM1br
        STA     BRKv + 1
        STZ     oldsta + 3
        LDA     #&F2
        STA     scratch
        STZ     scratch + 1
        JSR     readby
        TAX
        JSR     readnx
        STA     scratch + 1
        STX     scratch
        LDX     #20
.EDITol
        DEX
        BEQ     EDIToz

        JSR     readby
        JSR     readne
        CMP     #cr
        BEQ     EDIToz

        CMP     #' '
        BNE     EDITol
        LDX     #&00
.EDITgb
        JSR     readby
        JSR     readne
        STA     &01A0,X
        INX
        CPX     #'@'
        BNE     EDITgb
        LDA     #cr
        STA     &01A0 - 1,X
        STA     nambuf
        LDY     #&00
        JSR     readHX
        BCC     EDITon
        CMP     #','
        BNE     EDITon
        LDA     &00,X
        STA     oldsta
        LDA     &01,X
        STA     oldsta + 1
        INY
        JSR     readHX
        BCC     EDITon
        CMP     #cr
        BNE     EDITon
        LDA     &00,X
        STA     oldsta + 2
        LDA     &01,X
        STA     oldsta + 3
        STZ     cursED
        BRA     EDIToy
.EDITon
        LDX     #&FF
.EDITn1
        INX
        LDA     &01A0,X
        CMP     #' '
        BEQ     EDITn1
        CMP     #cr
        BEQ     EDIToz
.EDITn2
        LDA     &01A0,X
        CMP     #cr
        BEQ     EDITn3
        CMP     #' '
        BCC     EDIToz
        CMP     #delete
        BCS     EDIToz

.EDITn3
        STA     nambuf,X
        INX
        CMP     #cr
        BNE     EDITn2
        LDA     #&01
        STA     cursED
        BRA     EDIToy

.EDIToz
        LDX     #&FF
        STX     cursED
        LDA     #cr
        STA     nambuf

        IF cF8key=1
        LDA     clterm          ; current line terminator
        ELSE
        IF termin<>cr
        LDA     #termin
        ENDIF
        ENDIF

        CMP     (paje)
        BNE     EDIToy
        CMP     (tmax)
        BNE     EDIToy
        JSR     MEMSTATE

.EDIToy
        LDA     #161            ; read CMOS RAM into 'tutmode'
        LDX     #&08            ; our byte
        LDY     #&10            ; ???
        JSR     osbyte
        STY     tutmode         ; returns &00 on the BBC OS 1.2

        IF mouse=1
        JSR     mouser
        ENDIF

        LDA     #cr
        STA     frbuff
        STA     grbuff
        IF cF8key=1
        STA     clterm          ; initialise 'clterm' here
        ENDIF
        STZ     indexH
        STZ     modflg
        JSR     vstrng          ; define characters

        EQUB    3
        EQUB    23,remap("─"),&00,&00,&00,&FF,&00,&00,&00,&00
        EQUB    23,remap("│"),&18,&18,&18,&18,&18,&18,&18,&18

        IF dchars=1      ; Character definitions for descriptive MODE
        EQUB    23,remap("┌"),&00,&00,&00,&07,&0C,&18,&18,&18
        EQUB    23,remap("┐"),&00,&00,&00,&E0,&30,&18,&18,&18
        EQUB    23,remap("└"),&18,&18,&0C,&07,&00,&00,&00,&00
        EQUB    23,remap("┘"),&18,&18,&30,&E0,&00,&00,&00,&00
        EQUB    23,remap("©"),&7E,&C3,&9D,&B1,&9D,&C3,&7E,&00
        EQUB    23,remap("⯇"),&00,&18,&38,&7F,&38,&18,&00,&00
        EQUB    23,remap("⯈"),&00,&18,&1C,&FE,&1C,&18,&00,&00
        EQUB    23,remap("⭣"),&18,&18,&18,&18,&7E,&3C,&18,&00
        EQUB    23,remap("⭡"),&00,&18,&3C,&7E,&18,&18,&18,&18
        EQUB    23,remap("╶"),&00,&00,&00,&1F,&00,&00,&00,&00
        EQUB    23,remap("╴"),&00,&00,&00,&F8,&00,&00,&00,&00
        EQUB    23,remap("┬"),&00,&00,&00,&FF,&18,&18,&18,&18
        EQUB    23,remap("├"),&18,&18,&18,&1F,&18,&18,&18,&18
        EQUB    23,remap("┤"),&18,&18,&18,&F8,&18,&18,&18,&18
        EQUB    23,remap("┴"),&18,&18,&18,&FF,&00,&00,&00,&00
        EQUB    23,remap("┼"),&18,&18,&18,&FF,&18,&18,&18,&18
        ENDIF
        IF lfarro=1
nlfarr  =       &FE
        EQUB    23,nlfarr,&00,&18,&38,&7F,&38,&18,&00,&00
        ENDIF

        EQUB    &EA

        LDA     cursED
        BEQ     zippo
        DEA
        BEQ     zappo
        JMP     EDIT    ; and away we go...
.zippo
        JSR     EDITmd

        IF stamp=1
        JSR      nstamp
        ENDIF

        JMP     OLDTEXT

.zappo
        STZ     brkaction
        JSR     EDITmd
        JSR     EDITi2
        LDY     #&00
        LDA     #<nambuf
        STA     temp
        LDA     #>nambuf
        STA     temp + 1
        JSR     Tload
        JMP     EDITgt

.XYSCRATCH
        ; Load XY with address of scratch.
        LDX     #<scratch
        LDY     #>scratch
        RTS

.readne
        INC     scratch
        BNE     * + 4
        INC     scratch + 1
        RTS

.readHX
        LDX     #0
        STZ     scratch + 5
.tsthex
        LDA     &01A0,Y
        CMP     #'0'
        BCC     hexend
        CMP     #'9' + 1
        BCC     OKhex
        SBC     #&37
        CMP     #10
        BCC     hexend
        CMP     #16
        BCS     hexend
.OKhex
        ASL     scratch + 5
        ASL     scratch + 5
        ASL     scratch + 5
        ASL     scratch + 5
        AND     #&0F
        TSB     scratch + 5
        INY
        INX
        BRA     tsthex
.hexend
        CPX     #&01            ; CC status for not found
        LDX     scratch + 5
        RTS

.readnx
        JSR     readne

.readby
        PHX
        PHY
        JSR     XYSCRATCH
        LDA     #5
        JSR     osword
        PLY
        PLX
        LDA     scratch + 4
        RTS

.paslnm
        SEC
        SBC     addr
        STA     maxsiz
        TXA
        SBC     addr + 1
        STA     maxsiz + 1

.filename
        ; Entry - IY temp points to input name. Exit - scratch -> filename.
        LDA     (temp),Y
        CMP     #cr
        BEQ     textna
        CMP     #&8B
        BEQ     oldnam
        LDX     #&00

.memnam
        LDA     (temp),Y
        STA     nambuf,X
        INY
        INX
        CPX     #52
        BNE     memnam

.oldnam
        LDA     nambuf
        CMP     #cr
        BEQ     nonam
        LDA     #<nambuf
        STA     scratch
        LDA     #>nambuf
        STA     scratch + 1
        RTS

.textna
        LDX     GE
        LDY     GE + 1
        PHX
        PHY
        LDX     tstart
        LDY     tstart + 1
        JSR     GPBKXY
        LDY     #&00

.MVIC
        LDA     (GE),Y
        STA     stracc,Y
        INY
        BNE     MVIC
        PLY
        PLX
        JSR     gpfdXY
        LDY     #&FF
.namsrc
        INY
        BMI     nonam
        LDA     stracc,Y

        IF cF8key=1
        CMP     clterm
        ELSE
        CMP     #termin
        ENDIF

        BEQ     nonam
        CMP     #'>'
        BNE     namsrc
        INY
        STY     scratch
.namsr3
        LDA     stracc,Y

        IF cF8key=1
        CMP     clterm
        ELSE
        CMP     #termin
        ENDIF

        BEQ     namfnd
        INY
        BPL     namsr3
.nonam
        TYA
        BEQ     namsrc
        BRK
        EQUB    &01,"No name found",null

.namfnd

        IF cF8key=1
        LDA     #cr
        STA     stracc,Y
        ELSE
        IF termin<>cr
        LDA     #cr
        STA     stracc,Y
        ENDIF
        ENDIF

        LDA     #>stracc
        STA     scratch + 1
        RTS

.writna
        JSR     STARTINV
        LDY     #&FF
.wrispc
        INY
        LDA     (scratch),Y
        CMP     #' '
        BEQ     wrispc
.wrilop
        LDA     (scratch),Y
        CMP     #' ' + 1
        BCC     wriex
        JSR     oswrch
        INY
        BRA     wrilop
.wriex
        JMP     STOPINV

.Tload
        LDA     tstart
        STA     addr
        LDA     tstart + 1
        STA     addr + 1
        LDA     tmax
        LDX     tmax + 1

        IF stamp=1
        JSR     PASLOAD
        PHX
        PHY
        LDX     #flload
        LDY     #&02
        JSR     frscra
        LDX     #flexec
        JSR     frscra
        PLY
        PLX
        RTS
        ENDIF

.PASLOAD
        ; Entry - IY temp -> name, addr = load address, AX = max free address
        ; Exit - File checked for size (not on slow FS's)
        ; File loaded to addr, with XY = top of file
        JSR     paslnm
        JSR     prompt
        EQUB    "Loading ",&EA
        JSR     writna

.pasGO
        LDY     #&00
        TYA
        JSR     osargs
        CMP     #&04
        BCC     nosize
        ; Using a random access filing system,
        ; so can quickly check size of file.
        LDA     #&05
        JSR     XYSCRATCH
        JSR     osfile
        CMP     #&01
        BNE     nosize          ; Let FS generate 'Directory/not found' error.
        LDA     scratch + &0C
        ORA     scratch + &0D
        BNE     paslhu
        LDA     maxsiz
        CMP     scratch + &0A
        LDA     maxsiz + 1
        SBC     scratch + &0B
        BCC     paslhu

.nosize
        ; Load file to addr, & set XY --> top of loaded file.
        LDA     addr
        STA     scratch + 2
        LDA     addr + 1
        STA     scratch + 3
        STZ     scratch + 4
        STZ     scratch + 5
        STZ     scratch + 6
        LDA     #&FF
        JSR     XYSCRATCH
        JSR     osfile
        STZ     oldsta + 3      ; make old impossible
        CLC
        LDA     addr
        ADC     scratch + &0A
        TAX
        LDA     addr + 1
        ADC     scratch + &0B
        TAY
        RTS

.paslhu
        BRK
        EQUB    &02,"File too big",null

.tSAVE
        ; Save (defaulting) marked block of text.
        ; Entry - (temp),Y points to input name.
        ; GE = Start of block
        ; endp = End of block
        ; Exit - specified memory saved as filename.
        JSR     filename

.inSAVE
        JSR     prompt
        EQUB    "Saving to ",&EA
        JSR     writna
        LDX     #&0F
.pasacl
        STZ     scratch + 2,X
        DEX
        BPL     pasacl

        IF stamp=1
        JSR     dstamp
        LDX     #flload
        LDY     #&02
        JSR     toscra
        LDX     #flexec
        JSR     toscra
        LDX     #GE
        JSR     toscr2
        LDY     #&0E
        LDX     #endp
        JSR     toscr2
        ELSE
        DEC     scratch + 6
        DEC     scratch + 7
        DEC     scratch + 8
        DEC     scratch + 9
        LDA     GE
        STA     scratch + &0A
        LDA     GE + 1
        STA     scratch + &0B
        LDA     endp
        STA     scratch + &0E
        LDA     endp + 1
        STA     scratch + &0F
        ENDIF

        LDA     #&00
        JSR     XYSCRATCH
        JMP     osfile

        IF stamp=1
.toscra
        JSR     toscr2
.toscr2
        JSR     toscr1
.toscr1
        LDA     &00,X
        STA     scratch,Y
        INX
        INY
        RTS

.frscra
        JSR     frscr2
.frscr2
        JSR     frscr1
.frscr1
        LDA     scratch,Y
        STA     &00,X
        INX
        INY
.dstmpX
        RTS

.nstamp
        LDX     #&07
        LDA     #&00
.nstmp1
        STA     flexec,X
        CPX     #&04
        BNE     nstmp2
        LDA     #&FF
.nstmp2
        DEX
        BPL     nstmp1
        RTS
.mstamp
        LDA     #&FF
        STA     flload + 1
        STA     flload + 2
        STA     flload + 3
.dstamp
        LDA     flload + 1
        AND     flload + 2
        AND     flload + 3
        INA
        BNE     dstmpX
        LDX     #flexec
        LDY     #&00
        LDA     #&01
        JMP     osword
        ENDIF

.readns
        ; Reads line to commandline (linbuf), & strips leading &
        ; trailing spaces.
        ; Exit - temp --> 1st non-space char on line
        ; A      = 1st non-space char on line
        ; Y      = 0
        ; EQ if line was 'empty', else NE

        JSR     readLS
        TYA
        BEQ     renSCR
.renSST
        LDA     commandline - 1,Y
        CMP     #space
        BNE     renSCR
        DEY
        BNE     renSST
.renSCR
        LDA     #cr
        STA     commandline,Y
        LDY     #&FF
.renSIG
        INY
        LDA     commandline,Y
        CMP     #space
        BEQ     renSIG
        CLC
.readIM
        TYA
        ADC     #<commandline
        STA     temp
        LDA     #&00
        ADC     #>commandline
        STA     temp + 1
        LDY     #&00
        LDA     (temp)
        CMP     #cr
.escCLR
        RTS

.READINIT
        LDY     #&00
        BRA     readIM

.readLS
        LDA     #' '
        JSR     oswrch

        ; Read line into linbuf/commandline, testing for escape.
        ; Exit - Y = No. of chars read (excluding CR).

        LDA     #thelot
        STA     UPDATEREQD
        JSR     rdlnre
        BCC     escCLR
.escSET
        JSR     vstrng
        EQUB    &03,&0F,&0D,&EA
        LDA     brkaction
        CMP     #&02
        BNE     escSIM
        JSR     closeX
        JSR     stFILE
.escSIM
        STZ     cursED
        JMP     escCON
.escTST
        BIT     &FF
        BMI     escSET
        RTS

.rdlnre
        LDY     #0
.RDLNLP
        JSR     osrdch
        BCS     RDLNEX
        STA     linbuf,Y
        CMP     #&7F
        BNE     RDLN2
        CPY     #0
        BEQ     RDLNLP
        DEY
        JSR     oswrch
        BRA     RDLNLP
.RDLN2
        CMP     #&15
        BNE     RDLN3
.RDLNDL
        TYA
        BEQ     RDLNLP
        LDA     #&7F
        JSR     oswrch
        DEY
        BRA     RDLNDL
.RDLN3
        INY
        CMP     #cr
        BEQ     RDLNEG
        JSR     PASWRCH
        BRA     RDLNLP
.RDLNEG
        PHY
        JSR     curOFF
        PLY
        DEY
        CLC
.RDLNEX
        RTS
.COPYBK
        ; Copy block backwards (i.e. to lower address).
        ; Entry - argP --> block of size XY
        ; varp --> destination address
        STX     size
        STY     size + 1
        LDA     size
        ORA     size + 1
        BEQ     BKEXIT
        LDX     size + 1
        SEC
        LDA     #0
        SBC     size
        TAY
        BEQ     BKLOOP
        STA     temp
        SEC
        LDA     argP
        SBC     temp
        STA     argP
        BCS     CPNHI1
        DEC     argP + 1
        SEC
.CPNHI1
        LDA     varp
        SBC     temp
        STA     varp
        BCS     CPNHI2
        DEC     varp + 1
.CPNHI2
        INX
.BKLOOP
        LDA     (argP),Y
        STA     (varp),Y
        INY
        BNE     BKLOOP
        INC     argP + 1
        INC     varp + 1
        DEX
        BNE     BKLOOP
.BKEXIT
        RTS

.MEMSTATE
        LDA     tstart + 1
        JSR     chkptr
        LDA     GS + 1
        JSR     chkptr
        LDA     GE + 1
        JSR     chkptr
        LDA     tmax + 1
        JSR     chkptr
        LDX     tmax
        LDY     tmax + 1
        JSR     gpfdXY
        LDA     tstart
        STA     oldsta
        LDA     tstart + 1
        STA     oldsta + 1
        LDA     GS
        STA     oldsta + 2
        LDA     GS + 1
        STA     oldsta + 3
        CLC
.CHKPTX
        RTS
.chkptr
        CMP     hymem + 1
        BCS     CHKPTX
        CMP     paje + 1
        BCS     CHKPTX
        PLA
        PLA
        RTS

        IF lerror=1
.BRKsub
        SEC
        ADC     PAGEWIDTH
        TAY
        TXA
.BRKSB1
        JSR     oswrch
        DEY
        BNE     BRKSB1
        ENDIF

.vstrng
        PLA
        STA     string
        PLA
        STA     string + 1
        JSR     VSTRLP
        JMP     (string)
.VSTRLM
        JSR     oswrch
.VSTRLP
        INC     string
        BNE     STRINOT
        INC     string + 1
.STRINOT
        LDA     (string)        ; enter here for normal string
        CMP     #&EA
        BNE     VSTRLM
        RTS
.crtogg
        LDA     #&20
        EOR     tutmode
.doMODE
        STA     tutmode
        PHX
        PHY
        TAY
        LDA     #162
        LDX     #8
        JSR     osbyte
        PLY
        PLX
        RTS
.TESTIF
        LDA     #&10
        BIT     tutmode
        RTS
        IF mouse=1
.mouser
        LDA     mousel
        STA     mousel + 5
        LDA     #&92
        LDX     #<mouswi
        JSR     osbyte
        STY     mousel
        LDX     #<mouxlo
        JSR     osbyte
        PHY
        INX
        JSR     osbyte
        PLA
        AND     #&F8
        PHA
        SBC     mousel + 1
        STA     mousel + 6
        TYA
        SBC     mousel + 2
        STA     mousel + 7
        STY     mousel + 2
        PLA
        STA     mousel + 1
        LDA     #&92
        INX
        JSR     osbyte
        PHY
        INX
        JSR     osbyte
        PLA
        AND     #&F8
        PHA
        SBC     mousel + 3
        STA     mousel + 8
        TYA
        SBC     mousel + 4
        STA     mousel + 9      ; ychange
        STY     mousel + 4
        PLY
        STY     mousel + 3
        RTS
        ENDIF
