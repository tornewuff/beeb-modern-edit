.RELANX
        RTS
.retlan
        JSR     prompt
        EQUB    "Type language name:",&EA
        JSR     readLS
        BEQ     RELANX
        LDY     #0
.RELAPL
        LDA     linbuf,Y
        INY
        CMP     #cr
        BNE     RELAPL
        STA     linbuf + 1,Y
        LDA     #' '
        STA     linbuf - 1,Y
        LDA     #'@'
        STA     linbuf,Y
        LDA     #thelot
        STA     UPDATEREQD
        JSR     stFILE
        LDA     GE + 1
        DEA
        CMP     paje + 1
        BCS     RETLOK
        BRK
        EQUB    &02,"Not enough space to return to language",null
.RETLOK
        LDA     #&FF
        STA     brkaction       ; pretty lethal break action rqd
        LDA     paje + 1
        INA
        STA     argP + 1
        STZ     argP
        LDA     #0
        STA     (tmax)          ; terminating zero
        LDA     GE
        STA     addr
        LDA     GE + 1
        STA     addr + 1
.RELLOP
        LDA     (addr)
        STA     (argP)
        INC     argP
        BNE     RELLOQ
        INC     argP + 1
.RELLOQ
        INC     addr
        BNE     RELLOP
        INC     addr + 1
        LDA     addr + 1
        CMP     hymem + 1
        BNE     RELLOP
        JSR     CURON
        JSR     vstrng
        EQUB    26,12,&EA
        JSR     initus
        LDA     paje + 1
        INA
        STA     string + 1  ; set 0 to PAGE + 256
        STZ     string
        LDX     #<linbuf
        LDY     #>linbuf
        JMP     oscli
