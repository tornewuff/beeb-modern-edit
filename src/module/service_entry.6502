; Calculate the non-relocated equivalent of the address we are currently at.
service_origin = * - origin + header_origin

SECTION Service, cmos = build.cmos_host, org = service_origin

; Recognise *help and *edit
.service_entry {
        IF mouse = 0
        CMP     #&04
        BEQ     unknow
        CMP     #&09
        BNE     servex

        ; *HELP response

        LDA     (&F2),Y
        CMP     #cr
        BNE     helpEX  ; don't say anything unless there are no keywords

        IF build.cmos_host
        PHY
        ELSE
        TYA
        PHA
        ENDIF

        LDY     #helpen - helpin - 1
.helpLO
        LDA     helpin,Y
        JSR     osasci
        DEY
        BPL     helpLO

        IF build.cmos_host
        PLY
        ELSE
        PLA
        TAY
        ENDIF
.helpEX
        LDA     #&09
.servex
        RTS
.helpin
        EQUB    cr,"5 TIDE",cr
.helpen

.unknow
        ; Recognise *edit as command to enter language.

        IF build.cmos_host
        PHY
        PHX
        ELSE
        TYA
        PHA
        TXA
        PHA
        ENDIF

        LDX     #&03
.ucomLO
        LDA     (&F2),Y
        CMP     #'.'
        BEQ     ucommi
        AND     #&DF
        CMP     helpen - 5,X
        BNE     ucomEX
        INY
        DEX
        BPL     ucomLO
        LDA     (&F2),Y
        CMP     #space + 1
        BCC     ucommi
.ucomEX
        IF build.cmos_host
        PLX
        PLY
        ELSE
        PLA
        TAX
        PLA
        TAY
        ENDIF
        LDA     #&04
        RTS
.ucommi
        ; Command recognised - enter self as a language.
        IF build.cmos_host
        LDA     #&8E
        PLX
        ELSE
        PLA
        TAX
        LDA     #&8E
        ENDIF
        JMP     osbyte
        ENDIF
}

ENDSECTION
