.CSRSCREENXY
        LDX scrnX
        LDY     scrnY
        BPL     CSRXY
.CSR0STATUSY
        LDY pagelength
        INY
.CSR0Y
        LDX     #0
.CSRXY
        LDA     #31
.wraxy                          ; VDU A,X,Y
        JSR     oswrch
        TXA
.wray                           ; VDU A,Y
        JSR     oswrch
        TYA
        JMP     oswrch
