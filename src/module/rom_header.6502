.origin
.pasROM
        JMP     language
        IF reladd=0
        JMP     servic
        ELSE
        JMP     servic - origin + &8000
        ENDIF

        IF reladd=0
        EQUB    &C2                     ; Type flag
        ELSE
        EQUB    &E2                     ; relocation address provided
        ENDIF

        EQUB    copyri - pasROM
        EQUB    &02
        EQUB    "Edit"
        EQUB    null
        EQUB    vers
.copyri
        EQUB    null
        EQUB    "(C)1984 Acorn"
        EQUB    null

        IF reladd=1
        EQUW    reladr                  ; relocation value
        EQUW    &0000                   ; Top 2 bytes
        ENDIF
