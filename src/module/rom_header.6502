.origin
        JMP     language
IF reladd=0
        JMP     servic
ELSE
        JMP     servic - origin + &8000
ENDIF

IF reladd=0
        EQUB    &C2                     ; Type flag
ELSE
        EQUB    &E2                     ; relocation address provided
ENDIF

        EQUB    copyright - origin
        EQUB    metadata.version_byte
        EQUB    metadata.title, null
        EQUB    metadata.version_str
.copyright
        EQUB    null, "(C)", metadata.copyright, null

IF reladd=1
        EQUW    reladr                  ; relocation value
        EQUW    &0000                   ; Top 2 bytes
ENDIF
