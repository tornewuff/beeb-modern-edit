.MODIFY
        LDA     #1
        LDX     modflg
        STA     modflg
        IF edit150
        CPX     #1
        BNE     status
        ELSE
        BEQ     status
        ENDIF
        RTS
        IF edit150
.IOtogg                         ; Insert/Over toggle
        LDA     #bit4
        BRA     modtog
.tabctl
        LDA     #bit3
.modtog
        JSR     togmod
        ELSE
.tabctl
        LDA     #8
        EOR     tutmode
        JSR     doMODE
        ENDIF

.CstatU
        STZ     UPDATEREQD      ; update required
.status
        JSR     CSR0STATUSY     ; Output status on status line.
        JSR     STARTINV        ; Start inverse
        JSR     TESTIF
        BEQ     STATSO

        JSR     vstrng
        EQUB    "Insert ",&EA
        BRA     STATSI

.STATSO
        JSR     vstrng
        EQUB    "Over   ",&EA

.STATSI
        LDX     cursED
        BEQ     STATSC
        JSR     vstrng

        IF phil=0
        IF edit150
        EQUB    "     Cursor Editing",&EA
        ELSE
        EQUB    "    Cursor Editing",&EA
        ENDIF
        ELSE
        EQUB    "    Soft Key Entry",&EA
        ENDIF

        BRA     STATSX

.STATSC
        LDA     markX
        BEQ     STATST
        DEA
        BNE     STATSM
        JSR     vstrng
        EQUB    "One mark ",&EA
        BRA     STATSS
.STATSM
        JSR     vstrng
        EQUB    "Two marks",&EA
        BRA     STATSS
.STATST
        LDA     #8
        AND     tutmode
        BNE     STATTW
        JSR     vstrng
        EQUB    "TAB cols ",&EA
        BRA     STATSS
.STATTW
        JSR     vstrng
        EQUB    "TAB words",&EA
.STATSS
        IF edit150
        LDA     modflg          ; 0 original, 1 modified, else discarded
        DEA
        BMI     STATOR
        BNE     STATDI
        JSR     vstrng
        EQUB    " Modified ",&EA
        BRA     STATSX
.STATDI
        JSR     vstrng
        EQUB    " Discarded",&EA
        BRA     STATSX
.STATOR
        JSR     vstrng
        EQUB    " Original ",&EA
        ELSE
        LDA     modflg
        BNE     STATMO
        JSR     vstrng
        EQUB    " Original",&EA
        BRA     STATSX
.STATMO
        JSR     vstrng
        EQUB    " Modified",&EA
        ENDIF
.STATSX
        IF cF8key=1

        IF edit150
        LDA     tutmode
        AND     #bit6           ; LF line terminator selected
        BEQ     STATcr
        ELSE
        LDA     clterm
        CMP     #cr
        BEQ     STATcr
        ENDIF

        JSR     vstrng
        EQUB    " LF",&EA

        BRA     STATlf
.STATcr
        JSR     vstrng
        EQUB    " CR",&EA

.STATlf
        ENDIF

        IF stamp=1
        LDA     flload + 1
        AND     flload + 2
        AND     flload + 3
        INA
        BNE     STATNS

        JSR     vstrng
        EQUB    " Date",&EA
        BRA     STATNQ
.STATNS

        JSR     vstrng
        EQUB    " Exec",&EA
.STATNQ
        ENDIF

        IF edit150
        LDX     #prmptl + prmod1 + prmod2 + 1
        STX     prmcol
        ENDIF
        JSR     STOPINV         ; stop inverse
        LDY     pagelength
        INY

prmptl  =       25              ; Prompt position


        IF cF8key=1
prmod1  =       3               ; CR/LF text
        ELSE
prmod1  =       0
        ENDIF

        IF stamp=1
prmod2  =       5               ; Date/Exec text
        ELSE
prmod2  =       0
        ENDIF

        IF edit150
        LDA     #(prmptl + prmod1 + prmod2)     ; status texts are 1 longer
        ELSE
        LDA     #(prmptl - 1 + prmod1 + prmod2)  ; plus any modifications
        ENDIF

        JMP     WIPETAIL                ; and clear the rest of the line
