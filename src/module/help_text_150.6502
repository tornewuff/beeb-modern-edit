        ; Edit 1.50r help displays and help texts (replaces help_text)

.BIGMESS                        ; function key strip
        JSR     vstrng
        EQUB    remap("┌shf-f0─┬shf-f1─┬shf-f2─┬shf-f3─┬shf-f4─┬shf-f5─┬shf-f6─┬shf-f7─┬shf-f8─┬shf-f9┐")
        EQUB    remap("│Display│Insert/│Insert │Remove │Return │ Set   │ Clear │Marked │Marked │Clear │")
        EQUB    remap("│Returns│Over   │ File  │Margins│Languag│ Mode  │ Marks │Move   │Delete │Text  │")
        EQUB    remap("├──f0───┼──f1───┼──f2───┼──f3───┼──f4───┼──f5───┼──f6───┼──f7───┼──f8───┼──f9──┤")
        EQUB    remap("│ Goto  │Command│ Load  │ Save  │ Find  │Global │ Mark  │Marked │ Print │ Old  │")
        EQUB    remap("│ Line  │Line   │ File  │ File  │String │Replace│ Place │Copy   │ Text  │ Text │")
        EQUB    remap("└"),&EA
        LDX     #8
.BIGMLP
        JSR     vstrng
        EQUB    remap("───────┴"),&EA
        DEX
        BPL     BIGMLP
        JSR     vstrng
        EQUB    remap("──────┘"),&EA
        RTS

.BIGMET                         ; descriptive mode screen
        JSR     vstrng
        EQUB    remap("The Acorn Screen Editor © 1989 Acorn Computers ")
        EQUB    "Vn ", metadata.version_str
        EQUB    remap(" ┌───┐Shift: screen up   ")
        EQUB    remap("                               Descriptive Mode         │ ⭡ │Control: text start")
        EQUB    remap("TAB performs tabulation controlled by shift TAB.      ┌─┴─┬─┴─┐Shift: word l/r  ")
        EQUB    remap("COPY deletes the character above the cursor.          │ ⯇╴│╶⯈ │Control:         ")
        EQUB    remap("Shift COPY provides normal soft keys and cursor       └─┬─┴─┬─┘    l/r of line  ")
        EQUB    remap("       copying (ESCAPE to leave this mode).             │ ⭣ │Shift: screen down ")
        EQUB    remap("Control COPY deletes the current line (to next RETURN)  └───┘Control: text end  ")
        EQUB    &EA
        RTS

        ; ------------------------------------------------------------ ;

        ; The box drawing characters used by the help displays are now
        ; only defined while they are on screen. define_chars saves the
        ; current definitions of characters &80 onwards in chrbak before
        ; redefining them, and restore_chars puts them back.

nchars  =       18              ; number of characters redefined

.define_chars
        LDX     #nchars - 1
        STX     scratch + 30
        LDX     #<(chrbak + (nchars - 1) * 8 - 1)
        LDY     #>(chrbak + (nchars - 1) * 8 - 1)
        STX     scratch + 28
        STY     scratch + 29
.dfchlp                         ; save character definitions, last first
        CLC
        LDA     scratch + 30
        ADC     #remapchar("─") ; first redefined character
        STA     (scratch + 28)  ; character code for OSWORD 10
        LDA     #osword_read_char
        LDX     scratch + 28
        LDY     scratch + 29
        JSR     osword
        SEC
        LDA     scratch + 28
        SBC     #8
        STA     scratch + 28
        BCS     dfchnc
        DEC     scratch + 29
.dfchnc
        DEC     scratch + 30
        BPL     dfchlp
        LDX     #<chrdef
        LDY     #>chrdef
.setchr                         ; define characters from 8 byte rows at XY
        STX     scratch + 28
        STY     scratch + 29
        LDX     #&00
.setclp
        LDA     #23
        JSR     oswrch
        TXA
        CLC
        ADC     #remapchar("─") ; first redefined character
        JSR     oswrch
        LDY     #&00
.setcby
        LDA     (scratch + 28),Y
        JSR     oswrch
        INY
        CPY     #8
        BNE     setcby
        LDA     scratch + 28
        ADC     #7              ; C is set by the CPY
        STA     scratch + 28
        BCC     setcnc
        INC     scratch + 29
.setcnc
        INX
        CPX     #nchars
        BNE     setclp
        RTS

.restore_chars
        LDX     #<chrbak
        LDY     #>chrbak
        BRA     setchr

.chrdef
        EQUB    &00,&00,&00,&FF,&00,&00,&00,&00 ; ─
        EQUB    &18,&18,&18,&18,&18,&18,&18,&18 ; │
        EQUB    &00,&00,&00,&07,&0C,&18,&18,&18 ; ┌
        EQUB    &00,&00,&00,&E0,&30,&18,&18,&18 ; ┐
        EQUB    &18,&18,&0C,&07,&00,&00,&00,&00 ; └
        EQUB    &18,&18,&30,&E0,&00,&00,&00,&00 ; ┘
        EQUB    &7E,&C3,&9D,&B1,&9D,&C3,&7E,&00 ; ©
        EQUB    &00,&18,&38,&7F,&38,&18,&00,&00 ; ⯇
        EQUB    &00,&18,&1C,&FE,&1C,&18,&00,&00 ; ⯈
        EQUB    &18,&18,&18,&18,&7E,&3C,&18,&00 ; ⭣
        EQUB    &00,&18,&3C,&7E,&18,&18,&18,&18 ; ⭡
        EQUB    &00,&00,&00,&1F,&00,&00,&00,&00 ; ╶
        EQUB    &00,&00,&00,&F8,&00,&00,&00,&00 ; ╴
        EQUB    &00,&00,&00,&FF,&18,&18,&18,&18 ; ┬
        EQUB    &18,&18,&18,&1F,&18,&18,&18,&18 ; ├
        EQUB    &18,&18,&18,&F8,&18,&18,&18,&18 ; ┤
        EQUB    &18,&18,&18,&FF,&00,&00,&00,&00 ; ┴
        EQUB    &18,&18,&18,&FF,&18,&18,&18,&18 ; ┼

        ; ------------------------------------------------------------ ;

