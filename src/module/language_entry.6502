.language                       ; Language entry point
        CLI
        CLD
        LDX     #&FF
        TXS
        LDA     #<brk_handler
        STA     BRKv
        LDA     #>brk_handler
        STA     BRKv + 1
        STZ     oldsta + 3
        LDA     #&F2
        STA     scratch
        STZ     scratch + 1
        JSR     readby
        TAX
        JSR     readnx
        STA     scratch + 1
        STX     scratch
        LDX     #20
.EDITol
        DEX
        BEQ     EDIToz

        JSR     readby
        JSR     readne
        CMP     #cr
        BEQ     EDIToz

        CMP     #' '
        BNE     EDITol
        LDX     #&00
.EDITgb
        JSR     readby
        JSR     readne
        STA     &01A0,X
        INX
        CPX     #'@'
        BNE     EDITgb
        LDA     #cr
        STA     &01A0 - 1,X
        STA     nambuf
        LDY     #&00
        JSR     readHX
        BCC     EDITon
        CMP     #','
        BNE     EDITon
        LDA     &00,X
        STA     oldsta
        LDA     &01,X
        STA     oldsta + 1
        INY
        JSR     readHX
        BCC     EDITon
        CMP     #cr
        BNE     EDITon
        LDA     &00,X
        STA     oldsta + 2
        LDA     &01,X
        STA     oldsta + 3
        STZ     cursED
        BRA     EDIToy
.EDITon
        LDX     #&FF
.EDITn1
        INX
        LDA     &01A0,X
        CMP     #' '
        BEQ     EDITn1
        CMP     #cr
        BEQ     EDIToz
.EDITn2
        LDA     &01A0,X
        CMP     #cr
        BEQ     EDITn3
        CMP     #' '
        BCC     EDIToz
        CMP     #delete
        BCS     EDIToz

.EDITn3
        STA     nambuf,X
        INX
        CMP     #cr
        BNE     EDITn2
        LDA     #&01
        STA     cursED
        BRA     EDIToy

.EDIToz
        LDX     #&FF
        STX     cursED
        LDA     #cr
        STA     nambuf

        IF cF8key=1
        LDA     clterm          ; current line terminator
        ELSE
        IF termin<>cr
        LDA     #termin
        ENDIF
        ENDIF

        CMP     (paje)
        BNE     EDIToy
        CMP     (tmax)
        BNE     EDIToy
        JSR     MEMSTATE

.EDIToy
        LDA     #161            ; read CMOS RAM into 'tutmode'
        LDX     #&08            ; our byte
        LDY     #&10            ; ???
        JSR     osbyte
        STY     tutmode         ; returns &00 on the BBC OS 1.2

        IF mouse=1
        JSR     mouser
        ENDIF

        LDA     #cr
        STA     frbuff
        STA     grbuff
        IF cF8key=1
        STA     clterm          ; initialise 'clterm' here
        ENDIF
        STZ     indexH
        STZ     modflg
        JSR     vstrng          ; define characters

        EQUB    3
        EQUB    23,remap("─"),&00,&00,&00,&FF,&00,&00,&00,&00
        EQUB    23,remap("│"),&18,&18,&18,&18,&18,&18,&18,&18

        IF dchars=1      ; Character definitions for descriptive MODE
        EQUB    23,remap("┌"),&00,&00,&00,&07,&0C,&18,&18,&18
        EQUB    23,remap("┐"),&00,&00,&00,&E0,&30,&18,&18,&18
        EQUB    23,remap("└"),&18,&18,&0C,&07,&00,&00,&00,&00
        EQUB    23,remap("┘"),&18,&18,&30,&E0,&00,&00,&00,&00
        EQUB    23,remap("©"),&7E,&C3,&9D,&B1,&9D,&C3,&7E,&00
        EQUB    23,remap("⯇"),&00,&18,&38,&7F,&38,&18,&00,&00
        EQUB    23,remap("⯈"),&00,&18,&1C,&FE,&1C,&18,&00,&00
        EQUB    23,remap("⭣"),&18,&18,&18,&18,&7E,&3C,&18,&00
        EQUB    23,remap("⭡"),&00,&18,&3C,&7E,&18,&18,&18,&18
        EQUB    23,remap("╶"),&00,&00,&00,&1F,&00,&00,&00,&00
        EQUB    23,remap("╴"),&00,&00,&00,&F8,&00,&00,&00,&00
        EQUB    23,remap("┬"),&00,&00,&00,&FF,&18,&18,&18,&18
        EQUB    23,remap("├"),&18,&18,&18,&1F,&18,&18,&18,&18
        EQUB    23,remap("┤"),&18,&18,&18,&F8,&18,&18,&18,&18
        EQUB    23,remap("┴"),&18,&18,&18,&FF,&00,&00,&00,&00
        EQUB    23,remap("┼"),&18,&18,&18,&FF,&18,&18,&18,&18
        ENDIF
        IF lfarro=1
        EQUB    23,nlfarr,&00,&18,&38,&7F,&38,&18,&00,&00
        ENDIF

        EQUB    &EA

        LDA     cursED
        BEQ     zippo
        DEA
        BEQ     zappo
        JMP     EDIT    ; and away we go...
.zippo
        JSR     EDITmd

        IF stamp=1
        JSR      nstamp
        ENDIF

        JMP     OLDTEXT

.zappo
        STZ     brkaction
        JSR     EDITmd
        JSR     EDITi2
        LDY     #&00
        LDA     #<nambuf
        STA     temp
        LDA     #>nambuf
        STA     temp + 1
        JSR     Tload
        JMP     EDITgt
