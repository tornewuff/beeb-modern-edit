        ; Find replace section
        ; Use recursive descent to check syntax ;
        ; F_str ::= find_part CR
        ; find_part ::= { ['*'] (simple_item | set_item) }
        ; set_item  ::= ['~'] ( '[' simple_item { simple_item } ']' )
        ; simple_item ::= ['~'] ( character_specifier | subrange_specifier |
        ;                         wildcard_specifier )
        ; character_specifier ::= ['|!'] (non_meta | '\' non_eoln
        ;                                               | '$' | '|' non_eoln)
        ; subrange_specifier ::= character_specifier '-' character_specifier
        ; wildcard_specifier ::= '.' | '@' | '#'
        ; R_str ::= find_part '/' repl_part CR
        ; repl_part ::= { ( field_item | character_specifier ) }
        ; field_item ::= '&' | '%' digit
        ; non_meta ::= NOT < ~ * [ ] , \ $ | - . @ # & % / eoln >
        ; Subranges should translate into subrange_sym <ch> <ch>
        ; Set constructs should translate into :
        ; set_sym <nextX> ... <next item>
        ;                     ^
        ;                     nextX
        ; Matching of subranges & sets should be internal to compmobj. nextX is
        ; used to step on to the next find item after successfully matching one
        ; of the set alternatives (set match fails when hit tes_sym).

.FRSTRINIT
        ; Exit  -  Y = 0
        STZ     outindex
        STZ     replflag
        STZ     fieldindex
        STZ     mmx
        STZ     offset
        STZ     SENSFLAG
.MININIT
        STZ     inpindex
        BRA     NEXTCH
.GENNEXTCH
        JSR     GENBYTE
.NEXTCH
        ; A,Atemp = linbuf,inpindex +  + . Exit - Z = (A = CR)
        LDY     inpindex
        LDA     linbuf,Y
        STA     Atemp
        INC     inpindex
        CMP     #cr
        RTS
        ; Translate & store FR string into stracc.
        ; Exit  - Find part translated into stracc, replindex holds start of
        ;        replace string (when translated) in stracc.
        ;      - fieldindex = No. of fields (max 10) in find string.
        ;      - For each field n (n> 0) -
        ;        'mulf' (* ..)  -  fieldmmxtab,n = (mmx :OR: &80)
        ;        'conf' (?)     -  fieldmmxtab,n = mmx of previous mulf
        ;                          fieldofftab,n = offset from above
        ;      - replindex = stracc index of replace part (when translated)
        ;      - replflag = 0  No replace part supplied
        ;                   1  Replace part supplied
.FINDTRANS
        JSR     FRSTRINIT
.FINDPART
        STZ     MULFFLAG ; Don't yet know whether next object is either a
        STZ     metaflag ; star or wildcard field.
        STZ     BUTTFLAG ; or ^
        LDA     Atemp
        CMP     #cr
        BEQ     FIPAEXIT
        CMP     #'/'
        BEQ     FIPAEND
        CMP     #'^'
        BNE     FIPANHA
        INC     BUTTFLAG
        BRA     FIPAMUL
.FIPANHA
        CMP     #'*'
        BNE     FIPANMUL
.FIPAMUL
        INC     MULFFLAG
        LDX     #multsym
        JSR     GENNEXTCH
.FIPANMUL
        CMP     #'~'
        BNE     FIPANNOT
        LDX     #notsym
        JSR     GENNEXTCH
.FIPANNOT
        CMP     #'['
        BNE     FIPASIMP
        INC     SENSFLAG
        LDX     #setsym
        JSR     GENBYTE
        JSR     GENBYTE ; Leave room for nextX, and remember position.
        STY     nextX
        JSR     NEXTCH
.FIPASELT
        JSR     SIMPLEITEM
        LDA     Atemp
        CMP     #']'
        BNE     FIPASELT
        DEC     SENSFLAG
        LDA     outindex ; End of set construct. Store nextX
        LDY     nextX
        STA     stracc,Y
        JSR     NEXTCH
        BRA     FIFIFEEL
.FIPAEND
        INC     replflag
.FIPAEXIT
        JSR     TERMGEN
        JSR     NEXTCH
        LDA     outindex
        STA     replindex
        LDA     replflag
        BNE     REPLPART
        RTS
.FIPASIMP
        JSR     SIMPLEITEM
.FIFIFEEL
        ; If last object was a field of some sort, then store the
        ; relevant info, and update indeces as required.
        LDA     BUTTFLAG
        BEQ     FIFICO
        LDX     #BUTTSYM
        JSR     GENBYTE
.FIFICO
        LDA     metaflag
        BEQ     FIFIOFFI ; No meta-chars => not a field
        LDX     fieldindex
        CPX     #10
        BCS     FINDPART ; That's enough fields.
        INC     fieldindex
        LDA     offset
        STA     fieldofftab,X
        LDA     MULFFLAG
        BNE     FIFIMULF
        LDA     mmx
        STA     fieldmmxtab,X
.FIFIOFFI
        INC     offset
.FINDPCH
        JMP     FINDPART
.FIFIMULF
        INC     mmx
        LDA     mmx
        CMP     #5
        BCS     FRSTERR
        ORA     #&80
        STA     fieldmmxtab,X
        STZ     offset
        BRA     FINDPCH
.FRSTERR
        BRK
        EQUB    1,"Too many find multiples",0
.REPANXCH
        JSR     NEXTCH
.REPAGENBYTE
        JSR     GENBYTE
.REPLPART
        LDA     #&FF
        STA     SENSFLAG
        LDA     Atemp ; Translate replace part of FR string.
        CMP     #cr
        BEQ     TERMGEN
        LDX     #FOUNDSYM
        CMP     #'&'
        BEQ     REPANXCH
        CMP     #'\'
        BNE     REPANS
        JSR     NEXTCH
        TAX
        BRA     REPANXCH
.REPANS
        LDX     #FIELDSYM
        CMP     #'%'
        BNE     RPNFLD
        JSR     GENBYTE
        JSR     NEXTCH
        SEC
        SBC     #'0'
        BCC     FIELDERR
        CMP     fieldindex
        BCS     FIELDERR
        TAX
        BPL     REPANXCH
.RPNFLD
        JSR     CHARACTERSPECIFIER
        STX     SIMPCHAR
        TXA
        BPL     REPAGENBYTE
        LDX     #escsym
        JSR     GENBYTE
        LDX     SIMPCHAR
        BRA     REPAGENBYTE
.FIELDERR
        BRK
        EQUB    1,"Bad replace field number",0
.TERMGEN
        LDX     #termsym; Generate termsym.
.GENBYTE
        ; stracc,outindex +  +  = X
        ; Exit - metaflag set (incremented) if meta-character (field) generated.
        LDY     outindex
        LDA     SENSFLAG
        BNE     GENBSNS
        CPX     #'A'
        BCC     GENBSNS
        CPX     #'z' + 1
        BCS     GENBSNS
        CPX     #'Z' + 1
        BCC     GENBNSN
        CPX     #'a'
        BCC     GENBSNS
.GENBNSN
        TXA
        ORA     #&20
        TAX
        LDA     #NSENSYM
        STA     stracc,Y
        INY
        INC     outindex
        BEQ     GENBERR
.GENBSNS
        TXA
        STA     stracc,Y
        BPL     GENBNMET
        INC     metaflag
.GENBNMET
        INC     outindex
        BEQ     GENBERR
        RTS
.GENBERR
        BRK
        EQUB    1,"Syntax incorrect",0
.SIMPLEITEM
        LDA     Atemp
        CMP     #'~'
        BNE     SIITNNOT
        LDX     #notsym
        JSR     GENBYTE
        JSR     NEXTCH
        BNE     SIITNNOT
        BRK
        EQUB    1,"Error with ~",0
.SIITNNOT
        CMP     #'\'
        BNE     SIITNS
        INC     SENSFLAG
        JSR     NEXTCH
        BNE     SIITNM
        BRK
        EQUB    1,"Error with \",0
.SIITNM
        TAX
        JSR     NEXTCH
        JSR     GENBYTE
        DEC     SENSFLAG
        RTS
.SIITNS
        LDX     #WILDSYM
        CMP     #'.'
        BEQ     SIITWILD
        LDX     #ALPHASYM
        CMP     #'@'
        BEQ     SIITWILD
        LDX     #digsym
        CMP     #'#'
        BNE     SIITNWIL
.SIITWILD
        JSR     NEXTCH ; Preserves X
        JMP     GENBYTE
.SIITNWIL
        JSR     CHARACTERSPECIFIER
        STX     SIMPCHAR
        LDA     Atemp
        CMP     #'-'
        BNE     SIITCGEN
        INC     SENSFLAG
        LDX     #SUBRSYM
        JSR     GENBYTE
        JSR     NEXTCH
        LDX     SIMPCHAR
        JSR     GENBYTE
        JSR     CHARACTERSPECIFIER
        JSR     GENBYTE
        DEC     SENSFLAG
        RTS
.SIITCGEN
        ; Output character as escsym ch if >= &80
        TXA
        BPL     GENBYJ
        LDX     #escsym
        JSR     GENBYTE
        LDX     SIMPCHAR
.GENBYJ
        JMP     GENBYTE
.CHARACTERSPECIFIER
        ; Exit  -  X = Character
        STZ     count ; Add 128 count
        LDA     Atemp
        BMI     CHSPBY
        CMP     #'|'
        BNE     CHRSCO
        JSR     NEXTCH
        BEQ     CHRSER
        CMP     #'!'
        BNE     CHRSSO
        INC     count
        JSR     NEXTCH
.CHRSCO
        CMP     #'$'
        BEQ     CHSPCR
        CMP     #'|'
        BNE     CHSPBY
        JSR     NEXTCH
        BEQ     CHRSER
.CHRSSO
        CMP     #'?'
        BNE     NOTQUE
        LDA     #&7F
        BRA     CHSPBY
.NOTQUE
        BCC     CHSPBY
        AND     #&DF
        SBC     #'@'
        BRA     CHSPBY
.CHSPCR
        IF cF8key=1
        LDA     clterm
        ELSE
        LDA     #termin
        ENDIF
.CHSPBY
        PHA
        JSR     NEXTCH
        PLA
        LDY     count
        BEQ     CHRSEX
        ORA     #&80
.CHRSEX
        TAX
        RTS
.CHRSER
        BRK
        EQUB    1,"Error with |",0
