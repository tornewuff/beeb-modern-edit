.EDRDCH
        ; Exit - A holds character read
        IF edit150
        ; Keys that are editor commands arrive as 0 followed by the
        ; command code. Exit EQ with the code in A for a command,
        ; NE with the character in A for anything else.
        LDA     NEXTREADFLAG
        BEQ     EDRDOSRD
        LDA     nxtchr
        STZ     NEXTREADFLAG
        BNE     EDRDNX
.EDRDZ                          ; 0, 0 is a literal 0
        TSX                     ; NE
        RTS
.EDRDNX
        LDX     scratch + 31    ; flags saved with nxtchr
        RTS
.EDRDOSRD
        JSR     rdcesc
        TAX
.EDRDCK
        BNE     EDRDRT
        JSR     rdcesc
        CMP     #0
        BEQ     EDRDZ
        LDX     #0              ; EQ: command
.EDRDRT
        RTS

.EDINKY                         ; as EDRDCH but with a timeout, A = 0 if none
        LDA     #&81
        TAX
        LDY     #3
        JSR     osbyte
        TYA
        BNE     EDINTO
        TXA
        BRA     EDRDCK
.EDINTO
        JSR     escTST
        LDA     #0
        TAX
        RTS
        ELSE
        LDA     NEXTREADFLAG
        BEQ     EDRDOSRD
        LDA     nxtchr
        STZ     NEXTREADFLAG
        RTS
.EDRDOSRD
        IF mouse=1
        PHX
        PHY
.MOUSLP
        LDA     #&81
        LDX     #0
        LDY     #0
        JSR     osbyte
        TXA
        CPY     #&FF
        BNE     NOMOUSE
        JSR     mouser
        LDA     mousel + 8
        ORA     mousel + 9
        BNE     MOUSLY
        LDA     mousel + 6
        ORA     mousel + 7
        BNE     MOUSLX
        LDA     mousel
        CMP     mousel + 5
        BEQ     MOUSLP
        AND     #&7
        BIT     #&1
        BNE     MOUSK1
        BIT     #&2
        BNE     MOUSK2
        BIT     #&4
        BEQ     MOUSLP
        LDA     #&86
        BRA     NOMOUSE
.MOUSK1
        LDA     #&98
        BRA     NOMOUSE
.MOUSK2
        LDA     #&97
        BRA     NOMOUSE
.MOUSLX
        LDA     #&8D
        LDX     mousel + 7
        BPL     NOMOUSE
        LDA     #&8C
        BNE     NOMOUSE
.MOUSLY
        LDA     #&8F
        LDX     mousel + 9
        BPL     NOMOUSE
        LDA     #&8E
.NOMOUSE
        PLX
        PLY
        ELSE
        JSR     osrdch
        ENDIF

        JMP     escTST
        ENDIF
